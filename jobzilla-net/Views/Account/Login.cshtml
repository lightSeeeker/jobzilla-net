@model jobzilla_net.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Log In";
    // We can use a bare layout without headers/footers if we want, but the template 
    // uses the standard header/footer. We will use the _Layout.
}

<!-- CONTENT START -->
<div class="page-content">

    <!-- Login Section Start -->
    <div class="section-full site-bg-white">
        
        <div class="container-fluid">
            <div class="row">
                <div class="col-xl-8 col-lg-6 col-md-5 twm-log-reg-media-wrap">
                    <div class="twm-log-reg-media">
                        <div class="twm-l-media">
                            <img src="~/images/login-bg.png" alt="">
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-6 col-md-7">
                    <div class="twm-log-reg-form-wrap">
                        <div class="twm-log-reg-logo-head">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/images/logo-dark.png" alt="" class="logo">
                            </a> 
                        </div>

                        <div class="twm-log-reg-inner">
                            <div class="twm-log-reg-head">
                                <div class="twm-log-reg-logo">
                                    <span class="log-reg-form-title">Log In</span>
                                </div>
                            </div>
                            <div class="twm-tabs-style-2">
                                
                                <ul class="nav nav-tabs" id="myTab2" role="tablist">
                                    <!--Login Candidate-->  
                                    <li class="nav-item">
                                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#twm-login-candidate" type="button" onclick="document.getElementById('UserType').value='Candidate'"><i class="fas fa-user-tie"></i>Candidate</button>
                                    </li>
                                    <!--Login Employer-->
                                    <li class="nav-item">
                                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#twm-login-candidate" type="button" onclick="document.getElementById('UserType').value='Employer'"><i class="fas fa-building"></i>Employer</button>
                                    </li>
                                </ul>
                                
                                <div class="tab-content" id="myTab2Content">
                                    <!--Login Content-->  
                                    <div class="tab-pane fade show active" id="twm-login-candidate">
                                        
                                        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@Model.ReturnUrl" method="post">
                                            <input type="hidden" asp-for="UserType" id="UserType" value="Candidate" />
                                            
                                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

                                            <div class="row">

                                                <div class="col-lg-12">
                                                    <div class="form-group mb-3">
                                                        <input asp-for="Email" class="form-control" placeholder="Email*">
                                                        <span asp-validation-for="Email" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                
                                                <div class="col-lg-12">
                                                    <div class="form-group mb-3">
                                                        <input asp-for="Password" class="form-control" placeholder="Password*">
                                                        <span asp-validation-for="Password" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                
                                                <div class="col-lg-12">
                                                    <div class="twm-forgot-wrap">
                                                        <div class="form-group mb-3">
                                                            <div class="form-check">
                                                                <input asp-for="RememberMe" class="form-check-input" id="Password4">
                                                                <label class="form-check-label rem-forgot" for="Password4">Remember me <a asp-controller="Candidates" asp-action="Index" class="site-text-primary">Forgot Password</a></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <button type="submit" class="site-button">Log in</button>
                                                    </div>
                                                    <div class="mt-3 mb-3">Don't have an account? 
                                                        <a asp-controller="Account" asp-action="Register" class="twm-backto-login">Sign Up</a>
                                                    </div>
                                                </div>

                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <span class="center-text-or">Or</span>
                                                    </div>
                                                </div>

                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <button type="button" class="log_with_facebook">
                                                            <i class="fab fa-facebook"></i>
                                                            Continue with Facebook
                                                        </button>
                                                    </div>
                                                </div>

                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <button type="button" class="log_with_google">
                                                            <img src="~/images/google-icon.png" alt="">
                                                            Continue with Google
                                                        </button>
                                                    </div>
                                                </div>
                                                
                                            </div>
                                        </form>

                                    </div>
                                
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>   
    <!-- Login Section End -->

</div>
<!-- CONTENT END -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

