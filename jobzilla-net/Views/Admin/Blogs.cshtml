@model AdminBlogsViewModel
@{
    ViewData["Title"] = "Blogs Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="wt-admin-right-page-header clearfix">
    <h2>Blog Posts</h2>
    <div class="breadcrumbs">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="Admin" asp-action="Index">Dashboard</a>
        <span>Blogs</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Blogs Table -->
<div class="panel panel-default">
    <div class="panel-heading wt-panel-heading p-a20">
        <h4 class="panel-tittle m-a0"><i class="fa fa-newspaper-o"></i> All Blog Posts</h4>
    </div>
    <div class="panel-body wt-panel-body p-a20">
        <div class="twm-D_table p-a20 table-responsive">
            <table class="table table-bordered twm-bookmark-list-wrap">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Published</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var blog in Model.Blogs.Items)
                    {
                        <tr>
                            <td>
                                <div class="twm-bookmark-list">
                                    <div class="twm-mid-content">
                                        <h4>@blog.Title</h4>
                                    </div>
                                </div>
                            </td>
                            <td>@blog.AuthorName</td>
                            <td>
                                <span class="badge bg-info">@blog.CategoryName</span>
                            </td>
                            <td>@(blog.PublishedAtUtc?.ToString("MMM dd, yyyy") ?? "-")</td>
                            <td>
                                <span class="@(blog.IsPublished ? "text-clr-green2" : "text-clr-red")">
                                    @(blog.IsPublished ? "Published" : "Draft")
                                </span>
                            </td>
                            <td>
                                <div class="twm-table-controls">
                                    <ul class="twm-DT-controls-icon list-unstyled d-flex align-items-center">
                                        <li>
                                            <form asp-controller="Admin" asp-action="ToggleBlogPublish" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@blog.Id" />
                                                <button type="submit" class="border-0 bg-transparent p-0" title="@(blog.IsPublished ? "Unpublish" : "Publish")">
                                                    <span class="fa @(blog.IsPublished ? "fa-eye-slash" : "fa-eye")"></span>
                                                </button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-controller="Admin" asp-action="DeleteBlog" method="post" onsubmit="return confirm('Are you sure?');" style="display:inline;">
                                                <input type="hidden" name="id" value="@blog.Id" />
                                                <button type="submit" class="border-0 bg-transparent p-0" title="Delete">
                                                    <span class="far fa-trash-alt"></span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.Blogs.TotalPages > 1)
        {
            <div class="pagination-outer text-right mt-4">
                <div class="pagination-style1">
                    <ul class="clearfix">
                        @if (Model.Blogs.HasPreviousPage)
                        {
                            <li class="prev">
                                <a asp-action="Blogs" asp-route-page="@(Model.Blogs.Page - 1)">
                                    <span><i class="fa fa-angle-left"></i></span>
                                </a>
                            </li>
                        }
                        @for (int i = 1; i <= Model.Blogs.TotalPages; i++)
                        {
                            <li class="@(i == Model.Blogs.Page ? "active" : "")">
                                <a asp-action="Blogs" asp-route-page="@i">@i</a>
                            </li>
                        }
                        @if (Model.Blogs.HasNextPage)
                        {
                            <li class="next">
                                <a asp-action="Blogs" asp-route-page="@(Model.Blogs.Page + 1)">
                                    <span><i class="fa fa-angle-right"></i></span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

