@model jobzilla_net.Models.AdminDash.AdminReportsViewModel
@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="wt-admin-right-page-header clearfix">
    <h2>Reports & Analytics</h2>
    <div class="breadcrumbs">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="Admin" asp-action="Index">Dashboard</a>
        <span>Reports</span>
    </div>
</div>

<!-- Date Range Filter -->
<div class="panel panel-default mb-4">
    <div class="panel-body wt-panel-body p-a20">
        <form method="get" asp-action="Reports" class="row align-items-end g-3">
            <div class="col-md-4">
                <label>From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label>To Date</label>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="site-button">
                    <i class="fa fa-filter"></i> Filter Report
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Report Period Info -->
<div class="alert alert-info">
    <strong>Report Period:</strong> @Model.FromDate.ToString("MMMM dd, yyyy") to @Model.ToDate.ToString("MMMM dd, yyyy")
</div>

<!-- Key Statistics -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="panel panel-default">
            <div class="panel-body wt-panel-body gradi-1 dashboard-card p-a20 text-center">
                <h5 class="text-muted mb-2">Jobs Posted</h5>
                <h2 class="m-a0">@Model.Report.JobsPosted</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="panel panel-default">
            <div class="panel-body wt-panel-body gradi-2 dashboard-card p-a20 text-center">
                <h5 class="text-muted mb-2">Applications</h5>
                <h2 class="m-a0">@Model.Report.ApplicationsSubmitted</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="panel panel-default">
            <div class="panel-body wt-panel-body gradi-3 dashboard-card p-a20 text-center">
                <h5 class="text-muted mb-2">Subscriptions</h5>
                <h2 class="m-a0">@Model.Report.SubscriptionsPurchased</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="panel panel-default">
            <div class="panel-body wt-panel-body gradi-4 dashboard-card p-a20 text-center">
                <h5 class="text-muted mb-2">Total Revenue</h5>
                <h2 class="m-a0">$@Model.Report.TotalRevenueEarned.ToString("0.00")</h2>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Metrics -->
<div class="panel panel-default mb-4">
    <div class="panel-heading wt-panel-heading p-a20">
        <h4 class="panel-tittle m-a0"><i class="fa fa-bar-chart"></i> Detailed Metrics</h4>
    </div>
    <div class="panel-body wt-panel-body p-a20">
        <div class="row">
            <!-- Registration Metrics -->
            <div class="col-lg-6 mb-4">
                <h5 class="mb-3">New Registrations</h5>
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>New Employers</td>
                            <td><strong>@Model.Report.NewEmployersRegistered</strong></td>
                        </tr>
                        <tr>
                            <td>New Candidates</td>
                            <td><strong>@Model.Report.NewCandidatesRegistered</strong></td>
                        </tr>
                        <tr>
                            <td>Total New Users</td>
                            <td><strong>@(Model.Report.NewEmployersRegistered + Model.Report.NewCandidatesRegistered)</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Job Metrics -->
            <div class="col-lg-6 mb-4">
                <h5 class="mb-3">Job Metrics</h5>
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>Jobs Posted</td>
                            <td><strong>@Model.Report.JobsPosted</strong></td>
                        </tr>
                        <tr>
                            <td>Applications Submitted</td>
                            <td><strong>@Model.Report.ApplicationsSubmitted</strong></td>
                        </tr>
                        <tr>
                            <td>Avg Applications per Job</td>
                            <td><strong>@(Model.Report.JobsPosted > 0 ? (Model.Report.ApplicationsSubmitted / (decimal)Model.Report.JobsPosted).ToString("0.0") : "0")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Revenue Metrics -->
            <div class="col-lg-6 mb-4">
                <h5 class="mb-3">Revenue Metrics</h5>
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>Total Revenue Earned</td>
                            <td><strong>$@Model.Report.TotalRevenueEarned.ToString("0.00")</strong></td>
                        </tr>
                        <tr>
                            <td>Subscriptions Purchased</td>
                            <td><strong>@Model.Report.SubscriptionsPurchased</strong></td>
                        </tr>
                        <tr>
                            <td>Avg Revenue per Subscription</td>
                            <td><strong>$@(Model.Report.SubscriptionsPurchased > 0 ? (Model.Report.TotalRevenueEarned / Model.Report.SubscriptionsPurchased).ToString("0.00") : "0.00")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Resume Metrics -->
            <div class="col-lg-6 mb-4">
                <h5 class="mb-3">Resume Metrics</h5>
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>Resumes Created</td>
                            <td><strong>@Model.Report.ResumesCreated</strong></td>
                        </tr>
                        <tr>
                            <td>Resumes Downloaded</td>
                            <td><strong>@Model.Report.ResumesDownloaded</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Export Options -->
<div class="panel panel-default">
    <div class="panel-heading wt-panel-heading p-a20">
        <h4 class="panel-tittle m-a0"><i class="fa fa-download"></i> Export Report</h4>
    </div>
    <div class="panel-body wt-panel-body p-a20">
        <p class="text-muted mb-3">Download this report in your preferred format:</p>
        <div class="btn-group" role="group">
            <button type="button" class="site-button">
                <i class="fa fa-file-excel-o"></i> Export to Excel
            </button>
            <button type="button" class="site-button">
                <i class="fa fa-file-pdf-o"></i> Export to PDF
            </button>
            <button type="button" class="site-button">
                <i class="fa fa-file-csv-o"></i> Export to CSV
            </button>
        </div>
    </div>
</div>
