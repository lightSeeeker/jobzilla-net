@model jobzilla_net.Models.AdminDash.AdminResumeTemplateFormViewModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Resume Template" : "Add Resume Template";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="wt-admin-right-page-header clearfix">
    <h2>@ViewData["Title"]</h2>
    <div class="breadcrumbs">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="Admin" asp-action="ResumeTemplates">Resume Templates</a>
        <span>@ViewData["Title"]</span>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Form Section -->
<div class="panel panel-default">
    <div class="panel-body wt-panel-body p-a20">
        <form asp-action="ResumeTemplateForm" method="post" enctype="multipart/form-data">
            <div class="row">
                <!-- Left Column -->
                <div class="col-xl-8 col-lg-12">
                    <!-- Template Name -->
                    <div class="form-group mb-3">
                        <label>Template Name *</label>
                        <input asp-for="Template.Name" class="form-control" placeholder="e.g., Modern Resume" required />
                        <span asp-validation-for="Template.Name" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="form-group mb-3">
                        <label>Description</label>
                        <textarea asp-for="Template.Description" class="form-control" rows="4" placeholder="Describe this template..."></textarea>
                        <span asp-validation-for="Template.Description" class="text-danger"></span>
                    </div>

                    <!-- Category -->
                    <div class="form-group mb-3">
                        <label>Category</label>
                        <select asp-for="Template.Category" class="form-control">
                            <option value="">-- Select Category --</option>
                            <option value="Professional">Professional</option>
                            <option value="Modern">Modern</option>
                            <option value="Creative">Creative</option>
                            <option value="ATS Friendly">ATS Friendly</option>
                            <option value="Executive">Executive</option>
                            <option value="Technical">Technical</option>
                        </select>
                        <span asp-validation-for="Template.Category" class="text-danger"></span>
                    </div>

                    <!-- Template Type -->
                    <div class="form-group mb-3">
                        <label>Template Type</label>
                        <input asp-for="Template.TemplateType" class="form-control" placeholder="e.g., Single Column" />
                        <span asp-validation-for="Template.TemplateType" class="text-danger"></span>
                    </div>

                    @{
                        var isSystemTemplate = Model.IsEditMode && Model.Template.Source == jobzilla_net.Core.Enums.ResumeTemplateSource.System;
                    }

                    <!-- Template File Upload -->
                    @if (isSystemTemplate)
                    {
                        <div class="form-group mb-3">
                            <label>Template File</label>
                            <div class="alert alert-secondary mb-0">
                                <i class="fa fa-lock"></i> This is a <strong>built-in</strong> template rendered by the application. Its layout file cannot be replaced — you can edit its details below.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="form-group mb-3">
                            <label>Template File @(Model.IsEditMode ? "" : "*")</label>
                            <input type="file" asp-for="TemplateFile" class="form-control" accept=".html" />
                            <span asp-validation-for="TemplateFile" class="text-danger"></span>
                            <small class="text-muted d-block">Only <strong>.html</strong> files are accepted (max 2&nbsp;MB). The HTML is filled with candidate data at render time using the placeholder tokens listed on the right — it is never executed.</small>
                            @if (Model.IsEditMode && !string.IsNullOrEmpty(Model.ExistingTemplateFilePath))
                            {
                                <small class="text-success d-block mt-1"><i class="fa fa-check"></i> Current file: @System.IO.Path.GetFileName(Model.ExistingTemplateFilePath). Leave empty to keep it.</small>
                            }
                        </div>
                    }

                    <!-- Preview Image Upload -->
                    <div class="form-group mb-3">
                        <label>Preview Image</label>
                        <input type="file" asp-for="PreviewImage" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                        <span asp-validation-for="PreviewImage" class="text-danger"></span>
                        <small class="text-muted">Optional thumbnail shown in listings (JPG, PNG, GIF, WEBP; max 2&nbsp;MB).</small>
                    </div>

                    <hr class="my-4" />

                    <!-- Pricing Section -->
                    <h5 class="mb-3">Pricing Information</h5>

                    <!-- Is Premium -->
                    <div class="form-group mb-3">
                        <div class="form-check">
                            <input asp-for="Template.IsPremium" type="checkbox" class="form-check-input" id="isPremium" onchange="togglePricingSection()" />
                            <label class="form-check-label" for="isPremium">
                                This is a Premium Template
                            </label>
                        </div>
                    </div>

                    <!-- Price (shows only if premium) -->
                    <div id="pricingSection" style="display: none;">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label>Price ($) *</label>
                                    <input asp-for="Template.Price" type="number" class="form-control" placeholder="19.99" step="0.01" />
                                    <span asp-validation-for="Template.Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label>Discount Price ($)</label>
                                    <input asp-for="Template.DiscountPrice" type="number" class="form-control" placeholder="14.99" step="0.01" />
                                    <span asp-validation-for="Template.DiscountPrice" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Status -->
                    <div class="form-group mb-3">
                        <div class="form-check">
                            <input asp-for="Template.IsActive" type="checkbox" class="form-check-input" id="isActive" checked />
                            <label class="form-check-label" for="isActive">
                                Active / Enabled
                            </label>
                        </div>
                    </div>

                    <!-- Hidden Fields -->
                    <input type="hidden" asp-for="IsEditMode" />
                    <input type="hidden" asp-for="ExistingTemplateFilePath" />
                    <input type="hidden" asp-for="ExistingPreviewImagePath" />
                    <input type="hidden" asp-for="Template.Source" />
                    @if (Model.IsEditMode)
                    {
                        <input type="hidden" asp-for="TemplateId" />
                    }
                </div>

                <!-- Right Column - Preview -->
                <div class="col-xl-4 col-lg-12">
                    <div class="panel panel-default">
                        <div class="panel-heading wt-panel-heading p-a20">
                            <h5 class="m-a0">Preview</h5>
                        </div>
                        <div class="panel-body wt-panel-body p-a20">
                            @if (Model.IsEditMode && Model.TemplateId.HasValue)
                            {
                                <p class="text-muted small mb-2">Live preview of the full CV design, filled with sample (Lorem Ipsum) data.</p>
                                <div style="width: 336px; max-width: 100%; height: 476px; overflow: hidden; margin: 0 auto; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                                    <iframe src="@Url.Action("TemplatePreview", "Admin", new { id = Model.TemplateId })"
                                            style="width: 800px; height: 1130px; border: none; transform: scale(0.42); transform-origin: top left;"
                                            scrolling="no" loading="lazy" title="Template preview"></iframe>
                                </div>
                                <a href="@Url.Action("TemplatePreview", "Admin", new { id = Model.TemplateId })" target="_blank" class="site-button outline w-100 mt-3">
                                    <i class="fa fa-expand"></i> Open full preview
                                </a>
                                <a href="@Url.Action("TemplatePreviewPdf", "Admin", new { id = Model.TemplateId })" target="_blank" class="site-button w-100 mt-2">
                                    <i class="fa fa-file-pdf"></i> Test PDF (current engine)
                                </a>
                            }
                            else
                            {
                                <div class="preview-box bg-light p-4 rounded text-center" style="min-height: 300px; display: flex; align-items: center; justify-content: center;">
                                    <div>
                                        <i class="fa fa-file-code" style="font-size: 60px; color: #ccc;"></i>
                                        <p class="mt-3 text-muted">Save the template to see a live preview.</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Placeholder Token Reference -->
                    <div class="panel panel-default mt-3">
                        <div class="panel-heading wt-panel-heading p-a20">
                            <h5 class="m-a0">Placeholder Tokens</h5>
                        </div>
                        <div class="panel-body wt-panel-body p-a20">
                            <p class="text-muted small mb-2">Use these tokens in your HTML. They are replaced with the candidate's data.</p>
                            <p class="small mb-1"><strong>Personal:</strong></p>
                            <code class="small d-block mb-2">{{FullName}} {{Title}} {{Email}} {{Phone}} {{Location}} {{Summary}} {{ProfileImage}}</code>
                            <p class="small mb-1"><strong>Repeating sections</strong> (loop over items):</p>
<pre class="small bg-light p-2 rounded" style="white-space: pre-wrap;">{{#Experience}}
  {{JobTitle}} @@ {{CompanyName}}
  {{StartDate}} - {{EndDate}}
  {{Description}}
{{/Experience}}

{{#Education}} {{Degree}}, {{InstitutionName}} {{/Education}}
{{#Skills}} {{Name}} {{/Skills}}
{{#Certifications}} {{Name}}, {{IssuingOrganization}} {{/Certifications}}
{{#Projects}} {{Name}} — {{Description}} {{/Projects}}
{{#References}} {{ReferenceName}}, {{Company}} {{/References}}</pre>
                            <small class="text-muted">Use <code>{{SectionTitle}}</code> inside a section block for its heading. Unknown tokens render empty.</small>
                        </div>
                    </div>

                    <!-- Template Details -->
                    <div class="panel panel-default mt-3">
                        <div class="panel-heading wt-panel-heading p-a20">
                            <h5 class="m-a0">Details</h5>
                        </div>
                        <div class="panel-body wt-panel-body p-a20">
                            <div class="mb-3">
                                <label class="text-muted small">Status</label>
                                <p>
                                    @if (Model.Template.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small">Pricing</label>
                                <p>
                                    @if (Model.Template.IsPremium)
                                    {
                                        <span class="badge bg-warning">Premium</span>
                                        @if (Model.Template.Price > 0)
                                        {
                                            <span class="ms-2">$@Model.Template.Price.ToString("0.00")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Free</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="mt-4">
                <button type="submit" class="site-button">
                    <i class="fa fa-save"></i> @(Model.IsEditMode ? "Update Template" : "Create Template")
                </button>
                <a asp-action="ResumeTemplates" class="site-button btn-secondary ms-2">
                    <i class="fa fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePricingSection() {
            var isPremium = document.getElementById('isPremium').checked;
            var pricingSection = document.getElementById('pricingSection');
            pricingSection.style.display = isPremium ? 'block' : 'none';
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function () {
            togglePricingSection();
        });
    </script>
}
