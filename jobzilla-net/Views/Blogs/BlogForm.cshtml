@model jobzilla_net.Models.Blogs.BlogFormViewModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Blog" : "Post a New Blog";
    ViewData["ActivePage"] = "Blogs";
    var isEmployer = User.IsInRole("Employer");
    if (isEmployer)
    {
        Layout = "~/Views/Shared/_EmployerLayout.cshtml";
    }
}

@if (isEmployer)
{
    <div class="wt-admin-right-page-header clearfix">
        <h2>@ViewData["Title"]</h2>
        <div class="breadcrumbs">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Employer" asp-action="Index">Dashboard</a>
            <a asp-controller="Blogs" asp-action="Manage">My Blogs</a>
            <span>@ViewData["Title"]</span>
        </div>
    </div>

    <partial name="_FormInner" model="Model" />
}
else
{
    <div class="page-content">
        <div class="section-full p-t120 p-b90 site-bg-white">
            <div class="container-fluid" style="max-width: 1600px; padding: 0 40px;">
                <div class="row">
                    <partial name="_CandidateSidebar" model="null" />
                    <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                        <div class="twm-right-section-panel site-bg-gray p-a20">
                            <div class="wt-admin-right-page-header clearfix mb-4">
                                <h2 class="m-0">@ViewData["Title"]</h2>
                            </div>
                            <partial name="_FormInner" model="Model" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
