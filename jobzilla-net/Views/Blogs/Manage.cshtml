@model jobzilla_net.Models.Blogs.BlogManageViewModel
@{
    ViewData["Title"] = "Manage Blogs";
}

<!-- INNER PAGE BANNER -->
<div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url(/images/banner/1.jpg);">
    <div class="overlay-main site-bg-white opacity-01"></div>
    <div class="container">
        <div class="wt-bnr-inr-entry">
            <div class="banner-title-outer">
                <div class="banner-title-name">
                    <h2 class="wt-title">@ViewData["Title"]</h2>
                </div>
            </div>
            <!-- BREADCRUMB ROW -->                            
            <div>
                <ul class="wt-breadcrumb breadcrumb-style-2">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Blogs" asp-action="Index">Blogs</a></li>
                    <li>@ViewData["Title"]</li>
                </ul>
            </div>
            <!-- BREADCRUMB ROW END -->                        
        </div>
    </div>
</div>
<!-- INNER PAGE BANNER END -->

<div class="section-full p-t120 p-b90 site-bg-white">
    <div class="container">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="mb-4 text-right">
            <a asp-action="Create" class="site-button"><i class="fa fa-plus"></i> Post a New Blog</a>
        </div>

        <div class="twm-D_table p-a20 table-responsive shadow-sm rounded border">
            <table class="table table-bordered twm-bookmark-list-wrap m-b0">
                <thead class="bg-light">
                    <tr>
                        <th>Blog Title</th>
                        <th>Category</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Blogs.Items.Any())
                    {
                        foreach (var blog in Model.Blogs.Items)
                        {
                            <tr>
                                <td>
                                    <div class="twm-bookmark-list p-2 m-b0">
                                        <div class="twm-mid-content p-0">
                                            <a asp-action="Details" asp-route-id="@blog.Slug" class="twm-job-title">
                                                <h4>@blog.Title</h4>
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td>@(blog.CategoryName ?? "-")</td>
                                <td>@(blog.PublishedAtUtc?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>
                                    @if(blog.IsPublished)
                                    {
                                        <span class="text-clr-green2">Published</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Draft</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="twm-table-controls d-inline-block">
                                        <ul class="twm-DT-controls-icon list-unstyled d-flex align-items-center justify-content-center m-b0">
                                            <li>
                                                <a asp-action="Details" asp-route-id="@blog.Slug" title="View Blog" data-bs-toggle="tooltip" data-bs-placement="top">
                                                    <span class="fa fa-eye"></span>
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-action="Edit" asp-route-id="@blog.Id" title="Edit" data-bs-toggle="tooltip" data-bs-placement="top">
                                                    <span class="far fa-edit"></span>
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@blog.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this blog?');" class="d-inline">
                                                    <button type="submit" title="Delete" data-bs-toggle="tooltip" data-bs-placement="top" class="border-0 bg-transparent text-danger p-0 m-0 ms-1">
                                                        <span class="far fa-trash-alt"></span>
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center p-4">No blogs posted yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        @if (Model.Blogs.TotalPages > 1)
        {
            <div class="pagination-outer text-right mt-4">
                <div class="pagination-style1">
                    <ul class="clearfix">
                        @if (Model.Blogs.Page > 1)
                        {
                            <li class="prev">
                                <a asp-action="Manage" asp-route-page="@(Model.Blogs.Page - 1)">
                                    <span> <i class="fa fa-angle-left"></i> </span>
                                </a>
                            </li>
                        }
                        
                        @for (int i = 1; i <= Model.Blogs.TotalPages; i++)
                        {
                            <li class="@(i == Model.Blogs.Page ? "active" : "")">
                                <a asp-action="Manage" asp-route-page="@i">@i</a>
                            </li>
                        }

                        @if (Model.Blogs.Page < Model.Blogs.TotalPages)
                        {
                            <li class="next">
                                <a asp-action="Manage" asp-route-page="@(Model.Blogs.Page + 1)">
                                    <span> <i class="fa fa-angle-right"></i> </span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

    </div>
</div>
