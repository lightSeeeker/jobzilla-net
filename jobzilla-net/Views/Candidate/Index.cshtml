@model jobzilla_net.Models.Candidate.CandidateOverviewViewModel
@{
    ViewData["Title"] = "Candidate Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<!-- CONTENT START -->
<div class="page-content">



    <div class="section-full p-t120  p-b90 site-bg-white">
        <div class="container-fluid" style="max-width: 1600px; padding: 0 40px;">
            <div class="row">
                
                <partial name="_CandidateSidebar" model="Model" />

                <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                    <div class="twm-right-section-panel site-bg-gray">
                        <div class="wt-admin-right-page-header">
                            <h2>Dashboard Overview</h2>
                            <p>Welcome to your Candidate Dashboard.</p>
                        </div>
        
                        <div class="twm-dash-b-blocks mb-5">
                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-12 mb-3">
                                    <div class="panel panel-default">
                                        <div class="panel-body wt-panel-body dashboard-card-2 block-gradient">
                                            <div class="wt-card-wrap-2">
                                                <div class="wt-card-icon-2"><i class="flaticon-job"></i></div>
                                                <div class="wt-card-right wt-total-active-listing counter " data-count="@Model.Overview.AppliedJobsCount">@Model.Overview.AppliedJobsCount</div>
                                                <div class="wt-card-bottom-2 ">
                                                    <h4 class="m-b0">Applied Jobs</h4>
                                                    <div class="jz-sparkline"><span style="height:40%"></span><span style="height:70%"></span><span style="height:55%"></span><span style="height:90%"></span><span style="height:65%"></span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 mb-3">
                                    <div class="panel panel-default">
                                        <div class="panel-body wt-panel-body dashboard-card-2 block-gradient-2">
                                            <div class="wt-card-wrap-2">
                                                <div class="wt-card-icon-2"><i class="flaticon-resume"></i></div>
                                                <div class="wt-card-right  wt-total-listing-view counter " data-count="@Model.Overview.SavedJobsCount">@Model.Overview.SavedJobsCount</div>
                                                <div class="wt-card-bottom-2">
                                                    <h4 class="m-b0">Saved Jobs</h4>
                                                    <div class="jz-sparkline"><span style="height:50%"></span><span style="height:65%"></span><span style="height:45%"></span><span style="height:80%"></span><span style="height:95%"></span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 mb-3">
                                    <div class="panel panel-default">
                                        <div class="panel-body wt-panel-body dashboard-card-2 block-gradient-3">
                                            <div class="wt-card-wrap-2">
                                                <div class="wt-card-icon-2"><i class="flaticon-envelope"></i></div>
                                                <div class="wt-card-right wt-total-listing-review counter " data-count="@Model.Overview.MessagesCount">@Model.Overview.MessagesCount</div>
                                                <div class="wt-card-bottom-2">
                                                    <h4 class="m-b0">Messages</h4>
                                                    <div class="jz-sparkline"><span style="height:60%"></span><span style="height:40%"></span><span style="height:75%"></span><span style="height:50%"></span><span style="height:85%"></span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 mb-3">
                                    <div class="panel panel-default">
                                        <div class="panel-body wt-panel-body dashboard-card-2 block-gradient-4">
                                            <div class="wt-card-wrap-2">
                                                <div class="wt-card-icon-2"><i class="flaticon-bell"></i></div>
                                                <div class="wt-card-right wt-total-listing-bookmarked counter " data-count="@Model.Overview.AlertsCount">@Model.Overview.AlertsCount</div>
                                                <div class="wt-card-bottom-2">
                                                    <h4 class="m-b0">Job Alerts</h4>
                                                    <div class="jz-sparkline"><span style="height:45%"></span><span style="height:60%"></span><span style="height:50%"></span><span style="height:70%"></span><span style="height:88%"></span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>  
                        </div>
        
                        <div class="twm-pro-view-chart-wrap">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 mb-4">
                                    <div class="panel panel-default">
                                        <div class="panel-heading wt-panel-heading p-a20">
                                            <h4 class="panel-tittle m-a0">Recent Applications</h4>
                                        </div>
                                        <div class="panel-body wt-panel-body bg-white">
                                            <div class="twm-dashboard-candidates-wrap">
                                                <div class="row">
                                                    
                                                    @if (Model.Overview.RecentApplications.Any())
                                                    {
                                                        foreach (var app in Model.Overview.RecentApplications)
                                                        {
                                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                                <div class="twm-dash-candidates-list">
                                                                    <div class="twm-media">
                                                                        <div class="twm-media-pic">
                                                                            <img src="@(string.IsNullOrEmpty(app.CompanyLogoPath) ? "/images/jobs-company/pic1.jpg" : app.CompanyLogoPath)" alt="#">
                                                                        </div>
                                                                    </div>
                                                                    <div class="twm-mid-content">
                                                                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobPostId" class="twm-job-title">
                                                                            <h4>@app.JobTitle</h4>
                                                                        </a>
                                                                        <p>@app.CompanyName</p>
                                                                        
                                                                        <div class="twm-fot-content">
                                                                            <div class="twm-left-info">
                                                                                <p class="twm-candidate-address"><i class="feather-map-pin"></i>@app.Location</p>
                                                                                @{
                                                                                    var appStatusClass = app.Status switch
                                                                                    {
                                                                                        "Pending"  => "jz-status-review",
                                                                                        "Approved" => "jz-status-hired",
                                                                                        "Rejected" => "jz-status-rejected",
                                                                                        _          => "jz-status-shortlist"
                                                                                    };
                                                                                }
                                                                                <div class="twm-jobs-vacancies"><span class="@appStatusClass">@app.Status</span></div>
                                                                            </div>
                                                                            <div class="twm-right-btn">
                                                                                <ul class="twm-controls-icon list-unstyled">
                                                                                    <li>
                                                                                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobPostId" title="View Job" data-bs-toggle="tooltip" data-bs-placement="top">
                                                                                            <span class="fa fa-eye"></span>
                                                                                        </a>
                                                                                    </li>
                                                                                </ul>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="col-12 p-3 text-center">
                                                            <p>You haven't applied to any jobs yet.</p>
                                                        </div>
                                                    }
                                                    
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
        
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>   

</div>
<!-- CONTENT END -->

