@model jobzilla_net.Models.CandidateDash.CandidateDashAppliedJobsViewModel
@{
    ViewData["Title"] = "Applied Jobs";
    ViewData["ActivePage"] = "AppliedJobs";
}

<!-- CONTENT START -->
<div class="page-content">

    <!-- INNER PAGE BANNER -->
    <div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url(/images/banner/1.jpg);">
        <div class="overlay-main site-bg-white opacity-01"></div>
        <div class="container">
            <div class="wt-bnr-inr-entry">
                <div class="banner-title-outer">
                    <div class="banner-title-name">
                        <h2 class="wt-title">Candidate Dashboard</h2>
                    </div>
                </div>
                <!-- BREADCRUMB ROW -->                            
                <div>
                    <ul class="wt-breadcrumb breadcrumb-style-2">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li>Applied Jobs</li>
                    </ul>
                </div>
                <!-- BREADCRUMB ROW END -->                        
            </div>
        </div>
    </div>
    <!-- INNER PAGE BANNER END -->

    <div class="section-full p-t120  p-b90 site-bg-white">`n        <div class="container-fluid" style="max-width: 1600px; padding: 0 40px;">
            <div class="row">
                
                <partial name="_CandidateSidebar" model="null" />

                <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                    <div class="twm-right-section-panel site-bg-gray">
                        <div class="wt-admin-right-page-header">
                            <h2>Applied Jobs</h2>
                            <p>Manage and track all your applications here.</p>
                        </div>
                        
                        <div class="twm-dashboard-candidates-wrap">
                            <div class="row">
                                
                                @if (Model.AppliedJobs.Items.Any())
                                {
                                    foreach (var app in Model.AppliedJobs.Items)
                                    {
                                        <div class="col-xl-12 col-lg-12 col-md-12">
                                            <div class="twm-dash-candidates-list">
                                                <div class="twm-media">
                                                    <div class="twm-media-pic">
                                                        <img src="@(string.IsNullOrEmpty(app.CompanyLogoPath) ? "/images/jobs-company/pic1.jpg" : app.CompanyLogoPath)" alt="#">
                                                    </div>
                                                </div>
                                                <div class="twm-mid-content">
                                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobPostId" class="twm-job-title">
                                                        <h4>@app.JobTitle </h4>
                                                    </a>
                                                    <p>@app.CompanyName</p>
                                                    
                                                    <div class="twm-fot-content">
                                                        <div class="twm-left-info">
                                                            <p class="twm-candidate-address"><i class="feather-map-pin"></i>@app.Location</p>
                                                            <div class="twm-jobs-vacancies">@app.Status</div>
                                                        </div>
                                                        <div class="twm-right-btn">
                                                            <ul class="twm-controls-icon list-unstyled">
                                                                <li>
                                                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobPostId" title="View Job" data-bs-toggle="tooltip" data-bs-placement="top">
                                                                        <span class="fa fa-eye"></span>
                                                                    </a>
                                                                </li>
                                                                <li>
                                                                    <form asp-action="StartChat" method="post" class="m-0 p-0">
                                                                        <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                                                        <button type="submit" class="btn btn-sm btn-outline-info p-1 ml-2" title="Message Employer" data-bs-toggle="tooltip" data-bs-placement="top">
                                                                            <span class="fa fa-comments"></span>
                                                                        </button>
                                                                    </form>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 p-3 text-center">
                                        <p>You haven't applied to any jobs yet.</p>
                                        <a asp-controller="Jobs" asp-action="Index" class="site-button">Browse Jobs</a>
                                    </div>
                                }
                                
                            </div>
                        </div>

                        <!-- Pagination can be added here based on Model.AppliedJobs.TotalPages -->
                        
                    </div>
                </div>

            </div>
        </div>
    </div>   

</div>
<!-- CONTENT END -->

