@model jobzilla_net.Models.CandidateDash.CandidateDashProfileViewModel
@{
    ViewData["Title"] = "Candidate Profile";
    ViewData["ActivePage"] = "Profile";
}

<!-- CONTENT START -->
<div class="page-content">

    <!-- INNER PAGE BANNER -->
    <div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url(/images/banner/1.jpg);">
        <div class="overlay-main site-bg-white opacity-01"></div>
        <div class="container">
            <div class="wt-bnr-inr-entry">
                <div class="banner-title-outer">
                    <div class="banner-title-name">
                        <h2 class="wt-title">Candidate Profile</h2>
                    </div>
                </div>
                <!-- BREADCRUMB ROW -->                            
                <div>
                    <ul class="wt-breadcrumb breadcrumb-style-2">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li>Candidate Profile</li>
                    </ul>
                </div>
                <!-- BREADCRUMB ROW END -->                        
            </div>
        </div>
    </div>
    <!-- INNER PAGE BANNER END -->

    <div class="section-full p-t120  p-b90 site-bg-white">
        <div class="container">
            <div class="row">
                
                <partial name="_CandidateSidebar" model="null" />

                <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                    <div class="twm-right-section-panel site-bg-gray">
                        <form asp-controller="CandidateDash" asp-action="Profile" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>
                            
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                            }
        
                            <!--Basic Information-->
                            <div class="panel panel-default">
                                <div class="panel-heading wt-panel-heading p-a20">
                                    <h4 class="panel-tittle m-a0">Basic Informations</h4>
                                </div>
                                <div class="panel-body wt-panel-body p-a20 m-b30 ">
                                    
                                    <div class="row">
                                                        
                                            <div class="col-xl-12 col-lg-12 col-md-12 mb-4">
                                                <div class="form-group">
                                                    <label>Profile Picture</label>
                                                    <div class="ls-inputicon-box">
                                                        @if (!string.IsNullOrEmpty(Model.Profile.ProfileImagePath))
                                                        {
                                                            <div class="mb-3">
                                                                <img src="@Model.Profile.ProfileImagePath" alt="Profile Picture" style="max-width: 150px; border-radius: 8px;" />
                                                            </div>
                                                        }
                                                        <input type="file" asp-for="ProfileImage" class="form-control" accept="image/*" />
                                                        <i class="fs-input-icon fa fa-image"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Your Name</label>
                                                    <div class="ls-inputicon-box"> 
                                                        <input asp-for="Profile.FullName" class="form-control" placeholder="Devid Smith">
                                                        <i class="fs-input-icon fa fa-user "></i>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Phone</label>
                                                    <div class="ls-inputicon-box"> 
                                                        <input asp-for="Profile.PhoneNumber" class="form-control" placeholder="(251) 1234-456-7890">
                                                        <i class="fs-input-icon fa fa-phone-alt"></i>
                                                    </div>
                                                </div>
                                            </div>
        
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Email Address</label>
                                                    <div class="ls-inputicon-box"> 
                                                        <input asp-for="Profile.Email" class="form-control" placeholder="Devid@example.com" readonly>
                                                        <i class="fs-input-icon fas fa-at"></i>
                                                    </div>
                                                </div>
                                            </div>
        
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Professional Title</label>
                                                    <div class="ls-inputicon-box"> 
                                                        <input asp-for="Profile.ProfessionalTitle" class="form-control" placeholder="e.g. IT Contractor">
                                                        <i class="fs-input-icon fa fa-user-tie"></i>
                                                    </div>
                                                </div>
                                            </div>
        
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group city-outer-bx has-feedback">
                                                    <label>Experience (Years)</label>
                                                    <div class="ls-inputicon-box">  
                                                        <input asp-for="Profile.ExperienceYears" class="form-control" placeholder="05">
                                                        <i class="fs-input-icon fa fa-user-edit"></i>
                                                    </div>
                                                </div>
                                            </div>
        
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group city-outer-bx has-feedback">
                                                    <label>Expected Salary</label>
                                                    <div class="ls-inputicon-box">  
                                                        <input asp-for="Profile.ExpectedSalary" class="form-control" placeholder="75000">
                                                        <i class="fs-input-icon fa fa-dollar-sign"></i>
                                                    </div>
                                                    
                                                </div>
                                            </div>
        
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <div class="form-group city-outer-bx has-feedback">
                                                    <label>Full Address (Location)</label>
                                                    <div class="ls-inputicon-box">  
                                                        <input asp-for="Profile.Location" class="form-control" placeholder="1363-1385 Sunset Blvd Angeles, CA 90026 ,USA">
                                                        <i class="fs-input-icon fas fa-map-marker-alt"></i>
                                                    </div>
                                                </div>
                                            </div>
         
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <label>Description / Summary</label>
                                                    <textarea asp-for="Profile.Summary" class="form-control" rows="3" placeholder="Tell us about yourself..."></textarea>
                                                </div>
                                            </div>
                                            
                                            <div class="col-lg-12 col-md-12">                                   
                                                <div class="text-left">
                                                    <button type="submit" class="site-button">Save Changes</button>
                                                </div>
                                            </div> 
                                                                                
                                    </div>
                                            
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>   

</div>
<!-- CONTENT END -->
