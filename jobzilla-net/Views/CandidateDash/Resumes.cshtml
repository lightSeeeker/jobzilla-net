@model jobzilla_net.Models.CandidateDash.CandidateDashResumesViewModel
@{
    ViewData["Title"] = "CV Manager";
    ViewData["ActivePage"] = "Resumes";
}

<!-- CONTENT START -->
<div class="page-content">

    <!-- INNER PAGE BANNER -->
    <div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url(/images/banner/1.jpg);">
        <div class="overlay-main site-bg-white opacity-01"></div>
        <div class="container">
            <div class="wt-bnr-inr-entry">
                <div class="banner-title-outer">
                    <div class="banner-title-name">
                        <h2 class="wt-title">Candidate CV Manager</h2>
                    </div>
                </div>
                <!-- BREADCRUMB ROW -->                            
                <div>
                    <ul class="wt-breadcrumb breadcrumb-style-2">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li>Candidate CV Manager</li>
                    </ul>
                </div>
                <!-- BREADCRUMB ROW END -->                        
            </div>
        </div>
    </div>
    <!-- INNER PAGE BANNER END -->

    <div class="section-full p-t120  p-b90 site-bg-white">
        <div class="container">
            <div class="row">
                
                <partial name="_CandidateSidebar" model="null" />

                <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                    <div class="twm-right-section-panel candidate-save-job site-bg-gray">
                        
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                        }
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                        }

                        <!-- Upload New Resume Form -->
                        <div class="panel panel-default mb-4">
                            <div class="panel-heading wt-panel-heading p-a20">
                                <h4 class="panel-tittle m-a0">Upload New Resume</h4>
                            </div>
                            <div class="panel-body wt-panel-body p-a20">
                                <form asp-controller="CandidateDash" asp-action="AddResume" method="post" enctype="multipart/form-data">
                                    <div class="row">
                                        <div class="col-lg-6 mb-3">
                                            <input type="text" name="title" class="form-control" placeholder="Resume Title (e.g. Developer CV)" required>
                                        </div>
                                        <div class="col-lg-6 mb-3">
                                            <input type="file" name="resumeFile" class="form-control" accept=".pdf,.doc,.docx" required>
                                        </div>
                                        <div class="col-lg-12 mb-3">
                                            <div class="form-check">
                                                <input type="checkbox" name="isDefault" value="true" class="form-check-input" id="isDefault">
                                                <label class="form-check-label" for="isDefault">Set as Default Resume</label>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <button type="submit" class="site-button">Upload & Parse</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Create Resume from Scratch Form -->
                        <div class="panel panel-default mb-4">
                            <div class="panel-heading wt-panel-heading p-a20">
                                <h4 class="panel-tittle m-a0">Create Resume from Scratch</h4>
                            </div>
                            <div class="panel-body wt-panel-body p-a20">
                                <form asp-controller="CandidateDash" asp-action="CreateResumeScratch" method="post">
                                    <div class="row align-items-center">
                                        <div class="col-lg-8 mb-3 mb-lg-0">
                                            <input type="text" name="title" class="form-control" placeholder="New Resume Title (e.g. Design CV)" required>
                                        </div>
                                        <div class="col-lg-4">
                                            <button type="submit" class="site-button w-100">Create & Build</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!--Filter Short By-->
                        <div class="product-filter-wrap d-flex justify-content-between align-items-center mb-4">
                            <span class="woocommerce-result-count-left">CV Manager</span>
                            <div>
                                <a asp-controller="CandidateDash" asp-action="Builder" class="site-button">Edit Parsed Data</a>
                            </div>
                        </div>

                        <div class="twm-cv-manager-list-wrap">
                            <ul>
                                @if (Model.Resumes.Any())
                                {
                                    foreach (var resume in Model.Resumes)
                                    {
                                        <li>
                                            <div class="twm-cv-manager-list-style1">
                                                <div class="twm-media">
                                                    <div class="twm-media-pic">
                                                        <i class="fa fa-file-pdf fa-3x text-danger" style="margin-top: 15px;"></i>
                                                    </div>
                                                </div>
                                                <div class="twm-mid-content">
                                                    <a href="@(resume.IsBuilderGenerated ? $"/CandidateDash/Builder?resumeId={resume.Id}" : resume.FilePath)" @(!resume.IsBuilderGenerated ? "target=\"_blank\"" : "") class="twm-job-title">
                                                        <h4>@resume.Title @(resume.IsDefault ? "(Default)" : "")</h4>
                                                    </a>
                                                    <p>Created: @resume.CreatedAtUtc.ToString("MMM dd, yyyy")</p>
                                                    
                                                    <div class="twm-fot-content">
                                                        <div class="twm-left-info">
                                                            <div class="twm-job-post-duration">Format: @(resume.IsBuilderGenerated ? "Builder" : "PDF/Doc")</div>
                                                        </div>
                                                        <div class="twm-view-button">
                                                            @if (resume.IsBuilderGenerated)
                                                            {
                                                                <a href="/CandidateDash/Builder?resumeId=@resume.Id" title="Edit Builder Resume" data-bs-toggle="tooltip" data-bs-placement="top">
                                                                    <i class="fa fa-edit text-primary"></i>
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <a href="@resume.FilePath" title="Download" target="_blank" data-bs-toggle="tooltip" data-bs-placement="top">
                                                                    <i class="fa fa-download"></i>
                                                                </a>
                                                            }
                                                            @if (!resume.IsDefault)
                                                            {
                                                                <form asp-controller="CandidateDash" asp-action="SetDefaultResume" method="post" style="display:inline;">
                                                                    <input type="hidden" name="resumeId" value="@resume.Id" />
                                                                    <button type="submit" class="btn btn-link p-0 m-0 align-baseline ms-2" title="Set Active" data-bs-toggle="tooltip" data-bs-placement="top">
                                                                        <i class="fa fa-check-circle text-success"></i>
                                                                    </button>
                                                                </form>
                                                            }

                                                            <form asp-controller="CandidateDash" asp-action="DeleteResume" method="post" style="display:inline;" class="ms-2">
                                                                <input type="hidden" name="resumeId" value="@resume.Id" />
                                                                <button type="submit" class="btn btn-link p-0 m-0 align-baseline" title="Delete" data-bs-toggle="tooltip" data-bs-placement="top" onclick="return confirm('Are you sure you want to delete this resume?');">
                                                                    <i class="fa fa-trash-alt text-danger"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="text-center p-4">No resumes uploaded yet.</li>
                                }
                            </ul>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>   

</div>
<!-- CONTENT END -->
