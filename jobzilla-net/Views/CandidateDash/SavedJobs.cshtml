@model jobzilla_net.Models.CandidateDash.CandidateDashSavedJobsViewModel
@{
    ViewData["Title"] = "Saved Jobs";
    ViewData["ActivePage"] = "SavedJobs";
}

<!-- CONTENT START -->
<div class="page-content">



    <div class="section-full p-t120  p-b90 site-bg-white">
        <div class="container-fluid" style="max-width: 1600px; padding: 0 40px;">
            <div class="row">
                
                <partial name="_CandidateSidebar" model="null" />

                <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                    <div class="twm-right-section-panel site-bg-gray">
                        <div class="wt-admin-right-page-header">
                            <h2>Saved Jobs</h2>
                            <p>Here are the jobs you bookmarked.</p>
                        </div>
                        
                        <div class="twm-dashboard-candidates-wrap">
                            <div class="row">
                                
                                @if (Model.SavedJobs.Items.Any())
                                {
                                    foreach (var job in Model.SavedJobs.Items)
                                    {
                                        <div class="col-xl-12 col-lg-12 col-md-12">
                                            <div class="twm-dash-candidates-list">
                                                <div class="twm-media">
                                                    <div class="twm-media-pic">
                                                        <img src="@(string.IsNullOrEmpty(job.CompanyLogoPath) ? "/images/jobs-company/pic1.jpg" : job.CompanyLogoPath)" alt="#">
                                                    </div>
                                                </div>
                                                <div class="twm-mid-content">
                                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobPostId" class="twm-job-title">
                                                        <h4>@job.JobTitle </h4>
                                                    </a>
                                                    <p>@job.CompanyName</p>
                                                    
                                                    <div class="twm-fot-content">
                                                        <div class="twm-left-info">
                                                            <p class="twm-candidate-address"><i class="feather-map-pin"></i>@job.Location</p>
                                                            <div class="twm-jobs-vacancies">@job.JobType</div>
                                                        </div>
                                                        <div class="twm-right-btn">
                                                            <ul class="twm-controls-icon list-unstyled">
                                                                <li>
                                                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobPostId" title="View Job" data-bs-toggle="tooltip" data-bs-placement="top">
                                                                        <span class="fa fa-eye"></span>
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 p-3 text-center">
                                        <p>You haven't saved any jobs yet.</p>
                                        <a asp-controller="Jobs" asp-action="Index" class="site-button">Browse Jobs</a>
                                    </div>
                                }
                                
                            </div>
                        </div>

                        <!-- Pagination can be added here based on Model.SavedJobs.TotalPages -->
                        
                    </div>
                </div>

            </div>
        </div>
    </div>   

</div>
<!-- CONTENT END -->

