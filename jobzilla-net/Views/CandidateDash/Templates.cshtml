@model List<jobzilla_net.Application.Resumes.Dtos.ResumeTemplateDto>
@{
    ViewData["Title"] = "Resume Templates";
    ViewData["ActivePage"] = "Templates"; 
}

<!-- CONTENT START -->
<div class="page-content">

    <!-- INNER PAGE BANNER -->
    <div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url(/images/banner/1.jpg);">
        <div class="overlay-main site-bg-white opacity-01"></div>
        <div class="container">
            <div class="wt-bnr-inr-entry">
                <div class="banner-title-outer">
                    <div class="banner-title-name">
                        <h2 class="wt-title">Resume Templates</h2>
                    </div>
                </div>
                <!-- BREADCRUMB ROW -->                            
                <div>
                    <ul class="wt-breadcrumb breadcrumb-style-2">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li>Resume Templates</li>
                    </ul>
                </div>
                <!-- BREADCRUMB ROW END -->                        
            </div>
        </div>
    </div>
    <!-- INNER PAGE BANNER END -->

    <div class="section-full p-t120 p-b90 site-bg-white">
        <div class="container">
            <div class="row">
                
                <partial name="_CandidateSidebar" model="null" />

                <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                    <div class="twm-right-section-panel site-bg-gray">
                        
                        <div class="product-filter-wrap d-flex justify-content-between align-items-center mb-4">
                            <span class="woocommerce-result-count-left">Available Templates</span>
                            <div>
                                <a asp-action="Builder" class="site-button outline primary">Back to Builder</a>
                            </div>
                        </div>

                        <div class="row">
                            @foreach (var template in Model)
                            {
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="card h-100 shadow-sm border-0">
                                        <div class="card-body text-center d-flex flex-column">
                                            <!-- Icon/Preview Placeholder -->
                                            <i class="fa fa-file-alt fa-5x text-primary mb-3 mt-3"></i>
                                            <h4 class="card-title">@template.Name</h4>
                                            <p class="card-text text-muted mb-4">@template.Description</p>
                                            
                                            <div class="mt-auto">
                                                <a asp-action="PreviewTemplate" asp-route-id="@template.Id" class="site-button w-100">Preview & Export</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            @if (!Model.Any())
                            {
                                <div class="col-12 text-center p-4">
                                    <p class="text-muted">No templates available at the moment.</p>
                                </div>
                            }
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>   

</div>
<!-- CONTENT END -->
