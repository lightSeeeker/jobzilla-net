@model jobzilla_net.Models.EmployerDash.EmployerDashJobFormViewModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Job" : "Post a New Job";
    Layout = "~/Views/Shared/_EmployerLayout.cshtml";
}

<div class="wt-admin-right-page-header clearfix">
    <h2>@ViewData["Title"]</h2>
    <div class="breadcrumbs">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="EmployerDash" asp-action="Index">Dashboard</a>
        <a asp-controller="EmployerDash" asp-action="PostedJobs">Manage Jobs</a>
        <span>@ViewData["Title"]</span>
    </div>
</div>

<form asp-action="@(Model.IsEditMode ? "EditJob" : "PostJob")" method="post">
    @if (Model.IsEditMode)
    {
        <input type="hidden" asp-for="JobId" />
    }
    
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="panel panel-default">
        <div class="panel-heading wt-panel-heading p-a20">
            <h4 class="panel-tittle m-a0">Basic Information</h4>
        </div>
        <div class="panel-body wt-panel-body p-a20 m-b30 ">
            <div class="row">
                
                <div class="col-xl-6 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.Title">Job Title</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Job.Title" class="form-control" placeholder="e.g. Senior Frontend Developer">
                            <i class="fs-input-icon fa fa-briefcase"></i>
                        </div>
                        <span asp-validation-for="Job.Title" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-xl-6 col-lg-12 col-md-12">
                    <div class="form-group city-outer-bx has-feedback">
                        <label asp-for="Job.JobCategoryId">Job Category</label>
                        <div class="ls-inputicon-box">  
                            <select asp-for="Job.JobCategoryId" asp-items="Model.Categories" class="wt-select-box selectpicker" data-live-search="true">
                                <option value="">Select Category</option>
                            </select>
                            <i class="fs-input-icon fa fa-list"></i>
                        </div>
                        <span asp-validation-for="Job.JobCategoryId" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-xl-6 col-lg-12 col-md-12">
                    <div class="form-group city-outer-bx has-feedback">
                        <label asp-for="Job.EmploymentType">Employment Type</label>
                        <div class="ls-inputicon-box">  
                            <select asp-for="Job.EmploymentType" asp-items="Model.EmploymentTypes" class="wt-select-box selectpicker" data-live-search="true">
                                <option value="">Select Employment Type</option>
                            </select>
                            <i class="fs-input-icon fa fa-clock"></i>
                        </div>
                        <span asp-validation-for="Job.EmploymentType" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-xl-6 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.Location">Location</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Job.Location" class="form-control" placeholder="City, Country">
                            <i class="fs-input-icon fa fa-map-marker-alt"></i>
                        </div>
                        <span asp-validation-for="Job.Location" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-xl-6 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.MinimumSalary">Minimum Salary</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Job.MinimumSalary" class="form-control" type="number" placeholder="50000">
                            <i class="fs-input-icon fa fa-money-bill-wave"></i>
                        </div>
                        <span asp-validation-for="Job.MinimumSalary" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-xl-6 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.MaximumSalary">Maximum Salary</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Job.MaximumSalary" class="form-control" type="number" placeholder="80000">
                            <i class="fs-input-icon fa fa-money-bill-wave"></i>
                        </div>
                        <span asp-validation-for="Job.MaximumSalary" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-xl-6 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.ExpiresAtUtc">Expiration Date</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Job.ExpiresAtUtc" class="form-control" type="date">
                            <i class="fs-input-icon fa fa-calendar-alt"></i>
                        </div>
                        <span asp-validation-for="Job.ExpiresAtUtc" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.Description">Description</label>
                        <textarea asp-for="Job.Description" class="form-control" rows="4" placeholder="Describe the job..."></textarea>
                        <span asp-validation-for="Job.Description" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.Requirements">Requirements</label>
                        <textarea asp-for="Job.Requirements" class="form-control" rows="4" placeholder="List the requirements..."></textarea>
                        <span asp-validation-for="Job.Requirements" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Job.Responsibilities">Responsibilities</label>
                        <textarea asp-for="Job.Responsibilities" class="form-control" rows="4" placeholder="List the responsibilities..."></textarea>
                        <span asp-validation-for="Job.Responsibilities" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-lg-12 col-md-12">                                   
                    <div class="text-left mt-3">
                        <button type="submit" class="site-button">@(Model.IsEditMode ? "Save Changes" : "Post Job")</button>
                    </div>
                </div> 
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
