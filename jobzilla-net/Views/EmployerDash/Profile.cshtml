@model jobzilla_net.Models.EmployerDash.EmployerDashProfileViewModel
@{
    ViewData["Title"] = "Company Profile";
    Layout = "~/Views/Shared/_EmployerLayout.cshtml";
}

<div class="wt-admin-right-page-header clearfix">
    <h2>Company Profile!</h2>
    <div class="breadcrumbs">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="EmployerDash" asp-action="Index">Dashboard</a>
        <span>Company Profile!</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Profile" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!--Basic Information-->
    <div class="panel panel-default">
        <div class="panel-heading wt-panel-heading p-a20">
            <h4 class="panel-tittle m-a0">Basic Informations</h4>
        </div>
        <div class="panel-body wt-panel-body p-a20 m-b30 ">
            <div class="row">
                
                <div class="col-xl-12 col-lg-12 col-md-12 mb-4">
                    <div class="form-group">
                        <label>Company Logo</label>
                        <div class="ls-inputicon-box">
                            @if (!string.IsNullOrEmpty(Model.Profile.LogoPath))
                            {
                                <div class="mb-3">
                                    <img src="@Model.Profile.LogoPath" alt="Company Logo" style="max-width: 150px; border-radius: 8px;" />
                                </div>
                            }
                            <input type="file" asp-for="LogoImage" class="form-control" accept="image/*" />
                            <i class="fs-input-icon fa fa-image"></i>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Profile.CompanyName">Company Name</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Profile.CompanyName" class="form-control" placeholder="Devid Smith">
                            <i class="fs-input-icon fa fa-user"></i>
                        </div>
                        <span asp-validation-for="Profile.CompanyName" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-xl-4 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Profile.PhoneNumber">Phone</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Profile.PhoneNumber" class="form-control" placeholder="(251) 1234-456-7890">
                            <i class="fs-input-icon fa fa-phone-alt"></i>
                        </div>
                        <span asp-validation-for="Profile.PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Profile.Email">Email Address</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Profile.Email" class="form-control" placeholder="Devid@example.com" readonly>
                            <i class="fs-input-icon fa fa-envelope"></i>
                        </div>
                        <span asp-validation-for="Profile.Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Profile.WebsiteUrl">Website</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Profile.WebsiteUrl" class="form-control" placeholder="https://...">
                            <i class="fs-input-icon fa fa-globe-americas"></i>
                        </div>
                        <span asp-validation-for="Profile.WebsiteUrl" class="text-danger"></span>
                    </div>
                </div>



                <div class="col-xl-4 col-lg-12 col-md-12">
                    <div class="form-group city-outer-bx has-feedback">
                        <label asp-for="Profile.CompanySize">Team Size</label>
                        <div class="ls-inputicon-box">  
                            <select asp-for="Profile.CompanySize" class="wt-select-box selectpicker" data-live-search="true">
                                <option value="">Select Team Size</option>
                                <option value="1-5">1-5</option>
                                <option value="5-10">5-10</option>
                                <option value="10-20">10-20</option>
                                <option value="20-50">20-50</option>
                                <option value="50+">50+</option>
                            </select>
                            <i class="fs-input-icon fa fa-sort-numeric-up"></i>
                        </div>
                        <span asp-validation-for="Profile.CompanySize" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-xl-12 col-lg-12 col-md-12">
                    <div class="form-group">
                        <label asp-for="Profile.Location">Location</label>
                        <div class="ls-inputicon-box"> 
                            <input asp-for="Profile.Location" class="form-control" placeholder="City, Country">
                            <i class="fs-input-icon fa fa-map-marker-alt"></i>
                        </div>
                        <span asp-validation-for="Profile.Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Profile.Description">Description</label>
                        <textarea asp-for="Profile.Description" class="form-control" rows="3" placeholder="Greetings! We are..."></textarea>
                        <span asp-validation-for="Profile.Description" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-lg-12 col-md-12">                                   
                    <div class="text-left mt-3">
                        <button type="submit" class="site-button">Save Changes</button>
                    </div>
                </div> 
            </div>
        </div>
    </div>
</form>
