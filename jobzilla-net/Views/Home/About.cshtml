@{
    ViewData["Title"] = "About Us";
}

<!-- INNER PAGE BANNER -->
<div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url('/images/banner/1.jpg');">
    <div class="overlay-main site-bg-white opacity-01"></div>
    <div class="container">
        <div class="wt-bnr-inr-entry">
            <div class="banner-title-outer">
                <div class="banner-title-name">
                    <h2 class="wt-title">About Us</h2>
                </div>
            </div>
            <!-- BREADCRUMB ROW -->                            
            <div>
                <ul class="wt-breadcrumb breadcrumb-style-2">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li>About Us</li>
                </ul>
            </div>
            <!-- BREADCRUMB ROW END -->                        
        </div>
    </div>
</div>
<!-- INNER PAGE BANNER END -->

<!-- ABOUT SECTION START -->
<div class="section-full p-t120 p-b90 site-bg-white">
    <div class="container">
        <div class="section-head center wt-small-separator-outer">
            <div class="wt-small-separator site-text-primary">
               <div>About Fursanet</div>                                
            </div>
            <h2 class="wt-title">Millions of jobs. Find the one that’s right for you.</h2>
            <p>
                We are a leading job portal connecting top talent with the best employers. Our mission is to simplify the hiring process and help candidates build fulfilling careers. 
                With a robust platform, advanced matching algorithms, and a commitment to quality, Fursanet makes finding your next opportunity seamless and rewarding.
            </p>
        </div>
        
        <div class="row d-flex justify-content-center">
            <div class="col-lg-4 col-md-6 m-b30">
                <div class="wt-icon-box-wraper center pb-4 pt-5 px-4 bdr-1 bdr-solid bdr-gray hover-shadow bg-white corner-radius-10">
                    <div class="icon-md m-b20">
                        <span class="icon-cell site-text-primary"><i class="flaticon-resume"></i></span>
                    </div>
                    <div class="icon-content">
                        <h4 class="wt-tilte m-b15">Search Millions of Jobs</h4>
                        <p>Access thousands of new listings added every day from top companies worldwide.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 m-b30">
                <div class="wt-icon-box-wraper center pb-4 pt-5 px-4 bdr-1 bdr-solid bdr-gray hover-shadow bg-white corner-radius-10">
                    <div class="icon-md m-b20">
                        <span class="icon-cell site-text-primary"><i class="flaticon-customer-service"></i></span>
                    </div>
                    <div class="icon-content">
                        <h4 class="wt-tilte m-b15">Top Careers</h4>
                        <p>Explore resources and guides to build your skills and excel in your professional journey.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 m-b30">
                <div class="wt-icon-box-wraper center pb-4 pt-5 px-4 bdr-1 bdr-solid bdr-gray hover-shadow bg-white corner-radius-10">
                    <div class="icon-md m-b20">
                        <span class="icon-cell site-text-primary"><i class="flaticon-mail"></i></span>
                    </div>
                    <div class="icon-content">
                        <h4 class="wt-tilte m-b15">Job Alerts</h4>
                        <p>Never miss an opportunity with personalized job alerts sent straight to your inbox.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ABOUT SECTION END -->
