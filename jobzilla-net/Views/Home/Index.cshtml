            <!--Banner Start-->
            <div class="twm-home1-banner-section site-bg-gray bg-cover" style="background-image:url(/images/main-slider/slider1/bg1.jpg)">
                <div class="row">
                    
                    <!--Left Section-->
                    <div class="col-xl-6 col-lg-6 col-md-12">
                        <div class="twm-bnr-left-section">
                            <div class="twm-bnr-title-small">We Have <span class="site-text-primary">208,000+</span> Live Jobs</div>
                            <div class="twm-bnr-title-large">Find the <span class="site-text-primary">job</span> that fits your life</div>
                            <div class="twm-bnr-discription">Type your keyword, then click search to find your perfect job.</div>

                            <div class="twm-bnr-search-bar">
                                <form asp-controller="Jobs" asp-action="Index" method="get">
                                    <div class="row align-items-end g-2 g-md-3">
                                        <!--Keyword Search-->
                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <label style="display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; color: #b0b0b0; margin-bottom: 10px; text-transform: uppercase;">What</label>
                                            <input type="text" name="keyword" class="form-control" placeholder="Job title, keywords..." style="border: 1px solid #ddd; padding: 13px 15px; font-size: 14px; border-radius: 4px; transition: all 0.3s; background-color: #f9f9f9;" onmouseover="this.style.backgroundColor='#fff'; this.style.borderColor='#1967d2';" onmouseout="this.style.backgroundColor='#f9f9f9'; this.style.borderColor='#ddd';">
                                        </div>

                                        <!--Category-->
                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <label style="display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; color: #b0b0b0; margin-bottom: 10px; text-transform: uppercase;">Category</label>
                                            <select class="form-control selectpicker" name="categoryId" data-live-search="true">
                                                <option value="">All Categories</option>
                                                @if (Model?.JobCategories != null && Model.JobCategories.Any())
                                                {
                                                    @foreach (var cat in Model.JobCategories)
                                                    {
                                                        <option value="@cat.Id">@cat.Name</option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        <!--Location-->
                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <label style="display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; color: #b0b0b0; margin-bottom: 10px; text-transform: uppercase;">Location</label>
                                            <div class="input-group">
                                                <input name="location" type="text" class="form-control" placeholder="City, region..." style="border: 1px solid #ddd; padding: 13px 15px; font-size: 14px; border-radius: 4px 0 0 4px; background-color: #f9f9f9;">
                                                <span class="input-group-text" style="border: 1px solid #ddd; border-left: none; background-color: #f9f9f9; border-radius: 0 4px 4px 0;"><i class="fas fa-map-marker-alt" style="color: #999; font-size: 16px;"></i></span>
                                            </div>
                                        </div>

                                        <!--Find job btn-->
                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <button type="submit" class="btn w-100" style="padding: 13px 20px; font-size: 15px; font-weight: 600; background-color: #1967d2; border: 2px solid #1967d2; color: white; border-radius: 4px; transition: all 0.3s; cursor: pointer;" onmouseover="this.style.backgroundColor='#0d47a1'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(25,103,210,0.35)';" onmouseout="this.style.backgroundColor='#1967d2'; this.style.transform='translateY(0)'; this.style.boxShadow='none';">Find Job</button>
                                        </div>

                                    </div>
                                </form>
                            </div>

