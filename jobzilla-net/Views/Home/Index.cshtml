@model jobzilla_net.Models.Home.HomePageViewModel

<!-- LOADING AREA START ===== -->
<div class="loading-area">
    <div class="loading-box"></div>
    <div class="loading-pic">
        <div class="wrapper">
            <div class="cssload-loader"></div>
        </div>
    </div>
</div>
<!-- LOADING AREA  END ====== -->

<div class="page-content jzx-home">

    <!-- ============ HERO ============ -->
    <section class="jzx-hero">
        <div class="jzx-hero-aurora">
            <span class="jzx-orb jzx-orb-1"></span>
            <span class="jzx-orb jzx-orb-2"></span>
            <span class="jzx-orb jzx-orb-3"></span>
            <span class="jzx-grid-lines"></span>
        </div>

        <div class="container">
            <div class="row align-items-center jzx-hero-row">

                <!-- Left -->
                <div class="col-xl-6 col-lg-6 col-md-12">
                    <div class="jzx-hero-copy">
                        <span class="jzx-eyebrow jz-reveal">
                            <span class="jzx-eyebrow-dot"></span>
                            <span class="counter">208,000</span>+ live opportunities
                        </span>

                        <h1 class="jzx-hero-title jz-reveal" data-reveal-delay="80">
                            Find the <span class="jzx-grad-text">job</span> that<br>
                            fits your <span class="jzx-underline">life</span>
                        </h1>

                        <p class="jzx-hero-lead jz-reveal" data-reveal-delay="160">
                            Search thousands of curated roles from the world's best
                            companies. Type a keyword, pick a field, and let the perfect
                            role find you.
                        </p>

                        <!-- Search (functional) -->
                        <div class="jzx-search jz-reveal" data-reveal-delay="240">
                            <form asp-controller="Jobs" asp-action="Index" method="get">
                                <div class="jzx-search-grid">
                                    <div class="jzx-field">
                                        <label for="jzx-what"><i class="feather-search"></i></label>
                                        <input id="jzx-what" type="text" name="keyword" placeholder="Job title or keyword">
                                    </div>

                                    <button type="submit" class="jzx-search-btn">
                                        <span>Search</span>
                                        <i class="feather-arrow-right"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="jzx-popular jz-reveal" data-reveal-delay="320">
                            <span class="jzx-popular-label">Trending</span>
                            <a asp-controller="Jobs" asp-action="Index" asp-route-keyword="Developer">Developer</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-route-keyword="Designer">Designer</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-route-keyword="Architect">Architect</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-route-keyword="Engineer">Engineer</a>
                        </div>
                    </div>
                </div>

                <!-- Right visual -->
                <div class="col-xl-6 col-lg-6 col-md-12">
                    <div class="jzx-hero-stage jz-reveal-scale" data-reveal-delay="200">
                        <div class="jzx-stage-glow"></div>

                        <div class="jzx-hero-photo">
                            <img src="~/images/jzx/hero-figure.svg" alt="Find your job">
                        </div>

                        <!-- floating glass card: featured job -->
                        <div class="jzx-float jzx-float-job">
                            <span class="jzx-float-logo"><i class="feather-briefcase"></i></span>
                            <div class="jzx-float-body">
                                <strong>Product Designer</strong>
                                <span>Remote · Full-time</span>
                            </div>
                            <span class="jzx-float-badge">New</span>
                        </div>

                        <!-- floating glass card: rating -->
                        <div class="jzx-float jzx-float-rating">
                            <div class="jzx-stars">
                                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                            </div>
                            <span>Loved by 12k+ job seekers</span>
                        </div>

                        <!-- floating glass card: hires -->
                        <div class="jzx-float jzx-float-hires">
                            <div class="jzx-avatars">
                                <img src="~/images/main-slider/slider1/user/u-1.jpg" alt="">
                                <img src="~/images/main-slider/slider1/user/u-2.jpg" alt="">
                                <img src="~/images/main-slider/slider1/user/u-3.jpg" alt="">
                                <img src="~/images/main-slider/slider1/user/u-4.jpg" alt="">
                                <span class="jzx-avatars-more">+9k</span>
                            </div>
                            <span>Hired this month</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <a href="#jzx-stats" class="jzx-scroll-cue"><i class="feather-chevron-down"></i></a>
    </section>

    <!-- ============ STATS ============ -->
    <section class="jzx-stats" id="jzx-stats">
        <div class="container">
            <div class="jzx-stats-card jz-reveal">
                <div class="jzx-stat">
                    <span class="jzx-stat-icon"><i class="feather-briefcase"></i></span>
                    <div>
                        <span class="jzx-stat-num"><span class="counter">208,000</span>+</span>
                        <span class="jzx-stat-label">Live jobs</span>
                    </div>
                </div>
                <div class="jzx-stat">
                    <span class="jzx-stat-icon jzx-ic-green"><i class="feather-home"></i></span>
                    <div>
                        <span class="jzx-stat-num"><span class="counter">@(Model.TotalCompanies > 0 ? Model.TotalCompanies : 12000)</span>+</span>
                        <span class="jzx-stat-label">Companies</span>
                    </div>
                </div>
                <div class="jzx-stat">
                    <span class="jzx-stat-icon jzx-ic-amber"><i class="feather-globe"></i></span>
                    <div>
                        <span class="jzx-stat-num"><span class="counter">@(Model.TotalCountries > 0 ? Model.TotalCountries : 50)</span>+</span>
                        <span class="jzx-stat-label">Countries</span>
                    </div>
                </div>
                <div class="jzx-stat">
                    <span class="jzx-stat-icon jzx-ic-indigo"><i class="feather-check-circle"></i></span>
                    <div>
                        <span class="jzx-stat-num"><span class="counter">@(Model.TotalJobsDone > 0 ? Model.TotalJobsDone : 3000)</span>+</span>
                        <span class="jzx-stat-label">Jobs filled</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="jzx-section">
        <div class="container">
            <div class="jzx-head jz-reveal">
                <span class="jzx-kicker">Working process</span>
                <h2 class="jzx-title">Land your role in three steps</h2>
            </div>

            <div class="jzx-steps">
                <div class="jzx-step jz-reveal">
                    <span class="jzx-step-index">01</span>
                    <span class="jzx-step-icon"><i class="feather-user-plus"></i></span>
                    <h4>Create your account</h4>
                    <p>Set up a free profile in under a minute and unlock every job on the board.</p>
                </div>
                <div class="jzx-step jz-reveal">
                    <span class="jzx-step-index">02</span>
                    <span class="jzx-step-icon"><i class="feather-search"></i></span>
                    <h4>Find your match</h4>
                    <p>Filter by field, salary and location to surface roles built around your life.</p>
                </div>
                <div class="jzx-step jz-reveal">
                    <span class="jzx-step-index">03</span>
                    <span class="jzx-step-icon"><i class="feather-send"></i></span>
                    <h4>Apply &amp; get hired</h4>
                    <p>Upload your resume once and apply to any position with a single click.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ CATEGORIES ============ -->
    <section class="jzx-section">
        <div class="container">
            <div class="jzx-head jzx-head-split jz-reveal">
                <div>
                    <span class="jzx-kicker">Browse by field</span>
                    <h2 class="jzx-title">Choose your desired category</h2>
                </div>
                <a asp-controller="Jobs" asp-action="Index" class="jzx-link-btn">All categories <i class="feather-arrow-right"></i></a>
            </div>

            <div class="jzx-cat-grid">
                @{
                    var cats = new (string icon, string name, string jobs)[]
                    {
                        ("flaticon-dashboard", "Business Development", "9,185"),
                        ("flaticon-project-management", "Project Management", "3,205"),
                        ("flaticon-note", "Content Writer", "2,100"),
                        ("flaticon-customer-support", "Customer Services", "1,500"),
                        ("flaticon-bars", "Accounting / Finance", "4,120"),
                        ("flaticon-user", "Marketing", "3,540"),
                        ("flaticon-computer", "Design & Art", "2,780"),
                        ("flaticon-coding", "Web Development", "6,300"),
                        ("flaticon-hr", "Human Resource", "1,940"),
                        ("flaticon-healthcare", "Health and Care", "2,215"),
                        ("flaticon-bank", "Banking", "1,120"),
                        ("flaticon-engineer", "Construction", "3,860"),
                    };
                }
                @foreach (var c in cats)
                {
                    <a asp-controller="Jobs" asp-action="Index" class="jzx-cat jz-reveal-scale">
                        <span class="jzx-cat-icon"><span class="@c.icon"></span></span>
                        <span class="jzx-cat-name">@c.name</span>
                        <span class="jzx-cat-jobs">@c.jobs jobs</span>
                        <i class="feather-arrow-up-right jzx-cat-arrow"></i>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- ============ CV / EXPLORE CTA ============ -->
    <section class="jzx-section">
        <div class="container">
            <div class="jzx-cta jz-reveal-scale">
                <span class="jzx-cta-blob jzx-cta-blob-1"></span>
                <span class="jzx-cta-blob jzx-cta-blob-2"></span>
                <div class="jzx-cta-inner">
                    <div class="jzx-cta-copy">
                        <span class="jzx-kicker jzx-kicker-light">Explore new life</span>
                        <h2>Don't just find. Be found by great employers.</h2>
                        <p>Put your CV in front of thousands of recruiters actively hiring right now. One upload, endless opportunities.</p>
                        <button type="button" class="jzx-cta-btn">
                            Upload your resume <i class="feather-upload"></i>
                        </button>
                    </div>
                    <div class="jzx-cta-media">
                        <img src="~/images/jzx/cta-figure.svg" alt="Upload your resume">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ FEATURED JOBS ============ -->
    <section class="jzx-section">
        <div class="container">
            <div class="jzx-head jz-reveal">
                <span class="jzx-kicker">All jobs post</span>
                <h2 class="jzx-title">Find the career you deserve</h2>
            </div>

            <div class="jzx-jobs">
                @{
                    var jobs = new (string pic, string title, string time, string loc, string pay)[]
                    {
                        ("pic1.jpg", "Senior Web Designer & Developer", "1 day ago", "Los Angeles, CA, USA", "$2,500"),
                        ("pic2.jpg", "Senior Rolling Stock Technician", "15 days ago", "Los Angeles, CA, USA", "$2,000"),
                        ("pic3.jpg", "IT Department Manager", "6 months ago", "Los Angeles, CA, USA", "$1,500"),
                        ("pic4.jpg", "Art Production Specialist", "2 days ago", "Los Angeles, CA, USA", "$1,200"),
                        ("pic5.jpg", "Recreation & Fitness Worker", "1 day ago", "Los Angeles, CA, USA", "$1,700"),
                    };
                }
                @foreach (var j in jobs)
                {
                    <div class="jzx-job jz-reveal">
                        <div class="jzx-job-logo">
                            <img src="~/images/jobs-company/@j.pic" alt="">
                        </div>
                        <div class="jzx-job-main">
                            <a asp-controller="Jobs" asp-action="Details" class="jzx-job-title">@j.title</a>
                            <div class="jzx-job-meta">
                                <span><i class="feather-map-pin"></i> @j.loc</span>
                                <span><i class="feather-clock"></i> @j.time</span>
                            </div>
                        </div>
                        <div class="jzx-job-side">
                            <span class="jzx-job-pay">@j.pay <small>/ month</small></span>
                            <a asp-controller="Jobs" asp-action="Details" class="jzx-job-apply">Browse <i class="feather-arrow-right"></i></a>
                        </div>
                    </div>
                }
            </div>

            <div class="jzx-center">
                <a asp-controller="Jobs" asp-action="Index" class="jzx-btn-outline">Browse all jobs</a>
            </div>
        </div>
    </section>

    <!-- ============ COMPANIES MARQUEE ============ -->
    <section class="jzx-section">
        <div class="container">
            <div class="jzx-head jz-reveal">
                <span class="jzx-kicker">Top companies</span>
                <h2 class="jzx-title">Get hired at the best places</h2>
            </div>
        </div>

        <div class="jzx-marquee jz-reveal">
            <div class="jzx-marquee-track">
                @for (int pass = 0; pass < 2; pass++)
                {
                    for (int i = 1; i <= 6; i++)
                    {
                        <a asp-controller="Employers" asp-action="Index" class="jzx-logo" aria-hidden="@(pass == 1 ? "true" : "false")">
                            <img src="~/images/client-logo/w@(i).png" alt="">
                        </a>
                    }
                }
            </div>
        </div>

        <div class="container">
            <div class="jzx-mini-stats jz-reveal">
                <div><strong><span class="counter">5</span>M+</strong><span>Daily active users</span></div>
                <div><strong><span class="counter">9</span>K+</strong><span>Open positions</span></div>
                <div><strong><span class="counter">2</span>M+</strong><span>Stories shared</span></div>
            </div>
        </div>
    </section>

    <!-- ============ TESTIMONIALS ============ -->
    <section class="jzx-section">
        <div class="container">
            <div class="jzx-head jz-reveal">
                <span class="jzx-kicker">Testimonials</span>
                <h2 class="jzx-title">What our members say</h2>
            </div>

            <div class="jzx-testi-grid">
                @{
                    var testis = new (string pic, string name, string role, string quote)[]
                    {
                        ("pic-1.png", "Nikola Tesla", "Accountant", "I landed a job I applied for through Fursanet within a week. The search felt like it was built for me."),
                        ("pic-2.png", "Ada Lovelace", "Developer", "Clean, fast and genuinely helpful. I used it every single day during my hunt and it paid off."),
                        ("pic-3.png", "Alan Turing", "Data Analyst", "The best job board I've used. Applying was effortless and I heard back from real employers fast."),
                    };
                }
                @foreach (var t in testis)
                {
                    <div class="jzx-testi jz-reveal-scale">
                        <i class="fas fa-quote-right jzx-testi-quote"></i>
                        <p class="jzx-testi-text">@t.quote</p>
                        <div class="jzx-testi-person">
                            <img src="~/images/testimonials/@t.pic" alt="@t.name">
                            <div>
                                <strong>@t.name</strong>
                                <span>@t.role</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ============ BLOG ============ -->
    <section class="jzx-section jzx-section-last">
        <div class="container">
            <div class="jzx-head jz-reveal">
                <span class="jzx-kicker">Our blog</span>
                <h2 class="jzx-title">Latest articles</h2>
            </div>

            <div class="jzx-blog-grid">
                @{
                    var posts = new (string img, string date, string author, string title)[]
                    {
                        ("bg1.jpg", "March 05, 2023", "Mark Petter", "How to convince recruiters and get your dream job"),
                        ("bg2.jpg", "March 05, 2023", "David Wish", "5 things to know about the latest jobs report"),
                        ("bg3.jpg", "March 05, 2023", "Mike Doe", "Why job boards are the most important sector today"),
                    };
                }
                @foreach (var p in posts)
                {
                    <article class="jzx-post jz-reveal">
                        <a asp-controller="Blogs" asp-action="Details" class="jzx-post-media">
                            <img src="~/images/blog/latest/@p.img" alt="">
                        </a>
                        <div class="jzx-post-body">
                            <div class="jzx-post-meta">
                                <span><i class="feather-calendar"></i> @p.date</span>
                                <span>By <a asp-controller="Candidates" asp-action="Details">@p.author</a></span>
                            </div>
                            <h4><a asp-controller="Blogs" asp-action="Details">@p.title</a></h4>
                            <p>New chip traps clusters of migrating tumor cells asperiortenetur, blanditiis odit.</p>
                            <a asp-controller="Blogs" asp-action="Details" class="jzx-post-more">Read more <i class="feather-arrow-right"></i></a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

</div>
<!-- CONTENT END -->

<!-- BUTTON TOP START -->
<button class="scroltop"><span class="fa fa-angle-up relative" id="btn-vibrate"></span></button>

<!--Model Popup Section Start-->
<!--Signup popup -->
<div class="modal fade twm-sign-up" id="sign_up_popup" aria-hidden="true" aria-labelledby="sign_up_popupLabel" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h2 class="modal-title" id="sign_up_popupLabel">Sign Up</h2>
                <p>Sign Up and get access to all the features of Fursanet</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="twm-tabs-style-2">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">

                        <!--Signup Candidate-->
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#sign-candidate" type="button"><i class="fas fa-user-tie"></i>Candidate</button>
                        </li>
                        <!--Signup Employer-->
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sign-Employer" type="button"><i class="fas fa-building"></i>Employer</button>
                        </li>

                    </ul>
                    <div class="tab-content" id="myTabContent">
                        <!--Signup Candidate Content-->
                        <div class="tab-pane fade show active" id="sign-candidate">
                            <form id="registerCandidateForm" asp-controller="Account" asp-action="Register" method="post">
                                <input type="hidden" name="UserType" value="Candidate" />
                                <input type="hidden" name="ConfirmPassword" value="" />
                                <div class="auth-error-message text-danger mb-3" style="display:none;"></div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="UserName" type="text" required="" class="form-control" placeholder="Username*">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="Password" type="password" class="form-control" required="" placeholder="Password*">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="Email" type="email" class="form-control" required="" placeholder="Email*">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="PhoneNumber" type="text" class="form-control" placeholder="Phone">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <div class=" form-check">
                                                <input type="checkbox" name="AgreeToTerms" value="true" class="form-check-input" id="agree1" required>
                                                <label class="form-check-label" for="agree1">I agree to the <a asp-controller="Home" asp-action="Index">Terms and conditions</a></label>
                                                <p>Already registered?
                                                    <button type="button" class="twm-backto-login" data-bs-target="#sign_up_popup2" data-bs-toggle="modal" data-bs-dismiss="modal">Log in here</button>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <button type="submit" class="site-button">Sign Up</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <!--Signup Employer Content-->
                        <div class="tab-pane fade" id="sign-Employer">
                            <form id="registerEmployerForm" asp-controller="Account" asp-action="Register" method="post">
                                <input type="hidden" name="UserType" value="Employer" />
                                <input type="hidden" name="ConfirmPassword" value="" />
                                <div class="auth-error-message text-danger mb-3" style="display:none;"></div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="UserName" type="text" required="" class="form-control" placeholder="Username*">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="Password" type="password" class="form-control" required="" placeholder="Password*">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="Email" type="email" class="form-control" required="" placeholder="Email*">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <input name="PhoneNumber" type="text" class="form-control" placeholder="Phone">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group mb-3">
                                            <div class=" form-check">
                                                <input type="checkbox" name="AgreeToTerms" value="true" class="form-check-input" id="agree2" required>
                                                <label class="form-check-label" for="agree2">I agree to the <a asp-controller="Home" asp-action="Index">Terms and conditions</a></label>
                                                <p>Already registered?
                                                    <button type="button" class="twm-backto-login" data-bs-target="#sign_up_popup2" data-bs-toggle="modal" data-bs-dismiss="modal">Log in here</button>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <button type="submit" class="site-button">Sign Up</button>
                                    </div>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <span class="modal-f-title">Login or Sign up with</span>
                <ul class="twm-modal-social">
                    <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Facebook" class="facebook-clr"><i class="fab fa-facebook-f"></i></a></li>
                    <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Twitter" class="twitter-clr"><i class="fab fa-twitter"></i></a></li>
                    <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="LinkedIn" class="linkedin-clr"><i class="fab fa-linkedin-in"></i></a></li>
                    <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google" class="google-clr"><i class="fab fa-google"></i></a></li>
                </ul>
            </div>

        </div>
    </div>
</div>
<!--Login popup -->
<div class="modal fade twm-sign-up" id="sign_up_popup2" aria-hidden="true" aria-labelledby="sign_up_popupLabel2" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h2 class="modal-title" id="sign_up_popupLabel2">Login</h2>
                <p>Login and get access to all the features of Fursanet</p>
