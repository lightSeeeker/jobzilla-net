@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var authForms = ['registerCandidateForm', 'registerEmployerForm', 'loginCandidateForm', 'loginEmployerForm'];
            authForms.forEach(function(formId) {
                var form = document.getElementById(formId);
                if (!form) return;
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var errorDiv = form.querySelector('.auth-error-message');
                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (errorDiv) errorDiv.style.display = 'none';
                    if (submitBtn) submitBtn.disabled = true;
                    try {
                        var passwordInput = form.querySelector('input[name="Password"]');
                        var confirmInput = form.querySelector('input[name="ConfirmPassword"]');
                        if (passwordInput && confirmInput) { confirmInput.value = passwordInput.value; }
                        var formData = new FormData(form);
                        var response = await fetch(form.action, {
                            method: 'POST', body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        var result = await response.json();
                        if (response.ok && result.success) {
                            window.location.href = result.redirectUrl;
                        } else if (errorDiv) {
                            errorDiv.textContent = result.message || 'An error occurred.';
                            errorDiv.style.display = 'block';
                        }
                    } catch (err) {
                        if (errorDiv) { errorDiv.textContent = 'A network error occurred. Please try again.'; errorDiv.style.display = 'block'; }
                    } finally {
                        if (submitBtn) submitBtn.disabled = false;
                    }
                });
            });
        });
    </script>
}
