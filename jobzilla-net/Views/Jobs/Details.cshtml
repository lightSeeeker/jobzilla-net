@model jobzilla_net.Application.Jobs.Dtos.JobSummaryDto
@inject jobzilla_net.Services.CurrencyContext Ccy
@{
    ViewData["Title"] = Model.Title + " - Job Detail";

    var daysAgo  = (int)(DateTime.UtcNow - Model.CreatedAtUtc).TotalDays;
    var ageLabel = daysAgo == 0 ? "Today"
                 : daysAgo == 1 ? "1 day ago"
                 : daysAgo < 30 ? $"{daysAgo} days ago"
                 : $"{daysAgo / 30} month ago";

    var salaryText = Ccy.FormatRange(Model.MinimumSalary, Model.MaximumSalary);
}

