<!-- Apply Job Popup (static â€” preserved from template) -->
<div class="modal fade" id="apply_job_popup" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="sign_up_popupLabel">Apply For This Job</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="apl-job-inpopup">
                    <div class="panel panel-default">
                        <div class="panel-body wt-panel-body p-a20">
                            <form id="applyJobForm" class="twm-tabs-style-1">
                                <div id="applyMessageArea"></div>
                                <div class="row">
                                    <input type="hidden" name="jobId" value="@Model.Id" />
                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                        <div class="form-group">
                                            <label>Select Resume</label>
                                            <div class="ls-inputicon-box">
                                                <select class="form-control" name="resumeId" required>
                                                    <option value="">-- Select a Resume --</option>
                                                    @if (ViewBag.CandidateResumes != null)
                                                    {
                                                        foreach (var resume in (List<jobzilla_net.Application.Candidates.Dtos.CandidateResumeDto>)ViewBag.CandidateResumes)
                                                        {
                                                            <option value="@resume.Id">@resume.Title @(resume.IsDefault ? "(Default)" : "")</option>
                                                        }
                                                    }
                                                </select>
                                                <i class="fs-input-icon fa fa-file-alt"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Cover Letter (Optional)</label>
                                            <textarea class="form-control" name="coverLetter" rows="3" placeholder="Message sent to the employer"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-lg-12 col-md-12 text-right">
                                        <button type="submit" id="btnApplySubmit" class="site-button">Submit Application</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('applyJobForm');
            if (form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    const btn = document.getElementById('btnApplySubmit');
                    const msgArea = document.getElementById('applyMessageArea');
                    const formData = new FormData(form);
                    
                    btn.disabled = true;
                    btn.innerHTML = 'Submitting... <i class="fa fa-spinner fa-spin"></i>';
                    msgArea.innerHTML = '';
                    
                    try {
                        const response = await fetch('/Candidate/ApplyJob', {
                            method: 'POST',
                            body: formData
                        });
                        
                        const result = await response.json();
                        
                        if (result.success) {
                            msgArea.innerHTML = `<div class="alert alert-success">${result.message}</div>`;
                            form.reset();
                            // Disable the apply button on the page
                            const applyBtn = document.getElementById('apply-now-btn');
                            if (applyBtn) {
                                applyBtn.className = 'site-button outline-primary disabled';
                                applyBtn.innerHTML = 'Already Applied';
                                applyBtn.removeAttribute('data-bs-toggle');
                                applyBtn.removeAttribute('href');
                            }
                            
                            setTimeout(() => {
                                const modalEl = document.getElementById('apply_job_popup');
                                const modal = bootstrap.Modal.getInstance(modalEl);
                                if (modal) modal.hide();
                            }, 2000);
                        } else {
                            msgArea.innerHTML = `<div class="alert alert-danger">${result.message}</div>`;
                            btn.disabled = false;
                            btn.innerHTML = 'Submit Application';
                        }
                    } catch (error) {
                        msgArea.innerHTML = `<div class="alert alert-danger">An error occurred while submitting. Please try again.</div>`;
                        btn.disabled = false;
                        btn.innerHTML = 'Submit Application';
                    }
                });
            }
        });
    </script>
}



