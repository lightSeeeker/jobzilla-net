@model jobzilla_net.Models.Jobs.JobSearchViewModel
@using jobzilla_net.Application.Jobs.Dtos
@{
    ViewData["Title"] = "Jobs List";

    string BadgeCss(string type) => type switch
    {
        "FullTime"   => "twm-bg-purple",
        "PartTime"   => "twm-bg-brown",
        "Contract"   => "twm-bg-sky",
        "Freelance"  => "twm-bg-sky",
        "Internship" => "twm-bg-brown",
        "Temporary"  => "twm-bg-golden",
        _            => "twm-bg-green"
    };
}

<!-- INNER PAGE BANNER -->
<div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url(/images/banner/1.jpg);">
    <div class="overlay-main site-bg-white opacity-01"></div>
    <div class="container">
        <div class="wt-bnr-inr-entry">
            <div class="banner-title-outer">
                <div class="banner-title-name">
                    <h2 class="wt-title">The Most Exciting Jobs</h2>
                </div>
            </div>
            <div>
                <ul class="wt-breadcrumb breadcrumb-style-2">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li>Jobs List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- INNER PAGE BANNER END -->

<!-- OUR BLOG START -->
<div class="section-full p-t120  p-b90 site-bg-white">

    <div class="container">
        <div class="row">

            <div class="col-lg-4 col-md-12 rightSidebar">

                <div class="side-bar">

                    <div class="sidebar-elements search-bx">
                        <form action="/Jobs" method="get">

                            <div class="form-group mb-4">
                                <h4 class="section-head-small mb-4">Category</h4>
                                <select name="categoryId" class="wt-select-bar-large selectpicker" data-live-search="true" data-bv-field="size">
                                    <option value="">All Categories</option>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        if (Model.CategoryId == cat.Id)
                                        {
                                            <option value="@cat.Id" selected="selected">@cat.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group mb-4">
                                <h4 class="section-head-small mb-4">Keyword</h4>
                                <div class="input-group">
                                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Job Title or Keyword">
                                    <button class="btn" type="submit"><i class="feather-search"></i></button>
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                <h4 class="section-head-small mb-4">Location</h4>
                                <div class="input-group">
                                    <input type="text" name="location" value="@Model.Location" class="form-control" placeholder="Search location">
                                    <button class="btn" type="submit"><i class="feather-map-pin"></i></button>
                                </div>
                            </div>

                            <div class="twm-sidebar-ele-filter">
                                <h4 class="section-head-small mb-4">Job Type</h4>
                                <ul>
                                    <li>
                                        <div class=" form-check">
                                            <input type="checkbox" class="form-check-input" id="exampleCheck1">
                                            <label class="form-check-label" for="exampleCheck1">Freelance</label>
                                        </div>
                                        <span class="twm-job-type-count">09</span>
                                    </li>
                                    <li>
                                        <div class=" form-check">
                                            <input type="checkbox" class="form-check-input" id="exampleCheck2">
                                            <label class="form-check-label" for="exampleCheck2">Full Time</label>
                                        </div>
                                        <span class="twm-job-type-count">07</span>
                                    </li>
                                    <li>
                                        <div class=" form-check">
                                            <input type="checkbox" class="form-check-input" id="exampleCheck3">
                                            <label class="form-check-label" for="exampleCheck3">Internship</label>
                                        </div>
                                        <span class="twm-job-type-count">15</span>
                                    </li>
                                    <li>
                                        <div class=" form-check">
                                            <input type="checkbox" class="form-check-input" id="exampleCheck4">
                                            <label class="form-check-label" for="exampleCheck4">Part Time</label>
                                        </div>
                                        <span class="twm-job-type-count">20</span>
                                    </li>
                                    <li>
                                        <div class=" form-check">
                                            <input type="checkbox" class="form-check-input" id="exampleCheck5">
                                            <label class="form-check-label" for="exampleCheck5">Temporary</label>
                                        </div>
                                        <span class="twm-job-type-count">22</span>
                                    </li>
                                    <li>
                                        <div class=" form-check">
                                            <input type="checkbox" class="form-check-input" id="exampleCheck6">
                                            <label class="form-check-label" for="exampleCheck6">Volunteer</label>
                                        </div>
                                        <span class="twm-job-type-count">25</span>
                                    </li>
                                </ul>
                            </div>

                            <div class="twm-sidebar-ele-filter">
                                <h4 class="section-head-small mb-4">Date Posts</h4>
                                <ul>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="exampleradio1">
                                            <label class="form-check-label" for="exampleradio1">Last hour</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="exampleradio2">
                                            <label class="form-check-label" for="exampleradio2">Last 24 hours</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="exampleradio3">
                                            <label class="form-check-label" for="exampleradio3">Last 7 days</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="exampleradio4">
                                            <label class="form-check-label" for="exampleradio4">Last 14 days</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="exampleradio5">
                                            <label class="form-check-label" for="exampleradio5">Last 30 days</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="exampleradio6">
                                            <label class="form-check-label" for="exampleradio6">All</label>
                                        </div>
                                    </li>
                                </ul>
                            </div>

                            <div class="twm-sidebar-ele-filter">
                                <h4 class="section-head-small mb-4">Type of employment</h4>
                                <ul>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="et_freelance" name="employmentType" value="Freelance" @(Model.EmploymentType == "Freelance" ? "checked" : "")>
                                            <label class="form-check-label" for="et_freelance">Freelance</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="et_fulltime" name="employmentType" value="FullTime" @(Model.EmploymentType == "FullTime" ? "checked" : "")>
                                            <label class="form-check-label" for="et_fulltime">Full Time</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="et_internship" name="employmentType" value="Internship" @(Model.EmploymentType == "Internship" ? "checked" : "")>
                                            <label class="form-check-label" for="et_internship">Internship</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="et_parttime" name="employmentType" value="PartTime" @(Model.EmploymentType == "PartTime" ? "checked" : "")>
                                            <label class="form-check-label" for="et_parttime">Part Time</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="et_contract" name="employmentType" value="Contract" @(Model.EmploymentType == "Contract" ? "checked" : "")>
                                            <label class="form-check-label" for="et_contract">Contract</label>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="et_temporary" name="employmentType" value="Temporary" @(Model.EmploymentType == "Temporary" ? "checked" : "")>
                                            <label class="form-check-label" for="et_temporary">Temporary</label>
                                        </div>
                                    </li>
                                    @if (!string.IsNullOrEmpty(Model.EmploymentType))
                                    {
                                        <li>
                                            <div class="form-check">
                                                <input type="radio" class="form-check-input" id="et_all" name="employmentType" value="">
                                                <label class="form-check-label" for="et_all">All Types</label>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="form-group mb-4">
                                <h4 class="section-head-small mb-4">Salary Range</h4>
                                <div class="input-group mb-2">
                                    <input type="number" name="minSalary" value="@Model.MinSalary" class="form-control" placeholder="Min salary">
                                </div>
                                <div class="input-group">
                                    <input type="number" name="maxSalary" value="@Model.MaxSalary" class="form-control" placeholder="Max salary">
                                </div>
                            </div>

                            <!-- Reset page to 1 when filters change -->
                            <input type="hidden" name="page" value="1" />
                            <input type="hidden" name="pageSize" value="@Model.PageSize" />

                            <button type="submit" class="site-button">Search Jobs</button>

                        </form>
                    </div>

                    <div class="widget tw-sidebar-tags-wrap">
                        <h4 class="section-head-small mb-4">Tags</h4>
                        <div class="tagcloud">
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">General</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">Jobs </a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">Payment</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">Application </a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">Work</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">Recruiting</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Employers" asp-action="Index">Employer</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">Income</a>
                            <a asp-controller="Jobs" asp-action="Index" asp-controller="Jobs" asp-action="Index">Tips</a>
                        </div>
                    </div>

                </div>

                <div class="twm-advertisment" style="background-image:url(/images/add-bg.jpg);">
                    <div class="overlay"></div>
                    <h4 class="twm-title">Recruiting?</h4>
                    <p>Get Best Matched Jobs On your <br>
                        Email. Add Resume NOW!</p>
                    <a asp-controller="Home" asp-action="Index" class="site-button white">Read More</a>
                </div>

            </div>

            <div class="col-lg-8 col-md-12">
                <!--Filter Short By-->
                <div class="product-filter-wrap d-flex justify-content-between align-items-center m-b30">
                    <span class="woocommerce-result-count-left">Showing @Model.Result.TotalCount jobs</span>

                    <form class="woocommerce-ordering twm-filter-select" method="get">
                        <span class="woocommerce-result-count">Short By</span>
                        <select class="wt-select-bar-2 selectpicker" data-live-search="true" data-bv-field="size">
                            <option>Most Recent</option>
                            <option>Freelance</option>
                            <option>Full Time</option>
                            <option>Internship</option>
                            <option>Part Time</option>
                            <option>Temporary</option>
                        </select>
                        <select class="wt-select-bar-2 selectpicker" data-live-search="true" data-bv-field="size">
                            <option>Show 10</option>
                            <option>Show 20</option>
                            <option>Show 30</option>
                            <option>Show 40</option>
                            <option>Show 50</option>
                            <option>Show 60</option>
                        </select>
                    </form>

                </div>

                <!-- â”€â”€ DYNAMIC JOB CARDS â”€â”€ only this <ul> is replaced â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                <div class="twm-jobs-list-wrap">
                    <ul>
                        @if (!Model.Result.Items.Any())
                        {
                            <li>
                                <div class="twm-jobs-list-style1 mb-5 text-center p-4">
                                    <p>No jobs found.</p>
                                </div>
                            </li>
                        }
                        @foreach (JobSummaryDto job in Model.Result.Items)
                        {
                            var daysAgo = (int)(DateTime.UtcNow - job.CreatedAtUtc).TotalDays;
                            var ageLabel = daysAgo == 0 ? "Today"
                                         : daysAgo == 1 ? "1 day ago"
                                         : daysAgo < 30 ? $"{daysAgo} days ago"
                                         : $"{daysAgo / 30} month ago";
                            var badgeCss = BadgeCss(job.EmploymentType);
                            var typeLabel = job.EmploymentType
                                .Replace("FullTime", "Full Time")
                                .Replace("PartTime", "Part Time");

                            <li>
                                <div class="twm-jobs-list-style1 mb-5">
                                    <div class="twm-media">
                                        @if (!string.IsNullOrEmpty(job.CompanyLogoPath))
                                        {
                                            <img src="@job.CompanyLogoPath" alt="@job.CompanyName" />
                                        }
                                        else
                                        {
                                            <img src="~/images/jobs-company/pic1.jpg" alt="@job.CompanyName" />
                                        }
                                    </div>
                                    <div class="twm-mid-content">
                                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="twm-job-title">
                                            <h4>@job.Title <span class="twm-job-post-duration">/ @ageLabel</span></h4>
                                        </a>
                                        <p class="twm-job-address">@job.Location</p>
                                        <a asp-controller="Employers" asp-action="Details" class="twm-job-websites site-text-primary">@job.CompanyName</a>
                                    </div>
                                    <div class="twm-right-content">
                                        <div class="twm-jobs-category green"><span class="@badgeCss">@typeLabel</span></div>
                                        <div class="twm-jobs-amount">
                                            @(job.MinimumSalary.HasValue ? job.MinimumSalary.Value.ToString("C0") : "Negotiable")
                                            <span>/ Month</span>
                                        </div>
                                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="twm-jobs-browse site-text-primary">Browse Job</a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <!-- â”€â”€ END DYNAMIC JOB CARDS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->

                @if (Model.Result.TotalPages > 1)
                {
                    // Build a URL for a given page, preserving all current filters
                    string PageUrl(int p) =>
                        $"?page={p}&pageSize={Model.PageSize}" +
                        (string.IsNullOrEmpty(Model.Keyword)        ? "" : $"&keyword={Uri.EscapeDataString(Model.Keyword)}") +
                        (string.IsNullOrEmpty(Model.Location)       ? "" : $"&location={Uri.EscapeDataString(Model.Location)}") +
                        (Model.CategoryId.HasValue                  ? $"&categoryId={Model.CategoryId}" : "") +
                        (string.IsNullOrEmpty(Model.EmploymentType) ? "" : $"&employmentType={Model.EmploymentType}") +
                        (Model.MinSalary.HasValue                   ? $"&minSalary={Model.MinSalary}" : "") +
                        (Model.MaxSalary.HasValue                   ? $"&maxSalary={Model.MaxSalary}" : "");

                    int totalPages = Model.Result.TotalPages;
                    int currPage   = Model.Result.Page;
                    int start      = Math.Max(1, currPage - 2);
                    int end        = Math.Min(totalPages, start + 4);
                    start          = Math.Max(1, end - 4);

                    <div class="pagination-outer">
                        <div class="pagination-style1">
                            <ul class="clearfix">
                                <li class="prev">
                                    <a href="@(Model.Result.HasPreviousPage ? PageUrl(currPage - 1) : "javascript:;")">
                                        <span> <i class="fa fa-angle-left"></i> </span>
                                    </a>
                                </li>
                                @for (int p = start; p <= end; p++)
                                {
                                    <li class="@(p == currPage ? "active" : "")">
                                        <a href="@PageUrl(p)">@p</a>
                                    </li>
                                }
                                @if (end < totalPages)
                                {
                                    <li><a href="#"><i class="fa fa-ellipsis-h"></i></a></li>
                                    <li><a href="@PageUrl(totalPages)">@totalPages</a></li>
                                }
                                <li class="next">
                                    <a href="@(Model.Result.HasNextPage ? PageUrl(currPage + 1) : "javascript:;")">
                                        <span> <i class="fa fa-angle-right"></i> </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>

</div>
<!-- OUR BLOG END -->




