@using jobzilla_net.Application.Resumes.Dtos
@model ResumeSection
@{
    string FormatDate(string? val, string fmt = "MMM yyyy")
    {
        if (string.IsNullOrWhiteSpace(val)) return "";
        if (DateTime.TryParse(val, out var d)) return d.ToString(fmt);
        return val;
    }
}
@foreach (var item in Model.Items.OrderBy(i => i.DisplayOrder))
{
    var n = item.GetValue("Name");
    var org = item.GetValue("IssuingOrganization");
    var dt = FormatDate(item.GetValue("IssueDate"));
    var url = item.GetValue("CredentialUrl");
    
    <div class="resume-item">
        <div class="resume-item-header">
            <span class="resume-item-title">@n</span>
            <span class="resume-item-date">@dt</span>
        </div>
        <div class="resume-item-subtitle">
            @org
            @if (!string.IsNullOrWhiteSpace(url))
            {
                <text> — <a href="@url" target="_blank" class="resume-link">View Credential</a></text>
            }
        </div>
    </div>
}
