@using jobzilla_net.Application.Resumes.Dtos
@model ResumeSection
@{
    string FormatDate(string? val, string fmt = "MMM yyyy")
    {
        if (string.IsNullOrWhiteSpace(val)) return "";
        if (DateTime.TryParse(val, out var d)) return d.ToString(fmt);
        return val;
    }
}
@foreach (var item in Model.Items.OrderBy(i => i.DisplayOrder))
{
    var jt = item.GetValue("JobTitle");
    var co = item.GetValue("CompanyName");
    var lo = item.GetValue("Location");
    var sd = FormatDate(item.GetValue("StartDate"));
    var ed = item.GetValue("IsCurrent") == "true" ? "Present" : FormatDate(item.GetValue("EndDate"));
    var de = item.GetValue("Description")?.Replace("<", "&lt;").Replace(">", "&gt;");
    
    <div class="resume-item">
        <div class="resume-item-header">
            <span class="resume-item-title">@co</span>
            <span class="resume-item-date">@sd – @ed</span>
        </div>
        <div class="resume-item-subtitle">
            @jt @if (!string.IsNullOrWhiteSpace(lo)) { <text>| @lo</text> }
        </div>
        @if (!string.IsNullOrWhiteSpace(de))
        {
            <div class="resume-item-desc">@Html.Raw(de.Replace("\n", "<br/>"))</div>
        }
    </div>
}
