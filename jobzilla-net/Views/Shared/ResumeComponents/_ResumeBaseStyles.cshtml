@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel

<style>
    /* Base reset & typography defaults */
    body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    /* PDF page-break handling to prevent awkward cuts across A4 pages */
    .resume-item {
        page-break-inside: avoid;
        break-inside: avoid;
        display: block; /* Required for page-break-inside to work reliably */
    }
    .resume-section-title {
        page-break-after: avoid;
        break-after: avoid;
        page-break-inside: avoid;
    }
    .resume-item-header {
        page-break-after: avoid;
        break-after: avoid;
        page-break-inside: avoid;
    }
    .resume-skills-list, .resume-references-grid {
        page-break-inside: avoid;
        break-inside: avoid;
    }

    /* Resume Container Sizing (Export vs Preview) */
    @if (Model.IsExport)
    {
        <text>
        .resume-container {
            width: 100%;
            max-width: 100%;
            margin: 0;
            background: #fff;
            overflow: hidden;
            min-height: 296mm;
            box-sizing: border-box;
        }
        </text>
    }
    else
    {
        <text>
        .resume-container {
            margin: 0 auto;
            background: #fff;
            overflow: hidden;
            box-sizing: border-box;
            /* Box shadows and padding differ by template */
        }
        </text>
    }
</style>

<script>
    // Universal listener for real-time color updates in the Preview Editor
    window.addEventListener('message', function (e) {
        if (e.data && e.data.type === 'applyColors') {
            var root = document.documentElement;
            Object.entries(e.data.colors).forEach(function (entry) {
                root.style.setProperty(entry[0], entry[1]);
            });
        }
    });
</script>
