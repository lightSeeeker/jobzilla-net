@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel

<style>
@@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Merriweather:wght@400;700&family=Roboto+Mono:wght@400;500&family=Lora:wght@400;700&family=Roboto:wght@400;500;700&family=Open+Sans:wght@400;600;700&family=Lato:wght@400;700&family=Playfair+Display:wght@400;700&family=Montserrat:wght@400;600;700&family=Source+Code+Pro:wght@400;600&display=swap');

    :root {
        --cvb-base-font: 'Inter', sans-serif;
        --cvb-line-height: 1.6;
        --cvb-section-margin: 30px;
        --cvb-item-margin: 15px;
    }

    /* Base reset & typography defaults */
    body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    /* Keep entries whole and headings attached to their content across A4 page breaks.
       Safe now that full-bleed backgrounds fill each page independently of content
       (Modern's fixed band, Technical's body canvas), so any break gap stays covered. */
    .resume-item {
        page-break-inside: avoid;
        break-inside: avoid;
        display: block;
    }
    .resume-section-title {
        page-break-after: avoid;
        break-after: avoid;
    }
    .resume-item-header {
        page-break-after: avoid;
        break-after: avoid;
    }
    .resume-skills-list, .resume-references-grid {
        page-break-inside: avoid;
        break-inside: avoid;
    }

    /* Resume Container Sizing (Export vs Preview) */
    @if (Model.IsExport)
    {
        <text>
        /* Uniform page margins on EVERY page (top spacing on continuation pages,
           consistent single-column spacing). Left/right = 0 so full-bleed designs
           reach the side edges; each template owns its horizontal padding. Chromium
           paints body/root backgrounds across the whole sheet (incl. these margins),
           so full-height sidebars stay edge-to-edge. */
        @@page { size: A4; margin: 14mm 0; }

        .resume-container {
            width: 100%;
            max-width: 100%;
            margin: 0;
            box-sizing: border-box;
        }
        </text>
    }
    else
    {
        <text>
        .resume-container {
            margin: 0 auto;
            background: #fff;
            box-sizing: border-box;
            /* Box shadows and padding differ by template */
        }
        </text>
    }
</style>

<script>
    // Universal listener for real-time color updates in the Preview Editor
    window.addEventListener('message', function (e) {
        if (e.data && e.data.type === 'applyColors') {
            var root = document.documentElement;
            Object.entries(e.data.colors).forEach(function (entry) {
                root.style.setProperty(entry[0], entry[1]);
            });
        }
        if (e.data && e.data.type === 'reorderSections') {
            const mainContainer = document.querySelector('.main-content') || document.querySelector('.resume-container');
            const sidebarContainer = document.querySelector('.sidebar');
            
            if (e.data.isMultiColumn && sidebarContainer && mainContainer) {
                e.data.sidebar.forEach(id => {
                    const el = document.querySelector(`[data-section-id="${id}"]`);
                    if (el) sidebarContainer.appendChild(el);
                });
                e.data.main.forEach(id => {
                    const el = document.querySelector(`[data-section-id="${id}"]`);
                    if (el) mainContainer.appendChild(el);
                });
            } else if (mainContainer) {
                e.data.main.forEach(id => {
                    const el = document.querySelector(`[data-section-id="${id}"]`);
                    if (el) mainContainer.appendChild(el);
                });
            }
        }
    });
</script>
