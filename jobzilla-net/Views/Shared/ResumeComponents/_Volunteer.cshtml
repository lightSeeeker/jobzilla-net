@using jobzilla_net.Application.Resumes.Dtos
@model ResumeSection
@{
    string FormatDate(string? val, string fmt = "MMM yyyy")
    {
        if (string.IsNullOrWhiteSpace(val)) return "";
        if (DateTime.TryParse(val, out var d)) return d.ToString(fmt);
        return val;
    }
}
@foreach (var item in Model.Items.OrderBy(i => i.DisplayOrder))
{
    var org = item.GetValue("Organization");
    var role = item.GetValue("Role");
    var sd = FormatDate(item.GetValue("StartDate"));
    var ed = FormatDate(item.GetValue("EndDate"));
    var desc = item.GetValue("Description")?.Replace("<", "&lt;").Replace(">", "&gt;");
    var range = string.IsNullOrWhiteSpace(sd) && string.IsNullOrWhiteSpace(ed) ? "" : $"{sd} – {ed}";
    if (string.IsNullOrWhiteSpace(org) && string.IsNullOrWhiteSpace(role)) { continue; }
    <div class="resume-item">
        <div class="resume-item-header">
            <span class="resume-item-title">@(string.IsNullOrWhiteSpace(org) ? role : org)</span>
            @if (!string.IsNullOrWhiteSpace(range))
            {
                <span class="resume-item-date">@range</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(org) && !string.IsNullOrWhiteSpace(role))
        {
            <div class="resume-item-subtitle">@role</div>
        }
        @if (!string.IsNullOrWhiteSpace(desc))
        {
            <div class="resume-item-desc">@Html.Raw(desc.Replace("\n", "<br/>"))</div>
        }
    </div>
}
