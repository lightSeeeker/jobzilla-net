@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@{
    Layout = null;
    var sections = Model.GetUnifiedSections();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.HeaderName - ATS Minimal</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
        :root {
            --atsm-accent: #000000;
        }
        .resume-container {
            font-family: var(--cvb-base-font);
            color: #111;
            line-height: var(--cvb-line-height);
            background-color: #fff;
            @if (Model.IsExport) { <text>padding: 0 48px;</text> } else { <text>padding: 48px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); max-width: 850px; margin: 40px auto; min-height: 1100px;</text> }
        }
        .header { text-align: center; margin-bottom: 22px; }
        .name { font-size: 26px; font-weight: 700; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 1px; color: var(--atsm-accent); }
        .role { font-size: 15px; color: #333; margin-bottom: 8px; }
        .contact-info { font-size: 13px; color: #222; }
        .contact-info span { margin: 0 4px; }

        .resume-section-title {
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            border-bottom: 1px solid var(--atsm-accent);
            color: var(--atsm-accent);
            padding-bottom: 3px;
            margin-bottom: var(--cvb-item-margin);
            margin-top: var(--cvb-section-margin);
        }
        .resume-item { margin-bottom: var(--cvb-item-margin); }
        .resume-item-header { display: flex; justify-content: space-between; align-items: baseline; }
        .resume-item-title { font-weight: 700; font-size: 14px; }
        .resume-item-date { font-size: 13px; color: #333; text-align: right; }
        .resume-item-subtitle { font-size: 13px; font-style: italic; margin-bottom: 4px; color: #333; }
        .resume-item-desc { font-size: 13px; text-align: left; }
        .resume-item-field { font-size: 13px; margin-bottom: 2px; }
        .resume-field-label { font-weight: 700; margin-right: 5px; }
        .resume-link { color: #111; text-decoration: none; }

        .resume-skills-list { display: block; font-size: 13px; }
        .resume-skill-tag { display: inline; margin-right: 4px; font-weight: normal; }
        .resume-skill-tag::after { content: ","; }
        .resume-skill-tag:last-child::after { content: ""; }

        .resume-references-grid { display: block; }
        .resume-reference-item { margin-bottom: 10px; font-size: 13px; }
        @if (Model.IsExport)
        {
            <text>
            /* SelectPdf: no flex — item header via table. */
            .resume-item-header { display: table; width: 100%; }
            .resume-item-header > .resume-item-title { display: table-cell; }
            .resume-item-header > .resume-item-date  { display: table-cell; text-align: right; white-space: nowrap; padding-left: 12px; }
            </text>
        }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>
    <div class="resume-container">
        <div class="header">
            <h1 class="name">@Model.HeaderName</h1>
            @if (!string.IsNullOrWhiteSpace(Model.HeaderTitle))
            {
                <div class="role">@Model.HeaderTitle</div>
            }
            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.HeaderEmail)) { <span>@Model.HeaderEmail</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderPhone)) { <span>| @Model.HeaderPhone</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderLocation)) { <span>| @Model.HeaderLocation</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderLinkedIn)) { <span>| @Model.HeaderLinkedIn</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderWebsite)) { <span>| @Model.HeaderWebsite</span> }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.HeaderSummary))
        {
            <div class="resume-section-title" style="margin-top: 0;">Summary</div>
            <div class="resume-item-desc" style="margin-bottom: 18px;">
                @Html.Raw(Model.HeaderSummary.Replace("\n", "<br/>"))
            </div>
        }

        @foreach (var sec in sections.Where(s => s.IsVisible))
        {
            <div class="cvb-section-wrapper" data-section-id="@sec.Id">
                <div class="resume-section-title">@sec.Title</div>
                @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_SectionBody.cshtml", sec)
            </div>
        }
    </div>
</body>
</html>
