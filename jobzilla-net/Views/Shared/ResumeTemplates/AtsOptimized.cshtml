@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@{
    Layout = null;
    var sections = Model.GetUnifiedSections();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Profile?.FullName ?? "Resume") - ATS Optimized</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
        :root {
            --ats-primary: #000000;
        }
        .resume-container {
            font-family: Arial, Helvetica, sans-serif;
            color: #111;
            line-height: 1.5;
            background-color: #fff;
            padding: 40px;
            @if (!Model.IsExport) { <text>box-shadow: 0 4px 15px rgba(0,0,0,0.1); max-width: 850px; margin: 40px auto; min-height: 1100px;</text> }
        }
        
        .header {
            text-align: center;
            margin-bottom: 25px;
        }
        .name { font-size: 24px; font-weight: bold; margin: 0 0 5px; text-transform: uppercase; color: var(--ats-primary); }
        .contact-info { font-size: 14px; margin-bottom: 15px; }
        .contact-info span { margin: 0 5px; }
        
        .resume-section-title {
            font-size: 16px;
            text-transform: uppercase;
            font-weight: bold;
            border-bottom: 1px solid var(--ats-primary);
            color: var(--ats-primary);
            padding-bottom: 3px;
            margin-bottom: 15px;
            margin-top: 20px;
        }
        
        .resume-item { margin-bottom: 15px; }
        .resume-item-header { display: flex; justify-content: space-between; align-items: baseline; }
        .resume-item-title { font-weight: bold; font-size: 15px; }
        .resume-item-date { font-size: 14px; text-align: right; }
        .resume-item-subtitle { font-size: 14px; font-style: italic; margin-bottom: 5px; }
        .resume-item-desc { font-size: 14px; text-align: left; }
        
        .resume-skills-list { display: block; font-size: 14px; }
        .resume-skill-tag { display: inline; margin-right: 10px; font-weight: normal; }
        .resume-skill-tag::after { content: ","; }
        .resume-skill-tag:last-child::after { content: ""; }
        
        .resume-references-grid { display: block; }
        .resume-reference-item { margin-bottom: 10px; font-size: 14px; }
        
        .resume-custom-item { margin-bottom: 15px; font-size: 14px; }
        .resume-item-field { margin-bottom: 2px; }
        .resume-field-label { font-weight: bold; margin-right: 5px; }
        
        .action-bar { text-align: center; margin-bottom: 20px; padding: 20px; background: #f0f0f0; }
        .btn { padding: 10px 20px; background: var(--ats-primary); color: white; text-decoration: none; display: inline-block; cursor: pointer; border: none; font-family: sans-serif; }
        .btn-secondary { background: #555; }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>
    @if (!Model.IsExport)
    {
        <div class="action-bar d-print-none">
            @* <a href="/CandidateDash/Templates" class="btn btn-secondary">Back to Templates</a> *@
            @if (Model.TemplateId.HasValue)
            {
                <a href="/CandidateDash/ExportTemplate?id=@Model.TemplateId&resumeId=@Model.ResumeId" class="btn">Download as PDF</a>
            }
        </div>
    }

    <div class="resume-container">
        <div class="header">
            <h1 class="name">@(Model.Profile?.FullName ?? "Your Name")</h1>
            
            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Email)) { <span>@Model.Profile.Email</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber)) { <span>| @Model.Profile.PhoneNumber</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Location)) { <span>| @Model.Profile.Location</span> }
            </div>
            
            @if (Model.SocialLinks != null && Model.SocialLinks.Any())
            {
                <div class="contact-info">
                @foreach(var link in Model.SocialLinks)
                {
                    <span>| @link.Url</span>
                }
                </div>
            }
        </div>
        
        @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
        {
            <div class="resume-section-title" style="margin-top: 0;">Summary</div>
            <div class="resume-item-desc" style="margin-bottom: 20px;">
                @Html.Raw(Model.Profile.Summary.Replace("\n", "<br/>"))
            </div>
        }
        
        @foreach (var sec in sections.Where(s => s.IsVisible))
        {
            <div class="resume-section-title">@sec.Title</div>
            @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
        }
    </div>
<script>
    window.addEventListener('message', function (e) {
        if (e.data && e.data.type === 'applyColors') {
            var root = document.documentElement;
            Object.entries(e.data.colors).forEach(function (entry) {
                root.style.setProperty(entry[0], entry[1]);
            });
        }
    });
</script>
</body>
</html>
