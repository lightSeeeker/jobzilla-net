@using jobzilla_net.Application.Resumes.Dtos
@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;
    var sections = Model.GetUnifiedSections().ToList();
    var sidebarSections = sections.Where(s => s.IsVisible && (s.ColumnPlacement == "Sidebar"
        || (string.IsNullOrEmpty(s.ColumnPlacement) && (s.SectionType == ResumeBuilderSectionType.Skills || s.SectionType == ResumeBuilderSectionType.Languages)))).ToList();
    var mainSections = sections.Where(s => s.IsVisible && !sidebarSections.Contains(s)).ToList();
    var imgSrc = Model.GetProfileImageDataUri(WebHostEnvironment.WebRootPath);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.HeaderName - Classic Two Column</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
        :root {
            --c2-accent: #2e6da4;
            --c2-sidebar-bg: #f4f6f8;
        }
        .resume-container {
            font-family: var(--cvb-base-font);
            color: #2c2c2c;
            line-height: var(--cvb-line-height);
            box-sizing: border-box;
            display: flex;
            align-items: stretch;
            min-height: 297mm;
            @if (!Model.IsExport)
            {
                <text>
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                max-width: 850px;
                margin: 40px auto;
                </text>
            }
        }
        .sidebar {
            width: 32%;
            box-sizing: border-box;
            background-color: var(--c2-sidebar-bg);
            @if (Model.IsExport) { <text>padding: 24px 24px;</text> } else { <text>padding: 36px 24px;</text> }
        }
        .main-content {
            width: 68%;
            box-sizing: border-box;
            background: #fff;
            @if (Model.IsExport) { <text>padding: 24px 32px;</text> } else { <text>padding: 36px 32px;</text> }
        }
        .photo-wrap { text-align: center; margin-bottom: 18px; }
        .photo {
            display: inline-block; width: 128px; height: 128px;
            background-size: cover; background-position: center;
            border-radius: 50%; border: 3px solid var(--c2-accent);
        }
        .name { font-size: 22px; font-weight: 700; margin: 0 0 4px; color: #1a1a1a; line-height: 1.15; }
        .role { font-size: 13.5px; color: var(--c2-accent); font-weight: 600; margin-bottom: 18px; }
        .contact-item { font-size: 12px; margin-bottom: 8px; color: #444; word-break: break-word; }

        .resume-section-title {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 700;
            color: var(--c2-accent);
            border-bottom: 2px solid var(--c2-accent);
            padding-bottom: 4px;
            margin-bottom: var(--cvb-item-margin);
            margin-top: var(--cvb-section-margin);
        }
        .sidebar .resume-section-title { margin-top: 24px; }

        .resume-item { margin-bottom: var(--cvb-item-margin); }
        .resume-item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 3px; }
        .resume-item-title { font-weight: 700; color: #1c1c1c; font-size: 14px; }
        .resume-item-date { font-size: 12px; color: #777; text-align: right; }
        .resume-item-subtitle { font-size: 12.5px; color: #555; margin-bottom: 5px; font-weight: 600; }
        .resume-item-desc { font-size: 12.5px; color: #3a3a3a; }
        .resume-item-field { font-size: 12.5px; margin-bottom: 3px; }
        .resume-field-label { font-weight: 600; color: var(--c2-accent); margin-right: 5px; }
        .resume-link { color: var(--c2-accent); text-decoration: none; }

        /* Sidebar stacks title/date and uses smaller type. */
        .sidebar .resume-item-header { display: block; }
        .sidebar .resume-item-date { text-align: left; }
        .sidebar .resume-item, .sidebar .resume-item-title, .sidebar .resume-item-desc { font-size: 12px; }

        .resume-skills-list { display: flex; flex-wrap: wrap; margin-top: 6px; }
        .resume-skill-tag {
            background: var(--c2-accent); color: #fff; padding: 3px 9px; border-radius: 3px;
            font-size: 11.5px; margin: 0 6px 6px 0;
        }
        .resume-references-grid { display: block; }
        .resume-reference-item { margin-bottom: 12px; font-size: 12.5px; }

        @if (Model.IsExport)
        {
            <text>
            /* SelectPdf: no flex — two columns via fixed table, item header via table.
               Sidebar tint painted on the cell; light tint keeps the top/bottom page-margin
               bands (which the cell can't reach) visually unobtrusive. */
            .resume-container { display: table; width: 100%; table-layout: fixed; }
            .sidebar      { display: table-cell; vertical-align: top; width: 32%; background-color: var(--c2-sidebar-bg); }
            .main-content { display: table-cell; vertical-align: top; width: 68%; background: #fff; }
            .main-content .resume-item-header { display: table; width: 100%; }
            .main-content .resume-item-header > .resume-item-title { display: table-cell; }
            .main-content .resume-item-header > .resume-item-date  { display: table-cell; text-align: right; white-space: nowrap; padding-left: 12px; }
            .resume-skills-list { display: block; }
            .resume-skill-tag   { display: inline-block; }
            </text>
        }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>
    <div class="resume-container">
        <!-- SIDEBAR -->
        <div class="sidebar">
            @if (!string.IsNullOrEmpty(imgSrc))
            {
                <div class="photo-wrap">
                    <div class="photo" style="background-image: url('@imgSrc');"></div>
                </div>
            }
            <h1 class="name">@Model.HeaderName</h1>
            @if (!string.IsNullOrWhiteSpace(Model.HeaderTitle))
            {
                <div class="role">@Model.HeaderTitle</div>
            }
            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.HeaderEmail)) { <div class="contact-item">@Model.HeaderEmail</div> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderPhone)) { <div class="contact-item">@Model.HeaderPhone</div> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderLocation)) { <div class="contact-item">@Model.HeaderLocation</div> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderLinkedIn)) { <div class="contact-item">@Model.HeaderLinkedIn</div> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderWebsite)) { <div class="contact-item">@Model.HeaderWebsite</div> }
            </div>
            @foreach (var sec in sidebarSections)
            {
                <div class="cvb-section-wrapper" data-section-id="@sec.Id">
                    <div class="resume-section-title">@sec.Title</div>
                    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_SectionBody.cshtml", sec)
                </div>
            }
        </div>
        <!-- MAIN -->
        <div class="main-content">
            @if (!string.IsNullOrWhiteSpace(Model.HeaderSummary))
            {
                <div class="cvb-section-wrapper">
                    <div class="resume-section-title" style="margin-top: 0;">Profile</div>
                    <div class="resume-item-desc" style="margin-bottom: 18px;">
                        @Html.Raw(Model.HeaderSummary.Replace("\n", "<br/>"))
                    </div>
                </div>
            }
            @foreach (var sec in mainSections)
            {
                <div class="cvb-section-wrapper" data-section-id="@sec.Id">
                    <div class="resume-section-title">@sec.Title</div>
                    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_SectionBody.cshtml", sec)
                </div>
            }
        </div>
    </div>
</body>
</html>
