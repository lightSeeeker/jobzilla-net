@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;
    var sections = Model.GetUnifiedSections();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Profile?.FullName ?? "Resume") - Executive Corporate</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
        :root {
            --ec-primary: #111111;
            --ec-accent:  #444444;
        }
        .resume-container {
            font-family: 'Times New Roman', Times, serif;
            color: #111;
            line-height: 1.5;
            flex-direction: column;
            @if (!Model.IsExport) { <text>box-shadow: 0 4px 15px rgba(0,0,0,0.1); max-width: 850px; margin: 40px auto; min-height: 1100px;</text> }
        }
        .header {
            text-align: center;
            padding: 50px 40px 30px;
            border-bottom: 2px solid var(--ec-primary);
            margin-bottom: 30px;
        }
        .name { font-size: 2.5em; font-weight: bold; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 2px; color: var(--ec-primary); }
        .title { font-size: 1.2em; color: var(--ec-accent); margin-bottom: 20px; font-style: italic; }
        .contact-info { display: flex; justify-content: center; flex-wrap: wrap; gap: 20px; font-size: 0.9em; font-family: Arial, sans-serif; color: var(--ec-accent); }
        
        .main-content {
            padding: 0 50px 50px;
            font-family: Arial, sans-serif;
        }
        
        .resume-section-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: 1.4em;
            text-transform: uppercase;
            color: var(--ec-primary);
            border-bottom: 1px solid #999;
            padding-bottom: 5px;
            margin-bottom: 20px;
            margin-top: 30px;
            font-weight: bold;
        }
        
        .resume-item { margin-bottom: 20px; }
        .resume-item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
        .resume-item-title { font-weight: bold; color: var(--ec-primary); font-size: 1.1em; }
        .resume-item-date { font-size: 0.9em; color: var(--ec-primary); text-align: right; }
        .resume-item-subtitle { font-size: 1em; color: #333; margin-bottom: 8px; font-style: italic; }
        .resume-item-desc { font-size: 0.95em; color: #333; text-align: justify; }
        
        .resume-skills-list { display: flex; flex-wrap: wrap; gap: 15px; margin-top: 10px; }
        .resume-skill-tag { font-size: 0.95em; font-weight: bold; color: var(--ec-primary); }
        
        .resume-references-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .resume-reference-item { margin-bottom: 0; }
        
        .resume-custom-item { margin-bottom: 15px; }
        .resume-item-field { margin-bottom: 4px; font-size: 0.95em; }
        .resume-field-label { font-weight: bold; color: var(--ec-primary); margin-right: 5px; }
        
        .action-bar { text-align: center; margin-bottom: 20px; padding: 20px; background: #fff; font-family: Arial, sans-serif; }
        .btn { padding: 10px 20px; background: var(--ec-primary); color: white; text-decoration: none; border-radius: 0; margin: 0 5px; display: inline-block; cursor: pointer; border: none; }
        .btn-secondary { background: #555; }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>
    @if (!Model.IsExport)
    {
        <div class="action-bar d-print-none">
            @* <a href="/CandidateDash/Templates" class="btn btn-secondary">Back to Templates</a> *@
            @if (Model.TemplateId.HasValue)
            {
                <a href="/CandidateDash/ExportTemplate?id=@Model.TemplateId&resumeId=@Model.ResumeId" class="btn">Download as PDF</a>
            }
        </div>
    }

    <div class="resume-container">
        <div class="header">
            @{
                var imgSrc = Model.GetProfileImageDataUri(WebHostEnvironment.WebRootPath);
            }
            @if (!string.IsNullOrEmpty(imgSrc))
            {
                <div style="text-align: center; margin-bottom: 15px;">
                    <img src="@imgSrc" alt="Profile Picture" style="width: 120px; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #111;" />
                </div>
            }
            <h1 class="name">@(Model.Profile?.FullName ?? "Your Name")</h1>
            <div class="title">@(Model.Profile?.ProfessionalTitle ?? "Professional Title")</div>
            
            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Email)) { <span>@Model.Profile.Email</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber)) { <span>@Model.Profile.PhoneNumber</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Location)) { <span>@Model.Profile.Location</span> }
            </div>
        </div>
        
        <div class="main-content">
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
            {
                <div class="resume-section-title" style="margin-top: 0;">Executive Summary</div>
                <div class="resume-item-desc" style="margin-bottom: 30px;">
                    @Html.Raw(Model.Profile.Summary.Replace("\n", "<br/>"))
                </div>
            }
            
            @foreach (var sec in sections.Where(s => s.IsVisible))
            {
                <div class="resume-section-title">@sec.Title</div>
                @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
            }
        </div>
    </div>
<script>
    window.addEventListener('message', function (e) {
        if (e.data && e.data.type === 'applyColors') {
            var root = document.documentElement;
            Object.entries(e.data.colors).forEach(function (entry) {
                root.style.setProperty(entry[0], entry[1]);
            });
        }
    });
</script>
</body>
</html>
