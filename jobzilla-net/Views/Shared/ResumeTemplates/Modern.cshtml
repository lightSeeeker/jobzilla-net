@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@{
    Layout = null; 
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Profile?.FullName - Modern Resume</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #444;
            margin: 0;
            padding: 40px;
            background-color: #e9ecef;
        }
        .resume-container {
            max-width: 850px;
            margin: 0 auto;
            background: #fff;
            display: flex;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 8px;
            overflow: hidden;
        }
        .sidebar {
            width: 35%;
            background: #2c3e50;
            color: #ecf0f1;
            padding: 40px 30px;
        }
        .main-content {
            width: 65%;
            padding: 40px 40px;
        }
        .name {
            font-size: 2.2em;
            font-weight: bold;
            margin: 0 0 5px;
            color: #fff;
            text-transform: uppercase;
        }
        .title {
            font-size: 1.1em;
            color: #1abc9c;
            margin-bottom: 30px;
        }
        .contact-item {
            margin-bottom: 10px;
            font-size: 0.9em;
        }
        .section-title-sidebar {
            font-size: 1.2em;
            text-transform: uppercase;
            border-bottom: 2px solid #1abc9c;
            padding-bottom: 5px;
            margin: 30px 0 15px;
        }
        .section-title-main {
            font-size: 1.4em;
            text-transform: uppercase;
            color: #2c3e50;
            border-bottom: 2px solid #ecf0f1;
            padding-bottom: 5px;
            margin-bottom: 20px;
        }
        .item {
            margin-bottom: 20px;
        }
        .item-title {
            font-weight: bold;
            color: #34495e;
            font-size: 1.1em;
        }
        .item-subtitle {
            color: #7f8c8d;
            font-size: 0.95em;
            margin-bottom: 5px;
        }
        .item-desc {
            font-size: 0.9em;
            line-height: 1.5;
        }
        .action-bar {
            text-align: center;
            margin-bottom: 20px;
        }
        .btn {
            padding: 10px 20px;
            background: #1abc9c;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-family: sans-serif;
            border: none;
            cursor: pointer;
        }
        .btn-secondary {
            background: #95a5a6;
        }
    </style>
</head>
<body>

    <div class="action-bar d-print-none">
        <a href="/CandidateDash/Templates" class="btn btn-secondary">Back to Templates</a>
        @if (ViewBag.TemplateId != null)
        {
            <a href="/CandidateDash/ExportTemplate?id=@ViewBag.TemplateId" class="btn">Download as PDF</a>
        }
    </div>

    <div class="resume-container">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h1 class="name">@(Model.Profile?.FullName ?? "Your Name")</h1>
            <div class="title">@(Model.Profile?.ProfessionalTitle ?? "Professional Title")</div>

            <div class="section-title-sidebar">Contact</div>
            <div class="contact-item">Email: @(Model.Profile?.Email)</div>
            <div class="contact-item">Phone: @(Model.Profile?.PhoneNumber)</div>
            <div class="contact-item">Location: @(Model.Profile?.Location)</div>

            @if (Model.SocialLinks.Any())
            {
                <div class="section-title-sidebar">Social</div>
                @foreach (var link in Model.SocialLinks)
                {
                    <div class="contact-item">@link.PlatformName: @link.Url</div>
                }
            }

            @if (Model.Certifications.Any())
            {
                <div class="section-title-sidebar">Certifications</div>
                @foreach (var cert in Model.Certifications)
                {
                    <div class="contact-item">
                        <strong>@cert.Name</strong><br/>
                        <small>@cert.IssuingOrganization (@(cert.IssueDate.ToString("yyyy")))</small>
                    </div>
                }
            }
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
            {
                <div class="section-title-main">Profile Summary</div>
                <div class="item-desc" style="margin-bottom: 30px;">
                    @Model.Profile.Summary
                </div>
            }

            @if (Model.Experiences.Any())
            {
                <div class="section-title-main">Experience</div>
                @foreach (var exp in Model.Experiences.OrderByDescending(e => e.StartDate))
                {
                    <div class="item">
                        <div class="item-title">@exp.JobTitle</div>
                        <div class="item-subtitle">
                            @exp.CompanyName | @exp.StartDate.ToString("MMM yyyy") - @(exp.EndDate?.ToString("MMM yyyy") ?? "Present")
                        </div>
                        <div class="item-desc">@exp.Description</div>
                    </div>
                }
            }

            @if (Model.Educations.Any())
            {
                <div class="section-title-main">Education</div>
                @foreach (var edu in Model.Educations.OrderByDescending(e => e.StartDate))
                {
                    <div class="item">
                        <div class="item-title">@edu.Degree in @edu.FieldOfStudy</div>
                        <div class="item-subtitle">
                            @edu.InstitutionName | @edu.StartDate.ToString("yyyy") - @(edu.EndDate?.ToString("yyyy") ?? "Present")
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</body>
</html>
