@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@{
    Layout = null;
    var sections = Model.GetUnifiedSections();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.HeaderName - Modern</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
        :root {
            --ma-accent: #16a085;
        }
        .resume-container {
            font-family: var(--cvb-base-font);
            color: #2c2c2c;
            line-height: var(--cvb-line-height);
            background-color: #fff;
            @if (Model.IsExport) { <text>padding: 0 44px;</text> } else { <text>padding: 44px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); max-width: 850px; margin: 40px auto; min-height: 1100px;</text> }
        }
        .header { border-bottom: 3px solid var(--ma-accent); padding-bottom: 14px; margin-bottom: 22px; }
        .name { font-size: 32px; font-weight: 700; margin: 0 0 4px; color: #1a1a1a; letter-spacing: 0.5px; }
        .role { font-size: 16px; color: var(--ma-accent); font-weight: 600; margin-bottom: 10px; }
        .contact-info { font-size: 12.5px; color: #555; }
        .contact-info span { margin-right: 4px; }

        .resume-section-title {
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            color: var(--ma-accent);
            padding-bottom: 3px;
            margin-bottom: var(--cvb-item-margin);
            margin-top: var(--cvb-section-margin);
        }
        .resume-item {
            margin-bottom: var(--cvb-item-margin);
            border-left: 2px solid #e5e5e5;
            padding-left: 14px;
        }
        .resume-item-header { display: flex; justify-content: space-between; align-items: baseline; }
        .resume-item-title { font-weight: 700; font-size: 14.5px; color: #1c1c1c; }
        .resume-item-date { font-size: 12.5px; color: #777; text-align: right; }
        .resume-item-subtitle { font-size: 13px; color: #555; margin-bottom: 5px; font-weight: 600; }
        .resume-item-desc { font-size: 13px; color: #3a3a3a; }
        .resume-item-field { font-size: 13px; margin-bottom: 3px; }
        .resume-field-label { font-weight: 600; color: var(--ma-accent); margin-right: 5px; }
        .resume-link { color: var(--ma-accent); text-decoration: none; }

        .resume-skills-list { display: block; padding-left: 14px; }
        .resume-skill-tag { display: inline-block; border: 1px solid var(--ma-accent); color: var(--ma-accent); padding: 3px 10px; border-radius: 12px; font-size: 12px; margin: 0 6px 6px 0; }

        .resume-references-grid { display: block; }
        .resume-reference-item { display: inline-block; width: 48%; vertical-align: top; margin: 0 1% 12px 0; box-sizing: border-box; font-size: 13px; padding-left: 14px; }
        @if (Model.IsExport)
        {
            <text>
            /* Top margin on every page. NOTE: SelectPdf ignores @@page — this only takes
               effect in engines that honour it (browser print / Chromium). */
            @@page { margin-top: 14mm; }
            .resume-item-header { display: table; width: 100%; }
            .resume-item-header > .resume-item-title { display: table-cell; }
            .resume-item-header > .resume-item-date  { display: table-cell; text-align: right; white-space: nowrap; padding-left: 12px; }
            .resume-skill-tag { display: inline-block; }
            </text>
        }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>
    <div class="resume-container">
        <div class="header">
            <h1 class="name">@Model.HeaderName</h1>
            @if (!string.IsNullOrWhiteSpace(Model.HeaderTitle))
            {
                <div class="role">@Model.HeaderTitle</div>
            }
            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.HeaderEmail)) { <span>@Model.HeaderEmail</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderPhone)) { <span>&nbsp;•&nbsp; @Model.HeaderPhone</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderLocation)) { <span>&nbsp;•&nbsp; @Model.HeaderLocation</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderLinkedIn)) { <span>&nbsp;•&nbsp; @Model.HeaderLinkedIn</span> }
                @if (!string.IsNullOrWhiteSpace(Model.HeaderGitHub)) { <span>&nbsp;•&nbsp; @Model.HeaderGitHub</span> }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.HeaderSummary))
        {
            <div class="resume-section-title" style="margin-top: 0;">About</div>
            <div class="resume-item-desc" style="margin-bottom: 18px; border-left: 2px solid #e5e5e5; padding-left: 14px;">
                @Html.Raw(Model.HeaderSummary.Replace("\n", "<br/>"))
            </div>
        }

        @foreach (var sec in sections.Where(s => s.IsVisible))
        {
            <div class="cvb-section-wrapper" data-section-id="@sec.Id">
                <div class="resume-section-title">@sec.Title</div>
                @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_SectionBody.cshtml", sec)
            </div>
        }
    </div>
</body>
</html>
