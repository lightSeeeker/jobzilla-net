@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;
    var sections = Model.GetUnifiedSections().ToList();
    var sidebarSections = sections.Where(s => s.IsVisible && (s.ColumnPlacement == "Sidebar" || (string.IsNullOrEmpty(s.ColumnPlacement) && s.SectionType.ToString() == "Skills"))).ToList();
    var mainSections = sections.Where(s => s.IsVisible && !sidebarSections.Contains(s)).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Profile?.FullName ?? "Resume") - Modern Professional</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
            :root {
                --mp-sidebar-bg: #2b3a4a;
                --mp-accent: #48a9a6;
            }

            .resume-container {
                font-family: var(--cvb-base-font);
                color: #333;
                line-height: var(--cvb-line-height);
                box-sizing: border-box;
                display: flex;
                align-items: stretch;
                @if (!Model.IsExport)
                {
                    <text>
                    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                    border-radius: 8px;
                    max-width: 850px;
                    </text>
                }
            }

            @if (Model.IsExport)
            {
                <text>
                /* Full-height two-column background painted on the page canvas. Chromium
                   propagates a body/root background across the WHOLE sheet on every page
                   (including the page-margin area), so the dark sidebar column reaches all
                   four edges on every page — no gaps, no fixed-element hacks. */
                html, body {
                    background: linear-gradient(to right, var(--mp-sidebar-bg) 0%, var(--mp-sidebar-bg) 32%, #ffffff 32%, #ffffff 100%);
                }
                </text>
            }

            .sidebar {
                width: 32%;
                color: #fff;
                padding: 40px 30px;
                box-sizing: border-box;
                @if (Model.IsExport) { <text>background: transparent;</text> } else { <text>background: var(--mp-sidebar-bg);</text> }
            }

            .main-content {
                width: 68%;
                padding: 40px;
                box-sizing: border-box;
                @if (Model.IsExport) { <text>background: transparent;</text> } else { <text>background: #fff;</text> }
            }

            .name {
                font-size: 2.2em;
                font-weight: 700;
                margin: 0 0 5px;
                color: #fff;
                line-height: 1.1;
            }

            .title {
                font-size: 1.1em;
                color: var(--mp-accent);
                margin-bottom: 30px;
                font-weight: 500;
            }

            .contact-item {
                font-size: 0.9em;
                margin-bottom: 10px;
                color: #d0dbe5;
                word-break: break-word;
            }

            .resume-section-title {
                font-size: 1.3em;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--mp-sidebar-bg);
                border-bottom: 2px solid var(--mp-accent);
                padding-bottom: 5px;
                margin-bottom: var(--cvb-item-margin);
                margin-top: var(--cvb-section-margin);
                font-weight: 700;
            }

            .sidebar .resume-section-title {
                color: #fff;
                border-bottom: 2px solid var(--mp-accent);
                margin-top: 0;
                margin-bottom: var(--cvb-item-margin);
            }

            .resume-item {
                margin-bottom: var(--cvb-item-margin);
            }

            .resume-item-header {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 4px;
            }

            .resume-item-title {
                font-weight: 700;
                color: var(--mp-sidebar-bg);
                font-size: 1.05em;
            }

            .resume-item-date {
                font-size: 0.85em;
                color: #666;
                font-weight: 500;
                text-align: right;
                min-width: 120px;
            }

            .resume-item-subtitle {
                font-size: 0.95em;
                color: #555;
                margin-bottom: 6px;
                font-weight: 600;
            }

            .resume-item-desc {
                font-size: 0.9em;
                color: #444;
            }

            /* Sidebar Overrides for general sections */
            .sidebar .resume-item-title {
                color: #fff;
            }
            .sidebar .resume-item-date,
            .sidebar .resume-item-subtitle,
            .sidebar .resume-item-desc,
            .sidebar .resume-item-field,
            .sidebar .resume-field-label {
                color: #d0dbe5;
            }
            .sidebar .resume-item-header {
                display: block; /* Stack title and date in sidebar */
            }
            .sidebar .resume-item-date {
                text-align: left;
            }

            .resume-skills-list {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin-top: 10px;
            }

            .resume-skill-tag {
                background: var(--mp-accent);
                color: #fff;
                padding: 4px 10px;
                border-radius: 4px;
                font-size: 0.85em;
            }

            .resume-references-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 15px;
            }

            .resume-reference-item {
                margin-bottom: 0;
            }

            .resume-custom-item {
                margin-bottom: 15px;
            }

            .resume-item-field {
                margin-bottom: 4px;
                font-size: 0.9em;
            }

            .resume-field-label {
                font-weight: 600;
                color: var(--mp-sidebar-bg);
                margin-right: 5px;
            }

            .action-bar {
                text-align: center;
                margin-bottom: 20px;
                padding: 20px;
                background: #fff;
            }

            .btn {
                padding: 10px 20px;
                background: var(--mp-accent);
                color: white;
                text-decoration: none;
                border-radius: 5px;
                margin: 0 5px;
                font-weight: 600;
                display: inline-block;
                font-family: sans-serif;
                border: none;
                cursor: pointer;
            }

            .btn-secondary {
                background: #6c757d;
            }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>

    <div class="resume-container">
        <!-- SIDEBAR -->
        <div class="sidebar">
            @{
                var imgSrc = Model.GetProfileImageDataUri(WebHostEnvironment.WebRootPath);
            }
            @if (!string.IsNullOrEmpty(imgSrc))
            {
                <div style="text-align: center; margin-bottom: 20px;">
                    <img src="@imgSrc" alt="Profile Picture" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; border: 3px solid #48a9a6;" />
                </div>
            }
            <h1 class="name">@(Model.Profile?.FullName ?? "Your Name")</h1>
            <div class="title">@(Model.Profile?.ProfessionalTitle ?? "Professional Title")</div>

            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Email))
                {
                    <div class="contact-item">@Model.Profile.Email</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber))
                {
                    <div class="contact-item">@Model.Profile.PhoneNumber</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Location))
                {
                    <div class="contact-item">@Model.Profile.Location</div>
                }
            </div>

            @foreach (var sec in sidebarSections)
            {
                <div class="cvb-section-wrapper" data-section-id="@sec.Id">
                    <div class="resume-section-title">@sec.Title</div>
                    @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
                </div>
            }
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
            {
                <div class="resume-section-title" style="margin-top: 0;">Profile Summary</div>
                <div class="resume-item-desc" style="margin-bottom: 30px;">
                    @Html.Raw(Model.Profile.Summary.Replace("\n", "<br/>"))
                </div>
            }

            @foreach (var sec in mainSections)
            {
                <div class="cvb-section-wrapper" data-section-id="@sec.Id">
                    <div class="resume-section-title">@sec.Title</div>
                    @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
                </div>
            }
        </div>
    </div>

</body>
</html>