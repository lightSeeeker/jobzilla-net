@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;
    var sections = Model.GetUnifiedSections();
    var skillsSections = sections.Where(s => s.IsVisible && s.SectionType.ToString() == "Skills").ToList();
    var mainSections = sections.Where(s => s.IsVisible && s.SectionType.ToString() != "Skills").ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Profile?.FullName ?? "Resume") - Modern Professional</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
            :root {
                --mp-sidebar-bg: #2b3a4a;
                --mp-accent: #48a9a6;
            }

            .resume-container {
                display: flex; /* FIX: was missing, caused vertical stacking */
                align-items: stretch;
                font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                color: #333;
                line-height: 1.6;
                @if (!Model.IsExport)
                {
                    <text>box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                        border-radius: 8px;
                        max-width: 850px;
                    </text>
                }
            }

            .sidebar {
                width: 32%;
                background: var(--mp-sidebar-bg);
                color: #fff;
                padding: 40px 30px;
            }

            .main-content {
                width: 68%;
                padding: 40px;
                background: #fff;
            }

            .name {
                font-size: 2.2em;
                font-weight: 700;
                margin: 0 0 5px;
                color: #fff;
                line-height: 1.1;
            }

            .title {
                font-size: 1.1em;
                color: var(--mp-accent);
                margin-bottom: 30px;
                font-weight: 500;
            }

            .contact-item {
                font-size: 0.9em;
                margin-bottom: 10px;
                color: #d0dbe5;
                word-break: break-word;
            }

            .resume-section-title {
                font-size: 1.3em;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--mp-sidebar-bg);
                border-bottom: 2px solid var(--mp-accent);
                padding-bottom: 5px;
                margin-bottom: 20px;
                margin-top: 30px;
                font-weight: 700;
            }

            .sidebar .resume-section-title {
                color: #fff;
                border-bottom: 2px solid var(--mp-accent);
                margin-top: 0;
                margin-bottom: 15px;
            }

            .resume-item {
                margin-bottom: 20px;
            }

            .resume-item-header {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 4px;
            }

            .resume-item-title {
                font-weight: 700;
                color: var(--mp-sidebar-bg);
                font-size: 1.05em;
            }

            .resume-item-date {
                font-size: 0.85em;
                color: #666;
                font-weight: 500;
                text-align: right;
                min-width: 120px;
            }

            .resume-item-subtitle {
                font-size: 0.95em;
                color: #555;
                margin-bottom: 6px;
                font-weight: 600;
            }

            .resume-item-desc {
                font-size: 0.9em;
                color: #444;
            }

            .resume-skills-list {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin-top: 10px;
            }

            .resume-skill-tag {
                background: var(--mp-accent);
                color: #fff;
                padding: 4px 10px;
                border-radius: 4px;
                font-size: 0.85em;
            }

            .resume-references-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 15px;
            }

            .resume-reference-item {
                margin-bottom: 0;
            }

            .resume-custom-item {
                margin-bottom: 15px;
            }

            .resume-item-field {
                margin-bottom: 4px;
                font-size: 0.9em;
            }

            .resume-field-label {
                font-weight: 600;
                color: var(--mp-sidebar-bg);
                margin-right: 5px;
            }

            .action-bar {
                text-align: center;
                margin-bottom: 20px;
                padding: 20px;
                background: #fff;
            }

            .btn {
                padding: 10px 20px;
                background: var(--mp-accent);
                color: white;
                text-decoration: none;
                border-radius: 5px;
                margin: 0 5px;
                font-weight: 600;
                display: inline-block;
                font-family: sans-serif;
                border: none;
                cursor: pointer;
            }

            .btn-secondary {
                background: #6c757d;
            }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>
    @if (!Model.IsExport)
    {
        <div class="action-bar d-print-none">
            @* <a href="/CandidateDash/Templates" class="btn btn-secondary">Back to Templates</a> *@
            @if (Model.TemplateId.HasValue)
            {
                <a href="/CandidateDash/ExportTemplate?id=@Model.TemplateId&resumeId=@Model.ResumeId" class="btn">Download as PDF</a>
            }
        </div>
    }
    <div class="resume-container">
        <!-- SIDEBAR -->
        <div class="sidebar">
            @{
                var imgSrc = Model.GetProfileImageDataUri(WebHostEnvironment.WebRootPath);
            }
            @if (!string.IsNullOrEmpty(imgSrc))
            {
                <div style="text-align: center; margin-bottom: 20px;">
                    <img src="@imgSrc" alt="Profile Picture" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; border: 3px solid #48a9a6;" />
                </div>
            }
            <h1 class="name">@(Model.Profile?.FullName ?? "Your Name")</h1>
            <div class="title">@(Model.Profile?.ProfessionalTitle ?? "Professional Title")</div>

            <div class="resume-section-title" style="margin-top: 30px;">Contact</div>
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.Email))
            {
                <div class="contact-item">@Model.Profile.Email</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber))
            {
                <div class="contact-item">@Model.Profile.PhoneNumber</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.Location))
            {
                <div class="contact-item">@Model.Profile.Location</div>
            }

            @if (Model.SocialLinks != null && Model.SocialLinks.Any())
            {
                <div class="resume-section-title" style="margin-top: 30px;">Social Links</div>
                @foreach (var link in Model.SocialLinks)
                {
                    <div class="contact-item"><strong>@link.PlatformName</strong><br />@link.Url</div>
                }
            }
            @* Skills rendered in the sidebar *@
            @foreach (var sec in skillsSections)
            {
                <div class="resume-section-title" style="margin-top: 30px;">@sec.Title</div>
                @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
            }
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
            {
                <div class="resume-section-title" style="margin-top: 0;">Profile Summary</div>
                <div class="resume-item-desc" style="margin-bottom: 30px;">
                    @Html.Raw(Model.Profile.Summary.Replace("\n", "<br/>"))
                </div>
            }

            @foreach (var sec in mainSections)
            {
                <div class="resume-section-title">@sec.Title</div>
                @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
            }
        </div>
    </div>
    <script>
            // Real-time palette updates from the parent Templates page via postMessage
            window.addEventListener('message', function (e) {
                if (e.data && e.data.type === 'applyColors') {
                    var root = document.documentElement;
                    Object.entries(e.data.colors).forEach(function (entry) {
                        root.style.setProperty(entry[0], entry[1]);
                    });
                }
            });
    </script>
</body>
</html>