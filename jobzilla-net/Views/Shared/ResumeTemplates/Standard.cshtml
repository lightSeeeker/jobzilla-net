@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@using Microsoft.AspNetCore.Html
@{
    Layout = null;
    var doc = Model.Document;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(doc?.FullName ?? Model.Profile?.FullName ?? "Resume") - Resume</title>
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333; line-height: 1.6; margin: 0; padding: 40px; background: #f4f4f4; }
        .resume-container { max-width: 800px; margin: 0 auto; background: #fff; padding: 50px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .header { text-align: center; border-bottom: 2px solid #333; padding-bottom: 20px; margin-bottom: 20px; }
        .header h1 { margin: 0; font-size: 2.2em; text-transform: uppercase; letter-spacing: 2px; }
        .header h3 { margin: 5px 0 10px; font-weight: normal; color: #666; }
        .contact-info { font-size: .85em; color: #555; }
        .contact-info a { color: #555; text-decoration: none; }
        .rs { margin-bottom: 22px; }
        .rs-title { font-size: 1.05em; text-transform: uppercase; color: #222; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin-bottom: 12px; font-weight: 700; letter-spacing: .07em; }
        .item { margin-bottom: 14px; }
        .item-header { display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 3px; }
        .item-sub { font-style: italic; color: #555; margin-bottom: 4px; font-size: .9em; }
        .item-desc { font-size: .92em; white-space: pre-line; }
        .skills-list { display: flex; flex-wrap: wrap; gap: 8px; }
        .skill-tag { background: #f0f4f8; border: 1px solid #d1d5db; border-radius: 4px; padding: 3px 10px; font-size: .82em; }
        .action-bar { text-align: center; margin-bottom: 20px; }
        .btn { padding: 10px 20px; background: #007bff; color: white; text-decoration: none; border-radius: 5px; font-family: sans-serif; margin: 0 4px; }
        .btn-secondary { background: #6c757d; }
        .ref-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    </style>
</head>
<body>
    @if (!Model.IsExport)
    {
        <div class="action-bar d-print-none">
            <a href="/CandidateDash/Templates" class="btn btn-secondary">Back to Templates</a>
            @if (Model.TemplateId.HasValue)
            {
                <a href="/CandidateDash/ExportTemplate?id=@Model.TemplateId&resumeId=@Model.ResumeId" class="btn">Download as PDF</a>
            }
        </div>
    }

    <div class="resume-container">

        <!-- HEADER -->
        <div class="header">
            <h1>@(doc?.FullName ?? Model.Profile?.FullName ?? "Your Name")</h1>
            <h3>@(doc?.ProfessionalTitle ?? Model.Profile?.ProfessionalTitle)</h3>
            <div class="contact-info">
                @{
                    var parts = new System.Collections.Generic.List<string>();
                    var em = doc?.Email ?? Model.Profile?.Email;
                    var ph = doc?.Phone ?? Model.Profile?.PhoneNumber;
                    var lo = doc?.Location ?? Model.Profile?.Location;
                    if (!string.IsNullOrWhiteSpace(em)) parts.Add(em!);
                    if (!string.IsNullOrWhiteSpace(ph)) parts.Add(ph!);
                    if (!string.IsNullOrWhiteSpace(lo)) parts.Add(lo!);
                    if (!string.IsNullOrWhiteSpace(doc?.LinkedInUrl)) parts.Add($"<a href=\"{doc!.LinkedInUrl}\" target=\"_blank\">LinkedIn</a>");
                    if (!string.IsNullOrWhiteSpace(doc?.GitHubUrl))   parts.Add($"<a href=\"{doc!.GitHubUrl}\" target=\"_blank\">GitHub</a>");
                    if (!string.IsNullOrWhiteSpace(doc?.Website))     parts.Add($"<a href=\"{doc!.Website}\" target=\"_blank\">Portfolio</a>");
                }
                @Html.Raw(string.Join(" &nbsp;|&nbsp; ", parts))
            </div>
        </div>

        @if (doc != null)
        {
            @if (!string.IsNullOrWhiteSpace(doc.Summary))
            {
                <div class="rs"><div class="rs-title">Summary</div><div class="item-desc">@doc.Summary</div></div>
            }

            @foreach (var sec in doc.VisibleSections)
            {
                if (!sec.Items.Any()) { continue; }
                <div class="rs">
                    <div class="rs-title">@sec.Title</div>
                    @RenderSection(sec)
                </div>
            }
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
            {
                <div class="rs"><div class="rs-title">Professional Summary</div><div class="item-desc">@Model.Profile.Summary</div></div>
            }
            @if (Model.Experiences.Any())
            {
                <div class="rs"><div class="rs-title">Experience</div>
                @foreach (var exp in Model.Experiences.OrderByDescending(e => e.StartDate))
                {
                    <div class="item">
                        <div class="item-header"><span>@exp.JobTitle</span><span>@exp.StartDate.ToString("MMM yyyy") - @(exp.EndDate?.ToString("MMM yyyy") ?? "Present")</span></div>
                        <div class="item-sub">@exp.CompanyName @(!string.IsNullOrEmpty(exp.Location) ? $"| {exp.Location}" : "")</div>
                        <div class="item-desc">@exp.Description</div>
                    </div>
                }
                </div>
            }
            @if (Model.Educations.Any())
            {
                <div class="rs"><div class="rs-title">Education</div>
                @foreach (var edu in Model.Educations.OrderByDescending(e => e.StartDate))
                {
                    <div class="item">
                        <div class="item-header"><span>@edu.Degree in @edu.FieldOfStudy</span><span>@edu.StartDate.ToString("yyyy") - @(edu.EndDate?.ToString("yyyy") ?? "Present")</span></div>
                        <div class="item-sub">@edu.InstitutionName</div>
                    </div>
                }
                </div>
            }
            @if (Model.Certifications.Any())
            {
                <div class="rs"><div class="rs-title">Certifications</div>
                @foreach (var cert in Model.Certifications.OrderByDescending(c => c.IssueDate))
                {
                    <div class="item">
                        <div class="item-header"><span>@cert.Name</span><span>@cert.IssueDate.ToString("MMM yyyy")</span></div>
                        <div class="item-sub">@cert.IssuingOrganization</div>
                    </div>
                }
                </div>
            }
            @if (Model.Skills.Any())
            {
                <div class="rs"><div class="rs-title">Skills</div>
                <div class="skills-list">@foreach (var s in Model.Skills) { <span class="skill-tag">@s</span> }</div>
                </div>
            }
        }

    </div>
</body>
</html>

@functions {
    static string FormatDate(string? val, string fmt = "MMM yyyy")
    {
        if (string.IsNullOrWhiteSpace(val)) return "";
        if (DateTime.TryParse(val, out var d)) return d.ToString(fmt);
        return val;
    }

    IHtmlContent RenderSection(jobzilla_net.Application.Resumes.Dtos.ResumeSection sec)
    {
        var sb = new System.Text.StringBuilder();

        switch (sec.SectionType.ToString())
        {
            case "Experience":
                foreach (var item in sec.Items.OrderBy(i => i.DisplayOrder))
                {
                    var jt = item.GetValue("JobTitle");
                    var co = item.GetValue("CompanyName");
                    var lo = item.GetValue("Location");
                    var sd = FormatDate(item.GetValue("StartDate"));
                    var ed = item.GetValue("IsCurrent") == "true" ? "Present" : FormatDate(item.GetValue("EndDate"));
                    var de = item.GetValue("Description")?.Replace("<", "&lt;").Replace(">", "&gt;");
                    sb.Append($"<div class=\"item\"><div class=\"item-header\"><span>{co}</span><span>{sd} – {ed}</span></div>");
                    sb.Append($"<div class=\"item-sub\">{jt}{(!string.IsNullOrWhiteSpace(lo) ? " | " + lo : "")}</div>");
                    if (!string.IsNullOrWhiteSpace(de)) sb.Append($"<div class=\"item-desc\">{de}</div>");
                    sb.Append("</div>");
                }
                break;

            case "Education":
                foreach (var item in sec.Items.OrderBy(i => i.DisplayOrder))
                {
                    var inst  = item.GetValue("InstitutionName");
                    var deg   = item.GetValue("Degree");
                    var fld   = item.GetValue("FieldOfStudy");
                    var sd    = FormatDate(item.GetValue("StartDate"), "yyyy");
                    var ed    = item.GetValue("IsCurrent") == "true" ? "Present" : FormatDate(item.GetValue("EndDate"), "yyyy");
                    sb.Append($"<div class=\"item\"><div class=\"item-header\"><span>{deg}{(!string.IsNullOrWhiteSpace(fld) ? " in " + fld : "")}</span><span>{sd} – {ed}</span></div>");
                    sb.Append($"<div class=\"item-sub\">{inst}</div></div>");
                }
                break;

            case "Skills":
                sb.Append("<div class=\"skills-list\">");
                foreach (var item in sec.Items.OrderBy(i => i.DisplayOrder))
                {
                    var n = item.GetValue("Name");
                    if (!string.IsNullOrWhiteSpace(n)) sb.Append($"<span class=\"skill-tag\">{n}</span>");
                }
                sb.Append("</div>");
                break;

            case "Certifications":
                foreach (var item in sec.Items.OrderBy(i => i.DisplayOrder))
                {
                    var n   = item.GetValue("Name");
                    var org = item.GetValue("IssuingOrganization");
                    var dt  = FormatDate(item.GetValue("IssueDate"));
                    var url = item.GetValue("CredentialUrl");
                    sb.Append($"<div class=\"item\"><div class=\"item-header\"><span>{n}</span><span>{dt}</span></div>");
                    sb.Append($"<div class=\"item-sub\">{org}{(!string.IsNullOrWhiteSpace(url) ? $" — <a href=\"{url}\" target=\"_blank\">View</a>" : "")}</div></div>");
                }
                break;

            case "Projects":
                foreach (var item in sec.Items.OrderBy(i => i.DisplayOrder))
                {
                    var n    = item.GetValue("Name");
                    var pu   = item.GetValue("ProjectUrl");
                    var sd   = FormatDate(item.GetValue("StartDate"));
                    var ed2  = item.GetValue("IsOngoing") == "true" ? "Ongoing" : FormatDate(item.GetValue("EndDate"));
                    var de   = item.GetValue("Description")?.Replace("<", "&lt;");
                    sb.Append($"<div class=\"item\"><div class=\"item-header\">");
                    sb.Append($"<span>{n}{(!string.IsNullOrWhiteSpace(pu) ? $" — <a href=\"{pu}\" target=\"_blank\">Link</a>" : "")}</span>");
                    if (!string.IsNullOrWhiteSpace(sd)) sb.Append($"<span style=\"font-weight:normal;font-size:.88em;\">{sd} – {ed2}</span>");
                    sb.Append("</div>");
                    if (!string.IsNullOrWhiteSpace(de)) sb.Append($"<div class=\"item-desc\">{de}</div>");
                    sb.Append("</div>");
                }
                break;

            case "References":
                sb.Append("<div class=\"ref-grid\">");
                foreach (var item in sec.Items.OrderBy(i => i.DisplayOrder))
                {
                    var rn  = item.GetValue("ReferenceName");
                    var rc  = item.GetValue("Company");
                    var rr  = item.GetValue("Designation");
                    var rph = item.GetValue("Phone");
                    var rem = item.GetValue("Email");
                    sb.Append($"<div class=\"item\" style=\"margin-bottom:0;\"><div style=\"font-weight:700;\">{rn}</div>");
                    if (!string.IsNullOrWhiteSpace(rr)) sb.Append($"<div class=\"item-sub\" style=\"margin:0;\">{rr}{(!string.IsNullOrWhiteSpace(rc) ? " @ " + rc : "")}</div>");
                    if (!string.IsNullOrWhiteSpace(rph)) sb.Append($"<div style=\"font-size:.85em;\">{rph}</div>");
                    if (!string.IsNullOrWhiteSpace(rem)) sb.Append($"<div style=\"font-size:.85em;\">{rem}</div>");
                    sb.Append("</div>");
                }
                sb.Append("</div>");
                break;

            default:
                foreach (var item in sec.Items.OrderBy(i => i.DisplayOrder))
                {
                    var t  = item.GetValue("Title") ?? item.GetValue("Language") ?? item.GetValue("Name");
                    var d2 = item.GetValue("Description") ?? item.GetValue("Proficiency");
                    var dt = FormatDate(item.GetValue("Date") ?? item.GetValue("StartDate"));
                    sb.Append($"<div class=\"item\"><div class=\"item-header\"><span>{t}</span><span style=\"font-weight:normal;font-size:.88em;\">{dt}</span></div>");
                    if (!string.IsNullOrWhiteSpace(d2)) sb.Append($"<div class=\"item-desc\">{d2}</div>");
                    sb.Append("</div>");
                }
                break;
        }

        return new HtmlString(sb.ToString());
    }
}
