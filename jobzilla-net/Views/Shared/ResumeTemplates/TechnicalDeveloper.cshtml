@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;
    var sections = Model.GetUnifiedSections();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Profile?.FullName ?? "Resume") - Technical Developer</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
        :root {
            --td-bg:      #1e1e1e;
            --td-name:    #ce9178;
            --td-keyword: #569cd6;
            --td-fn:      #4ec9b0;
            --td-section: #c586c0;
        }
        .resume-container {
            font-family: var(--cvb-base-font);
            color: #ccc;
            line-height: var(--cvb-line-height);
            background-color: var(--td-bg);
            padding: 40px;
            @if (!Model.IsExport) { <text>box-shadow: 0 4px 15px rgba(0,0,0,0.3); border-radius: 4px; max-width: 850px; margin: 40px auto; min-height: 1100px;</text> }
        }
        @if (Model.IsExport)
        {
            <text>
            /* Dark theme fills every printed page edge-to-edge: a body/root background
               propagates to the full page canvas on every page in Chromium, so the last
               page's empty area stays dark instead of showing a white gap. */
            html, body { background-color: var(--td-bg); }
            </text>
        }
        .header {
            margin-bottom: 30px;
            border-bottom: 1px solid #555;
            padding-bottom: 20px;
        }
        .name { font-size: 2em; font-weight: bold; margin: 0 0 5px; color: var(--td-name); }
        .name::before { content: "const developer = \""; color: var(--td-keyword); font-weight: normal; font-size: 0.5em; }
        .name::after { content: "\";"; color: var(--td-keyword); font-weight: normal; font-size: 0.5em; }
        .title { font-size: 1.1em; color: var(--td-keyword); margin-bottom: 15px; }
        .contact-info { display: flex; flex-wrap: wrap; font-size: 0.9em; color: #9cdcfe; }
        .contact-info span { margin: 0 15px 5px 0; }
        
        .resume-section-title {
            font-size: 1.2em;
            color: var(--td-section);
            margin-bottom: var(--cvb-item-margin);
            margin-top: var(--cvb-section-margin);
            font-weight: bold;
        }
        .resume-section-title::before { content: "class "; color: var(--td-keyword); }
        .resume-section-title::after { content: " {"; color: #d4d4d4; }
        
        .resume-item { margin-bottom: var(--cvb-item-margin); padding-left: 20px; border-left: 1px dashed #444; }
        .resume-item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
        .resume-item-title { font-weight: bold; color: var(--td-fn); font-size: 1.05em; }
        .resume-item-date { font-size: 0.85em; color: #608b4e; }
        .resume-item-subtitle { font-size: 0.95em; color: #dcdcaa; margin-bottom: 8px; }
        .resume-item-desc { font-size: 0.9em; color: #d4d4d4; }
        
        .resume-skills-list { display: flex; flex-wrap: wrap; margin-top: 10px; padding-left: 20px; }
        .resume-skill-tag { background: #333; color: #9cdcfe; padding: 2px 8px; border-radius: 2px; font-size: 0.9em; border: 1px solid #444; margin: 0 10px 10px 0; }
        
        .resume-references-grid { padding-left: 20px; }
        .resume-reference-item { border: none; padding-left: 0; display: inline-block; width: 48%; vertical-align: top; margin: 0 1% 15px 0; box-sizing: border-box; }
        
        .resume-custom-item { padding-left: 20px; }
        
        .section-end { page-break-before: avoid; }
        .section-end::before { content: "}"; color: #d4d4d4; display: block; margin-top: 10px; font-weight: bold; font-size: 1.2em; }
        
        .action-bar { text-align: center; margin-bottom: 20px; padding: 20px; background: #fff; color: #000; font-family: Arial, sans-serif; }
        .btn { padding: 10px 20px; background: var(--td-keyword); color: white; text-decoration: none; border-radius: 0; margin: 0 5px; display: inline-block; cursor: pointer; border: none; }
        .btn-secondary { background: #333; }
        
        a.resume-link { color: #3794ff; }
    </style>
    @Html.Raw(Model.RenderColorVarsCss())
</head>
<body>


    <div class="resume-container">
        <div class="header" style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <h1 class="name">@(Model.Profile?.FullName ?? "Your Name")</h1>
                <div class="title">// @(Model.Profile?.ProfessionalTitle ?? "Professional Title")</div>
            </div>
            @{
                var imgSrc = Model.GetProfileImageDataUri(WebHostEnvironment.WebRootPath);
            }
            @if (!string.IsNullOrEmpty(imgSrc))
            {
                <div style="flex-shrink: 0; margin-left: 20px;">
                    <div style="width: 100px; height: 100px; background-image: url('@imgSrc'); background-size: cover; background-position: center; border-radius: 8px; border: 2px dashed #569cd6;"></div>
                </div>
            }
        </div>
        <div class="header" style="border-bottom: none; padding-bottom: 0; margin-bottom: 20px; margin-top: -15px;">
            
            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Email)) { <span>email: "@Model.Profile.Email",</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber)) { <span>phone: "@Model.Profile.PhoneNumber",</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Location)) { <span>location: "@Model.Profile.Location"</span> }
            </div>
            @if (Model.SocialLinks != null && Model.SocialLinks.Any())
            {
                <div class="contact-info" style="margin-top: 5px;">
                @foreach(var link in Model.SocialLinks)
                {
                    <span>@link.PlatformName.ToLower(): "@link.Url",</span>
                }
                </div>
            }
        </div>
        
        @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
        {
            <div class="resume-section-title" style="margin-top: 0;">Summary</div>
            <div class="resume-item-desc" style="margin-bottom: 10px; padding-left: 20px; border-left: 1px dashed #444;">
                /*<br/>
                @Html.Raw(Model.Profile.Summary.Replace("\n", "<br/>"))<br/>
                */
            </div>
            <div class="section-end"></div>
        }
        
        @foreach (var sec in sections.Where(s => s.IsVisible))
        {
            <div class="cvb-section-wrapper" data-section-id="@sec.Id">
                <div class="resume-section-title">@sec.Title.Replace(" ", "")</div>
                @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
                <div class="section-end"></div>
            </div>
        }
    </div>
@if (!Model.IsExport)
{
<script>
    window.addEventListener('message', function (e) {
        if (e.data && e.data.type === 'applyColors') {
            var root = document.documentElement;
            Object.entries(e.data.colors).forEach(function (entry) {
                root.style.setProperty(entry[0], entry[1]);
            });
        }
    });
</script>
}
</body>
</html>
