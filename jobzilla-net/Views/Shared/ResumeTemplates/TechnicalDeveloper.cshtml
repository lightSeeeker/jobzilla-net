@model jobzilla_net.Application.Resumes.ViewModels.ResumeExportViewModel
@{
    Layout = null;
    var sections = Model.GetUnifiedSections();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Profile?.FullName ?? "Resume") - Technical Developer</title>
    @await Html.PartialAsync("~/Views/Shared/ResumeComponents/_ResumeBaseStyles.cshtml", Model)
    <style>
        .resume-container {
            font-family: 'Consolas', 'Courier New', Courier, monospace;
            color: #d4d4d4;
            line-height: 1.5;
            background-color: #1e1e1e;
            padding: 40px;
            @if (!Model.IsExport) { <text>box-shadow: 0 4px 15px rgba(0,0,0,0.3); border-radius: 4px; max-width: 850px; margin: 40px auto; min-height: 1100px;</text> }
        }
        .header {
            margin-bottom: 30px;
            border-bottom: 1px solid #555;
            padding-bottom: 20px;
        }
        .name { font-size: 2em; font-weight: bold; margin: 0 0 5px; color: #ce9178; }
        .name::before { content: "const developer = \""; color: #569cd6; font-weight: normal; font-size: 0.5em; }
        .name::after { content: "\";"; color: #569cd6; font-weight: normal; font-size: 0.5em; }
        .title { font-size: 1.1em; color: #569cd6; margin-bottom: 15px; }
        .contact-info { display: flex; flex-wrap: wrap; gap: 15px; font-size: 0.9em; color: #9cdcfe; }
        
        .resume-section-title {
            font-size: 1.2em;
            color: #c586c0;
            margin-bottom: 15px;
            margin-top: 30px;
            font-weight: bold;
        }
        .resume-section-title::before { content: "class "; color: #569cd6; }
        .resume-section-title::after { content: " {"; color: #d4d4d4; }
        
        .resume-item { margin-bottom: 20px; padding-left: 20px; border-left: 1px dashed #444; }
        .resume-item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
        .resume-item-title { font-weight: bold; color: #4ec9b0; font-size: 1.05em; }
        .resume-item-date { font-size: 0.85em; color: #608b4e; }
        .resume-item-subtitle { font-size: 0.95em; color: #dcdcaa; margin-bottom: 8px; }
        .resume-item-desc { font-size: 0.9em; color: #d4d4d4; }
        
        .resume-skills-list { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; padding-left: 20px; }
        .resume-skill-tag { background: #333; color: #9cdcfe; padding: 2px 8px; border-radius: 2px; font-size: 0.9em; border: 1px solid #444; }
        
        .resume-references-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-left: 20px; }
        .resume-reference-item { border: none; padding-left: 0; }
        
        .resume-custom-item { padding-left: 20px; }
        
        .section-end::before { content: "}"; color: #d4d4d4; display: block; margin-top: 10px; font-weight: bold; font-size: 1.2em; }
        
        .action-bar { text-align: center; margin-bottom: 20px; padding: 20px; background: #fff; color: #000; font-family: Arial, sans-serif; }
        .btn { padding: 10px 20px; background: #007acc; color: white; text-decoration: none; border-radius: 0; margin: 0 5px; display: inline-block; cursor: pointer; border: none; }
        .btn-secondary { background: #333; }
        
        a.resume-link { color: #3794ff; }
    </style>
</head>
<body>
    @if (!Model.IsExport)
    {
        <div class="action-bar d-print-none">
            <a href="/CandidateDash/Templates" class="btn btn-secondary">Back to Templates</a>
            @if (Model.TemplateId.HasValue)
            {
                <a href="/CandidateDash/ExportTemplate?id=@Model.TemplateId&resumeId=@Model.ResumeId" class="btn">Download as PDF</a>
            }
        </div>
    }

    <div class="resume-container">
        <div class="header">
            <h1 class="name">@(Model.Profile?.FullName ?? "Your Name")</h1>
            <div class="title">// @(Model.Profile?.ProfessionalTitle ?? "Professional Title")</div>
            
            <div class="contact-info">
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Email)) { <span>email: "@Model.Profile.Email",</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber)) { <span>phone: "@Model.Profile.PhoneNumber",</span> }
                @if (!string.IsNullOrWhiteSpace(Model.Profile?.Location)) { <span>location: "@Model.Profile.Location"</span> }
            </div>
            @if (Model.SocialLinks != null && Model.SocialLinks.Any())
            {
                <div class="contact-info" style="margin-top: 5px;">
                @foreach(var link in Model.SocialLinks)
                {
                    <span>@link.PlatformName.ToLower(): "@link.Url",</span>
                }
                </div>
            }
        </div>
        
        @if (!string.IsNullOrWhiteSpace(Model.Profile?.Summary))
        {
            <div class="resume-section-title" style="margin-top: 0;">Summary</div>
            <div class="resume-item-desc" style="margin-bottom: 10px; padding-left: 20px; border-left: 1px dashed #444;">
                /*<br/>
                @Html.Raw(Model.Profile.Summary.Replace("\n", "<br/>"))<br/>
                */
            </div>
            <div class="section-end"></div>
        }
        
        @foreach (var sec in sections.Where(s => s.IsVisible))
        {
            <div class="resume-section-title">@sec.Title.Replace(" ", "")</div>
            @await Html.PartialAsync($"~/Views/Shared/ResumeComponents/_{sec.SectionType}.cshtml", sec)
            <div class="section-end"></div>
        }
    </div>
</body>
</html>
