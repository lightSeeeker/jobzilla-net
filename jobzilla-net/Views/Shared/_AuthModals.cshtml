@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}
@if (!isAuthenticated)
{
    <!--Signup popup -->
    <div class="modal fade twm-sign-up" id="sign_up_popup" aria-hidden="true" aria-labelledby="sign_up_popupLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h2 class="modal-title" id="sign_up_popupLabel">Sign Up</h2>
                    <p>Sign Up and get access to all the features of Fursanet</p>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="twm-tabs-style-2">
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#sign-candidate" type="button"><i class="fas fa-user-tie"></i>Candidate</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sign-Employer" type="button"><i class="fas fa-building"></i>Employer</button>
                            </li>
                        </ul>
                        <div class="tab-content" id="myTabContent">
                            <div class="tab-pane fade show active" id="sign-candidate">
                                <form id="registerCandidateForm" asp-controller="Account" asp-action="Register" method="post">
                                    <input type="hidden" name="UserType" value="Candidate" />
                                    <input type="hidden" name="ConfirmPassword" value="" />
                                    <div class="auth-error-message text-danger mb-3" style="display:none;"></div>
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="UserName" type="text" required="" class="form-control" placeholder="Username*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Password" type="password" class="form-control" required="" placeholder="Password*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Email" type="email" class="form-control" required="" placeholder="Email*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="PhoneNumber" type="text" class="form-control" placeholder="Phone">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <div class=" form-check">
                                                    <input type="checkbox" name="AgreeToTerms" value="true" class="form-check-input" id="agree1" required>
                                                    <label class="form-check-label" for="agree1">I agree to the <a asp-controller="Home" asp-action="Index">Terms and conditions</a></label>
                                                    <p>Already registered?
                                                        <button type="button" class="twm-backto-login" data-bs-target="#sign_up_popup2" data-bs-toggle="modal" data-bs-dismiss="modal">Log in here</button>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <button type="submit" class="site-button">Sign Up</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="sign-Employer">
                                <form id="registerEmployerForm" asp-controller="Account" asp-action="Register" method="post">
                                    <input type="hidden" name="UserType" value="Employer" />
                                    <input type="hidden" name="ConfirmPassword" value="" />
                                    <div class="auth-error-message text-danger mb-3" style="display:none;"></div>
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="UserName" type="text" required="" class="form-control" placeholder="Username*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Password" type="password" class="form-control" required="" placeholder="Password*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Email" type="email" class="form-control" required="" placeholder="Email*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="PhoneNumber" type="text" class="form-control" placeholder="Phone">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <div class=" form-check">
                                                    <input type="checkbox" name="AgreeToTerms" value="true" class="form-check-input" id="agree2" required>
                                                    <label class="form-check-label" for="agree2">I agree to the <a asp-controller="Home" asp-action="Index">Terms and conditions</a></label>
                                                    <p>Already registered?
                                                        <button type="button" class="twm-backto-login" data-bs-target="#sign_up_popup2" data-bs-toggle="modal" data-bs-dismiss="modal">Log in here</button>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <button type="submit" class="site-button">Sign Up</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <span class="modal-f-title">Login or Sign up with</span>
                    <ul class="twm-modal-social">
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Facebook" class="facebook-clr"><i class="fab fa-facebook-f"></i></a></li>
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Twitter" class="twitter-clr"><i class="fab fa-twitter"></i></a></li>
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="LinkedIn" class="linkedin-clr"><i class="fab fa-linkedin-in"></i></a></li>
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google" class="google-clr"><i class="fab fa-google"></i></a></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <!--Login popup -->
    <div class="modal fade twm-sign-up" id="sign_up_popup2" aria-hidden="true" aria-labelledby="sign_up_popupLabel2" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h2 class="modal-title" id="sign_up_popupLabel2">Login</h2>
                    <p>Login and get access to all the features of Fursanet</p>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="twm-tabs-style-2">
                        <ul class="nav nav-tabs" id="myTab2" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#login-candidate" type="button"><i class="fas fa-user-tie"></i>Candidate</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#login-Employer" type="button"><i class="fas fa-building"></i>Employer</button>
                            </li>
                        </ul>

                        <div class="tab-content" id="myTab2Content">
                            <div class="tab-pane fade show active" id="login-candidate">
                                <form id="loginCandidateForm" asp-controller="Account" asp-action="Login" method="post">
                                    <input type="hidden" name="UserType" value="Candidate" />
                                    <div class="auth-error-message text-danger mb-3" style="display:none;"></div>
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Email" type="email" required="" class="form-control" placeholder="Email*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Password" type="password" class="form-control" required="" placeholder="Password*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <div class=" form-check">
                                                    <input type="checkbox" name="RememberMe" value="true" class="form-check-input" id="Password3">
                                                    <label class="form-check-label rem-forgot" for="Password3">Remember me <a asp-controller="Account" asp-action="Login">Forgot Password</a></label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <button type="submit" class="site-button">Log in</button>
                                            <div class="mt-3 mb-3">Don't have an account ?
                                                <button type="button" class="twm-backto-login" data-bs-target="#sign_up_popup" data-bs-toggle="modal" data-bs-dismiss="modal">Sign Up</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="login-Employer">
                                <form id="loginEmployerForm" asp-controller="Account" asp-action="Login" method="post">
                                    <input type="hidden" name="UserType" value="Employer" />
                                    <div class="auth-error-message text-danger mb-3" style="display:none;"></div>
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Email" type="email" required="" class="form-control" placeholder="Email*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <input name="Password" type="password" class="form-control" required="" placeholder="Password*">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group mb-3">
                                                <div class=" form-check">
                                                    <input type="checkbox" name="RememberMe" value="true" class="form-check-input" id="Password4">
                                                    <label class="form-check-label rem-forgot" for="Password4">Remember me <a asp-controller="Account" asp-action="Login">Forgot Password</a></label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <button type="submit" class="site-button">Log in</button>
                                            <div class="mt-3 mb-3">Don't have an account ?
                                                <button type="button" class="twm-backto-login" data-bs-target="#sign_up_popup" data-bs-toggle="modal" data-bs-dismiss="modal">Sign Up</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <span class="modal-f-title">Login or Sign up with</span>
                    <ul class="twm-modal-social">
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Facebook" class="facebook-clr"><i class="fab fa-facebook-f"></i></a></li>
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Twitter" class="twitter-clr"><i class="fab fa-twitter"></i></a></li>
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="LinkedIn" class="linkedin-clr"><i class="fab fa-linkedin-in"></i></a></li>
                        <li><a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google" class="google-clr"><i class="fab fa-google"></i></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var authForms = ['registerCandidateForm', 'registerEmployerForm', 'loginCandidateForm', 'loginEmployerForm'];
            authForms.forEach(function (formId) {
                var form = document.getElementById(formId);
                if (!form) return;
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var errorDiv = form.querySelector('.auth-error-message');
                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (errorDiv) errorDiv.style.display = 'none';
                    if (submitBtn) submitBtn.disabled = true;
                    try {
                        var passwordInput = form.querySelector('input[name="Password"]');
                        var confirmInput = form.querySelector('input[name="ConfirmPassword"]');
                        if (passwordInput && confirmInput) { confirmInput.value = passwordInput.value; }
                        var formData = new FormData(form);
                        var response = await fetch(form.action, {
                            method: 'POST', body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        var result = await response.json();
                        if (response.ok && result.success) {
                            window.location.href = result.redirectUrl;
                        } else if (errorDiv) {
                            errorDiv.textContent = result.message || 'An error occurred.';
                            errorDiv.style.display = 'block';
                        }
                    } catch (err) {
                        if (errorDiv) { errorDiv.textContent = 'A network error occurred. Please try again.'; errorDiv.style.display = 'block'; }
                    } finally {
                        if (submitBtn) submitBtn.disabled = false;
                    }
                });
            });
        });
    </script>
}
