@model jobzilla_net.Models.Candidate.CandidateOverviewViewModel
@inject jobzilla_net.Application.Common.Interfaces.IApplicationDbContext DbContext
@using System.Security.Claims
@{
    var activePage = ViewData["ActivePage"]?.ToString() ?? "";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImage = "/images/user-avtar/pic4.jpg";
    var fullName = "Candidate";
    var professionalTitle = "IT Professional";
    if (userId != null)
    {
        var profile = DbContext.CandidateProfiles.FirstOrDefault(p => p.UserId == userId);
        if (profile != null)
        {
            if (!string.IsNullOrEmpty(profile.ProfileImagePath)) profileImage = profile.ProfileImagePath;
            if (!string.IsNullOrEmpty(profile.FullName)) fullName = profile.FullName;
            if (!string.IsNullOrEmpty(profile.ProfessionalTitle)) professionalTitle = profile.ProfessionalTitle;
        }
    }
}

<div class="col-xl-3 col-lg-4 col-md-12 rightSidebar m-b30">

    <div class="side-bar-st-1">
        
        <div class="twm-candidate-profile-pic">
            <img src="@profileImage" alt="@fullName">
            <div class="upload-btn-wrapper">
                <div id="upload-image-grid"></div>
                <button class="site-button button-sm">Upload Photo</button>
                <input type="file" name="myfile" id="file-uploader" accept=".jpg, .jpeg, .png">
            </div>
        </div>
        <div class="twm-mid-content text-center">
            <a href="javascript:;" class="twm-job-title">
                <h4>@fullName</h4>
            </a>
            <p>@professionalTitle</p>
        </div>
       
        <div class="twm-nav-list-1">
            <ul>
                <li class="@(activePage == "Dashboard" ? "active" : "")"><a asp-controller="Candidate" asp-action="Index"><i class="fa fa-tachometer-alt"></i> Dashboard</a></li>
                <li class="@(activePage == "Profile" ? "active" : "")"><a asp-controller="Candidate" asp-action="Profile"><i class="fa fa-user"></i> My Profile</a></li>
                <li class="@(activePage == "AppliedJobs" ? "active" : "")"><a asp-controller="Candidate" asp-action="AppliedJobs"><i class="fa fa-suitcase"></i> Applied Jobs</a></li>
                <li class="@(activePage == "Resumes" ? "active" : "")"><a asp-controller="Candidate" asp-action="Resumes"><i class="fa fa-receipt"></i> My Resume</a></li>
                <li><a asp-controller="Candidate" asp-action="Resumes"><i class="fa fa-cloud-upload-alt"></i> Upload Resume</a></li>
                <li class="@(activePage == "Builder" ? "active" : "")"><a asp-controller="Candidate" asp-action="Builder"><i class="fa fa-pencil-ruler"></i> Resume Builder</a></li>
                <li class="@(activePage == "Templates" ? "active" : "")"><a asp-controller="Candidate" asp-action="Templates"><i class="fa fa-file-alt"></i> Templates</a></li>
                <li><a asp-controller="Candidate" asp-action="Templates"><i class="fa fa-download"></i> Download Resume</a></li>
                <li class="@(activePage == "SavedJobs" ? "active" : "")"><a asp-controller="Candidate" asp-action="SavedJobs"><i class="fa fa-file-download"></i> Saved Jobs</a></li>
                <li><a asp-controller="Candidate" asp-action="Index"><i class="fa fa-bell"></i> Job Alerts</a></li>
                <li><a asp-controller="Candidate" asp-action="Profile"><i class="fa fa-fingerprint"></i> Change Password</a></li>
                <li class="@(activePage == "Chat" ? "active" : "")"><a asp-controller="Candidate" asp-action="Chat"><i class="fa fa-comments"></i> Chat</a></li>
                <li><a asp-controller="Blogs" asp-action="Manage"><i class="fa fa-newspaper"></i> My Blogs</a></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" id="candidateLogoutForm" style="display: none;"></form>
                    <a href="javascript:document.getElementById('candidateLogoutForm').submit()"><i class="fa fa-share-square"></i> Logout</a>
                </li>
            </ul>
        </div>
        
    </div>

</div>
