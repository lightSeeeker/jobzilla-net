@model int?

<div class="twm-right-section-panel site-bg-gray">
    <div class="wt-admin-dashboard-msg-2 twm-dashboard-style-2">
        
        <!-- Left Msg section (Conversations List) -->
        <div class="wt-dashboard-msg-user-list" id="chatListPanel">
            
            <div class="wt-dashboard-msg-search">
                <div class="input-group">
                    <input class="form-control" id="chatSearchInput" placeholder="Search Messages" type="text">
                    <button class="btn" type="button"><i class="fa fa-search"></i></button>
                </div>
            </div>
            
            <!-- user msg list start -->
            <div id="msg-list-wrap" class="wt-dashboard-msg-search-list scrollbar-macosx">
                <div class="text-center p-3" id="conversationsLoading">
                    <i class="fa fa-spinner fa-spin"></i> Loading...
                </div>
                <div id="conversationsContainer"></div>
            </div>
            <!-- user msg list End -->
        </div>
        
        <!-- Right Msg section (Messages Area) -->
        <div class="wt-dashboard-msg-box" id="activeChatBox" style="display: none; width: 100%;">
            <div class="single-msg-user-name-box">
                <div class="single-msg-short-discription d-flex justify-content-between align-items-center w-100">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary btn-sm" id="backToListBtn" title="Back to List">
                            <i class="fa fa-arrow-left"></i>
                        </button>
                        <div>
                            <h4 class="single-msg-user-name m-0" id="activeChatName">Loading...</h4>
                            <span id="activeChatJob" class="text-muted small"></span>
                        </div>
                    </div>
                    <button class="btn btn-danger btn-sm" id="deleteChatBtn" title="Delete Chat"><i class="fa fa-trash"></i></button>
                </div>
            </div>
            
            <div id="msg-chat-wrap" class="single-user-msg-conversation scrollbar-macosx">
                <div class="text-center p-3" id="messagesLoading" style="display: none;">
                    <i class="fa fa-spinner fa-spin"></i> Loading messages...
                </div>
                <div id="messagesContainer"></div>
            </div>
            
            <div class="single-msg-reply-comment" style="padding: 10px 20px; background: #fff; border-top: 1px solid #eee;">
                <div class="d-flex mb-2 align-items-center">
                    <label class="m-0" title="Attach File" style="cursor:pointer; display:inline-block; background-color:#e9ecef; padding: 6px 12px; border-radius: 4px; color: #495057; font-size: 13px; font-weight: 500;">
                        <i class="fa fa-paperclip"></i> Attach File
                        <input type="file" id="chatAttachmentInput" style="display:none;" accept="image/jpeg,image/png,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                    </label>
                    <div id="attachmentPreview" class="text-muted ms-3" style="font-size:12px; display:none;"></div>
                </div>
                <div style="position:relative;">
                    <textarea class="form-control" id="chatMessageInput" placeholder="Type a message here" rows="2" style="height: 60px; padding-right: 50px; resize: none;"></textarea>
                    <button class="btn" type="button" id="chatSendBtn" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; color:#1967d2; font-size:20px; outline:none;"><i class="fa fa-paper-plane"></i></button>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Force single-column drilldown layout */
    .wt-admin-dashboard-msg-2.twm-dashboard-style-2 {
        display: block !important; /* Override flex */
    }
    .wt-admin-dashboard-msg-2.twm-dashboard-style-2 .wt-dashboard-msg-user-list {
        width: 100% !important;
        max-width: 100% !important;
        margin-right: 0 !important;
        border-right: none !important;
    }
    .wt-admin-dashboard-msg-2.twm-dashboard-style-2 .wt-dashboard-msg-box {
        width: 100% !important;
    }
</style>

<input type="hidden" id="initialConversationId" value="@(Model)" />

<!-- SignalR Script -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    let activeConversationId = document.getElementById('initialConversationId').value;
    let initialLoad = true;
    let myUserId = ''; // Optional: fetched or inferred
    
    const conversationsContainer = document.getElementById('conversationsContainer');
    const messagesContainer = document.getElementById('messagesContainer');
    const activeChatBox = document.getElementById('activeChatBox');
    
    const chatSendBtn = document.getElementById('chatSendBtn');
    const chatMessageInput = document.getElementById('chatMessageInput');
    
    // Initialize SignalR Connection
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chathub")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", function (message) {
        // If message is for the currently active conversation, render it
        if (activeConversationId == message.conversationId) {
            appendMessage(message);
            scrollToBottom();
        }
        // Always refresh conversations list to update unread count / last message
        loadConversations();
    });

    connection.on("ReceiveMessageEdit", function (messageId, newBody, editedAtUtc) {
        const bodyEl = document.getElementById(`msg-body-${messageId}`);
        if (bodyEl) {
            bodyEl.innerHTML = newBody + ` <small class="text-muted" style="font-size:10px;">(Edited)</small>`;
        }
    });

    // File input preview
    document.getElementById('chatAttachmentInput').addEventListener('change', function() {
        const preview = document.getElementById('attachmentPreview');
        if (this.files && this.files.length > 0) {
            preview.textContent = "Selected: " + this.files[0].name;
            preview.style.display = 'block';
        } else {
            preview.style.display = 'none';
        }
    });

    // Delete Conversation
    document.getElementById('deleteChatBtn').addEventListener('click', async function() {
        if (!activeConversationId) return;
        if (!confirm('Are you sure you want to delete this chat for yourself?')) return;
        try {
            const response = await fetch(`/api/chat/conversations/${activeConversationId}`, { method: 'DELETE' });
            if (response.ok) {
                document.getElementById('activeChatBox').style.display = 'none';
                activeConversationId = null;
                loadConversations();
            } else {
                alert('Failed to delete chat.');
            }
        } catch(error) { console.error(error); }
    });

    // Back to list
    document.getElementById('backToListBtn').addEventListener('click', function() {
        document.getElementById('activeChatBox').style.display = 'none';
        document.getElementById('chatListPanel').style.display = 'block';
        activeConversationId = null;
    });

    // Global exposed functions for message actions
    window.editMessage = async function(messageId, oldBody) {
        const newBody = prompt('Edit your message:', oldBody);
        if (newBody !== null && newBody.trim() !== '' && newBody.trim() !== oldBody) {
            try {
                const response = await fetch(`/api/chat/messages/${messageId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ body: newBody.trim() })
                });
                if (response.ok) {
                    const msg = await response.json();
                    const bodyEl = document.getElementById(`msg-body-${messageId}`);
                    if (bodyEl) {
                        bodyEl.innerHTML = msg.body + ` <small class="text-muted" style="font-size:10px;">(Edited)</small>`;
                    }
                }
            } catch(error) { console.error(error); }
        }
    };

    window.deleteMessage = async function(messageId) {
        if (!confirm('Are you sure you want to delete this message?')) return;
        try {
            const response = await fetch(`/api/chat/messages/${messageId}`, { method: 'DELETE' });
            if (response.ok) {
                const bodyEl = document.getElementById(`msg-body-${messageId}`);
                if (bodyEl) {
                    bodyEl.innerHTML = "This message was deleted.";
                    const attachmentLink = bodyEl.parentNode.querySelector('.attachment-link');
                    if(attachmentLink) attachmentLink.remove();
                }
            }
        } catch(error) { console.error(error); }
    };

    connection.start().catch(function (err) {
        return console.error(err.toString());
    });

    // Load Conversations
    async function loadConversations() {
        try {
            const response = await fetch('/api/chat/conversations');
            if (response.ok) {
                const convs = await response.json();
                document.getElementById('conversationsLoading').style.display = 'none';
                conversationsContainer.innerHTML = '';
                
                convs.forEach(c => {
                    const pic = c.otherPartyImageUrl || '/images/user-avtar/pic1.jpg';
                    const time = c.lastMessageAtUtc ? new Date(c.lastMessageAtUtc).toLocaleDateString() : '';
                    
                    const div = document.createElement('div');
                    div.className = `wt-dashboard-msg-search-list-wrap ${activeConversationId == c.conversationId ? 'active-chat' : ''}`;
                    div.dataset.id = c.conversationId;
                    div.innerHTML = `
                        <a href="javascript:;" class="msg-user-info clearfix">
                            <div class="msg-user-timing">${time} ${c.unreadCount > 0 ? `<span class="badge bg-danger rounded-circle">${c.unreadCount}</span>` : ''}</div>
                            <div class="msg-user-info-pic"><img src="${pic}" alt=""></div>
                            <div class="msg-user-info-text">
                                <div class="msg-user-name">${c.otherPartyName}</div>
                                <div class="msg-user-discription">${c.jobTitle}</div>
                                <div class="msg-user-discription text-muted" style="font-size:11px">${c.lastMessage || 'No messages yet'}</div>
                            </div>
                        </a>
                    `;
                    div.addEventListener('click', () => {
                        openConversation(c);
                    });
                    conversationsContainer.appendChild(div);
                });

                if (initialLoad && activeConversationId) {
                    const targetConv = convs.find(c => c.conversationId == activeConversationId);
                    if (targetConv) {
                        openConversation(targetConv, false);
                    }
                }
                initialLoad = false;
            }
        } catch (error) {
            console.error('Failed to load conversations', error);
        }
    }

    async function openConversation(conv, skipHistoryLoad = false) {
        activeConversationId = conv.conversationId;
        
        // Update UI
        document.getElementById('chatListPanel').style.display = 'none';
        activeChatBox.style.display = 'block';
        document.getElementById('activeChatName').textContent = conv.otherPartyName;
        document.getElementById('activeChatJob').textContent = conv.subject;
        
        // Update active class directly without full reload
        updateActiveChatClass();
        
        if (!skipHistoryLoad) {
            messagesContainer.innerHTML = '';
            document.getElementById('messagesLoading').style.display = 'block';
            
            try {
                const response = await fetch(`/api/chat/conversations/${activeConversationId}/messages`);
                if (response.ok) {
                    const msgs = await response.json();
                    document.getElementById('messagesLoading').style.display = 'none';
                    msgs.forEach(m => appendMessage(m));
                    scrollToBottom();
                    
                    // Trigger a load to clear unread badges, but it won't re-trigger openConversation since initialLoad is false
                    loadConversations();
                }
            } catch (error) {
                console.error(error);
            }
        }
    }

    function updateActiveChatClass() {
        const wraps = document.querySelectorAll('.wt-dashboard-msg-search-list-wrap');
        wraps.forEach(w => w.classList.remove('active-chat'));
        const activeWrap = document.querySelector(`.wt-dashboard-msg-search-list-wrap[data-id="${activeConversationId}"]`);
        if (activeWrap) activeWrap.classList.add('active-chat');
    }

    function appendMessage(m) {
        const wrap = document.createElement('div');
        
        // Handle System Messages
        if (m.body && m.body.startsWith('[System]:')) {
            const sysText = m.body.replace('[System]:', '').trim();
            wrap.className = 'text-center my-3';
            wrap.innerHTML = `<span class="badge bg-secondary" style="font-weight: normal; font-size: 12px; padding: 5px 10px;">${sysText}</span>`;
            messagesContainer.appendChild(wrap);
            return;
        }

        const pic = m.senderImageUrl || '/images/user-avtar/pic1.jpg';
        const time = new Date(m.sentAtUtc).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
        wrap.className = `single-user-comment-wrap ${m.isMine ? 'sigle-user-reply' : ''}`;
        
        const rowClass = m.isMine ? 'justify-content-end' : '';
        
        let contentHtml = `<span id="msg-body-${m.messageId}">${m.body.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</span>`;
        if (m.isDeleted) {
            contentHtml = `<span id="msg-body-${m.messageId}">This message was deleted.</span>`;
        } else {
            if (m.editedAtUtc) {
                contentHtml += ` <small class="text-muted" style="font-size:10px;">(Edited)</small>`;
            }
            if (m.attachmentUrl) {
                contentHtml += `<br><a href="${m.attachmentUrl}" target="_blank" class="attachment-link text-primary"><i class="fa fa-paperclip"></i> ${m.attachmentName}</a>`;
            }
        }
        
        let actionMenu = '';
        if (m.isMine && !m.isDeleted) {
            actionMenu = `
                <div class="dropdown d-inline-block ml-2" style="position:absolute; right:10px; top:10px;">
                    <a href="javascript:;" data-bs-toggle="dropdown" class="text-muted"><i class="fa fa-ellipsis-v"></i></a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="javascript:;" onclick="editMessage(${m.messageId}, '${m.body.replace(/'/g, "\\'").replace(/"/g, "&quot;")}')">Edit</a></li>
                        <li><a class="dropdown-item text-danger" href="javascript:;" onclick="deleteMessage(${m.messageId})">Delete</a></li>
                    </ul>
                </div>
            `;
        }

        wrap.innerHTML = `
            <div class="row ${rowClass}">
                <div class="col-xl-9 col-lg-12">
                    <div class="single-user-comment-block clearfix" style="position:relative;">
                        <div class="single-user-com-pic"><img src="${pic}" alt=""></div>
                        <div class="single-user-com-text pr-4" style="min-height: 40px;">${contentHtml}</div>
                        <div class="single-user-msg-time">${time}</div>
                        ${actionMenu}
                    </div>
                </div>
            </div>
        `;
        messagesContainer.appendChild(wrap);
    }

    function scrollToBottom() {
        const wrap = document.getElementById('msg-chat-wrap');
        wrap.scrollTop = wrap.scrollHeight;
    }

    chatSendBtn.addEventListener('click', async function() {
        const body = chatMessageInput.value.trim();
        const fileInput = document.getElementById('chatAttachmentInput');
        
        if ((!body && (!fileInput.files || fileInput.files.length === 0)) || !activeConversationId) return;
        
        const formData = new FormData();
        if (body) formData.append('body', body);
        if (fileInput.files && fileInput.files.length > 0) {
            formData.append('attachment', fileInput.files[0]);
        }
        
        // Disable inputs while sending
        chatSendBtn.disabled = true;
        chatMessageInput.disabled = true;
        
        try {
            const response = await fetch(`/api/chat/conversations/${activeConversationId}/messages`, {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                const msg = await response.json();
                
                chatMessageInput.value = '';
                fileInput.value = '';
                document.getElementById('attachmentPreview').style.display = 'none';
                
                appendMessage(msg);
                scrollToBottom();
                loadConversations(); // update last message
            } else {
                const errorText = await response.text();
                alert('Failed to send message: ' + errorText);
            }
        } catch(error) {
            console.error('Send error', error);
        } finally {
            chatSendBtn.disabled = false;
            chatMessageInput.disabled = false;
        }
    });

    chatMessageInput.addEventListener('keypress', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            chatSendBtn.click();
        }
    });

    // Init
    loadConversations();
});
</script>
<style>
.active-chat { background-color: #f1f1f1; border-left: 4px solid #1967d2; }
</style>
