@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    bool isMinimalFooter = controllerName == "Candidate" || controllerName == "Employer" || controllerName == "Account";
}
        <footer class="footer-dark jz-footer" style="@(isMinimalFooter ? "padding-top: 0;" : "")">
            <div class="jz-wave-divider" aria-hidden="true">
                <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                    <path d="M0,30 C360,60 1080,0 1440,30 L1440,0 L0,0 Z" fill="#F0F4FF"/>
                </svg>
            </div>
            <div class="container">

                @if (!isMinimalFooter)
                {
                    <!-- NEWS LETTER SECTION START -->
                    <div class="ftr-nw-content">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="ftr-nw-title">
                                    Join our email subscription now to get updates 
                                    on new jobs and notifications.
                                </div>
                            </div>
                            <div class="col-md-7">
                                <form>
                                    <div class="ftr-nw-form">
                                        <input name="news-letter" class="form-control" placeholder="Enter Your Email" type="text">
                                        <button class="ftr-nw-subcribe-btn">Subscribe Now</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <!-- NEWS LETTER SECTION END -->
                    
                    <!-- FOOTER BLOCKES START -->  
                    <div class="footer-top">
                        <div class="row">

                            <div class="col-lg-3 col-md-12">
                                
                                <div class="widget widget_about">
                                    <div class="logo-footer clearfix">
                                        <a href="@Url.Action("Index", "Home")"><img src="~/images/logo-dark.png" alt=""></a>
                                    </div>
                                    <p>Many desktop publishing packages and web page editors now.</p>
                                    <ul class="ftr-list">
                                        <li><p><span>Address :</span>65 Sunset CA 90026, USA </p></li>
                                        <li><p><span>Email :</span>example@@max.com</p></li>
                                        <li><p><span>Call :</span>555-555-1234</p></li>
                                    </ul>
                                </div>                            
                                
                            </div> 

                            <div class="col-lg-9 col-md-12">
                                <div class="row">
                                   
                                    <div class="col-lg-3 col-md-6 col-sm-6">
                                        <div class="widget widget_services ftr-list-center">
                                            <h3 class="widget-title">For Candidate</h3>
                                            <ul>
                                                <li><a asp-controller="Candidate" asp-action="Index">User Dashboard</a></li>
                                                <li><a asp-controller="Candidate" asp-action="Index">Alert resume</a></li>
                                                <li><a asp-controller="Candidates" asp-action="Index">Candidates</a></li>
                                                <li><a asp-controller="Blogs" asp-action="Index">Blog List</a></li>
                                                <li><a asp-controller="Blogs" asp-action="Details">Blog single</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                
                                    <div class="col-lg-3 col-md-6 col-sm-6">
                                        <div class="widget widget_services ftr-list-center">
                                            <h3 class="widget-title">For Employers</h3>
                                            <ul>
                                                <li><a asp-controller="Employer" asp-action="PostedJobs">Post Jobs</a></li>
                                                <li><a asp-controller="Blogs" asp-action="Index">Blog Grid</a></li>
                                                <li><a asp-controller="Home" asp-action="Index">Contact</a></li>
                                                <li><a asp-controller="Jobs" asp-action="Index">Jobs Listing</a></li>
                                                <li><a asp-controller="Jobs" asp-action="Details">Jobs details</a></li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6">
                                        <div class="widget widget_services ftr-list-center">
                                            <h3 class="widget-title">Helpful Resources</h3>
                                            <ul>
                                                <li><a asp-controller="Home" asp-action="Index">FAQs</a></li>
                                                <li><a asp-controller="Employers" asp-action="Details">Employer detail</a></li>
                                                <li><a asp-controller="Candidate" asp-action="Profile">Profile</a></li>
                                                <li><a asp-controller="Home" asp-action="Index">404 Page</a></li>
                                                <li><a asp-controller="Home" asp-action="Index">Pricing</a></li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-6">  
                                        <div class="widget widget_services ftr-list-center">
                                            <h3 class="widget-title">Quick Links</h3>
                                            <ul>
                                                <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                                                <li><a asp-controller="Home" asp-action="Index">About us</a></li>
                                                <li><a asp-controller="Candidate" asp-action="SavedJobs">Bookmark</a></li>
                                                <li><a asp-controller="Jobs" asp-action="Index">Jobs</a></li>
                                                <li><a asp-controller="Employers" asp-action="Index">Employer</a></li>
                                            </ul>
                                        </div>
                                    </div>

                                </div>  

                            </div> 

                        </div>
                    </div>
                }

                <!-- FOOTER COPYRIGHT -->
                <div class="footer-bottom">
                
                    <div class="footer-bottom-info" style="@(isMinimalFooter ? "padding: 10px 0;" : "")">
                    
                        <div class="footer-copy-right">
                            <span class="copyrights-text">Copyright &copy; 2023 by thewebmax All Rights Reserved.</span>
                        </div>
                        <ul class="social-icons">
                            <li><a href="javascript:void(0);" class="fab fa-facebook-f"></a></li>
                            <li><a href="javascript:void(0);" class="fab fa-twitter"></a></li>
                            <li><a href="javascript:void(0);" class="fab fa-instagram"></a></li>
                            <li><a href="javascript:void(0);" class="fab fa-youtube"></a></li>
                        </ul>
                        
                    </div>
                    
                </div>

            </div>
    
        </footer>
        <!-- FOOTER END -->

