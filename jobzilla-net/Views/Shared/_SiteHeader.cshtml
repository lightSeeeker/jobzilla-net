@using Microsoft.AspNetCore.Identity
@using jobzilla_net.Infrasture.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isEmployer = isAuthenticated && User.IsInRole("Employer");
    var isCandidate = isAuthenticated && User.IsInRole("Candidate");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthPage = (controller == "Account" && (action == "Login" || action == "Register")) ||
                     (controller == "Admin" && (action == "Login" || action == "LoginWith2FA"));
}
@if (!isCandidate && !isAuthPage)
{
    <!-- HEADER START -->
    <header class="site-header header-style-3 mobile-sider-drawer-menu">

        <div class="sticky-header main-bar-wraper  navbar-expand-lg">
            <div class="main-bar">

                <div class="container-fluid clearfix">

                    <div class="logo-header">
                        <div class="logo-header-inner logo-header-one">
                            <a href="@Url.Action("Index", "Home")">
                                <img src="~/images/logo-dark.png" alt="">
                            </a>
                        </div>
                    </div>

                    <!-- NAV Toggle Button -->
                    <button id="mobile-side-drawer" data-target=".header-nav" data-toggle="collapse" type="button" class="navbar-toggler collapsed">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar icon-bar-first"></span>
                        <span class="icon-bar icon-bar-two"></span>
                        <span class="icon-bar icon-bar-three"></span>
                    </button>

                    <!-- MAIN Vav -->
                    <div class="nav-animation header-nav navbar-collapse collapse d-flex justify-content-center">

                        <ul class=" nav navbar-nav">
                            <li class="has-mega-menu">
                                <a href="@Url.Action("Index", "Home")">Home</a>                                                            
                            </li>
                            <li class="has-child">
                                <a asp-controller="Jobs" asp-action="Index">Jobs</a>                                                           
                            </li>
                            @if (isEmployer)
                            {
                                <li class="has-child">
                                    <a href="javascript:;">Employer Panel</a>
                                    <ul class="sub-menu">
                                        <li><a asp-controller="Employer" asp-action="Index">Dashboard</a></li>
                                        <li><a asp-controller="Employer" asp-action="Profile">Profile</a></li>
                                        <li><a asp-controller="Employer" asp-action="Applications">Applications</a></li>
                                        <li><a asp-controller="Employer" asp-action="PostedJobs">Manage Jobs</a></li>
                                        <li><a asp-controller="Employer" asp-action="PostJob">Post A Job</a></li>
                                        <li><a asp-controller="Candidates" asp-action="Index">Browse Candidates</a></li>
                                        <li><a asp-controller="Chat" asp-action="Index">Chat</a></li>
                                    </ul>
                                </li>
                            }
                            <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                            <li><a asp-controller="Home" asp-action="Faq">FAQ's</a></li>
                            <li><a asp-controller="Home" asp-action="ComingSoon">Coming soon</a></li>
                            @if (isCandidate)
                            {
                                <li class="has-child">
                                    <a href="javascript:;">Candidate Panel</a>
                                    <ul class="sub-menu">
                                        <li><a asp-controller="Candidate" asp-action="Index">Dashboard</a></li>
                                        <li><a asp-controller="Candidate" asp-action="Profile">My Profile</a></li>
                                        <li><a asp-controller="Candidate" asp-action="AppliedJobs">Applied Jobs</a></li>
                                        <li><a asp-controller="Candidate" asp-action="Resumes">My Resume</a></li>
                                        <li><a asp-controller="Candidate" asp-action="SavedJobs">Saved Jobs</a></li>
                                        <li><a asp-controller="Chat" asp-action="Index">Chat</a></li>
                                    </ul>
                                </li>
                            }
                            <li class="has-child">
                                <a asp-controller="Blogs" asp-action="Index">Blog</a>                          
                            </li>
                        </ul>

                    </div>

                    <!-- Header Right Section-->
                    <div class="extra-nav header-2-nav">
                        <div class="extra-cell">
                            <div class="header-search">
                                <a href="#search" class="header-search-icon"><i class="feather-search"></i></a>
                            </div>
                        </div>
                        <div class="extra-cell">
                            <div class="header-nav-btn-section">
                                @if (!isAuthenticated)
                                {
                                    <div class="twm-nav-btn-left">
                                        <a class="twm-nav-sign-up" data-bs-toggle="modal" href="#sign_up_popup" role="button">
                                            <i class="feather-log-in"></i> Sign Up
                                        </a>
                                    </div>
                                }
                                else if (isEmployer)
                                {
                                    <div class="twm-nav-btn-right">
                                        <a asp-controller="Employer" asp-action="PostedJobs" class="twm-nav-post-a-job">
                                            <i class="feather-briefcase"></i> Post a job
                                        </a>
                                    </div>
                                }
                                @if (isAuthenticated)
                                {
                                    <div class="twm-nav-btn-left" style="margin-left: 15px;">
                                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                                            <button type="submit" class="btn twm-nav-sign-up btn-link border-0" style="padding: 10px 20px; font-weight: 500;">
                                                <i class="feather-log-out"></i> Logout
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                    
                                                    
                </div>

                
            </div>

            <!-- SITE Search -->
            <div id="search">
                <span class="close"></span>
                <form role="search" id="searchform" asp-controller="Jobs" asp-action="Index" method="get" class="radius-xl">
                    <input class="form-control" value="" name="q" type="search" placeholder="Type to search" />
                    <span class="input-group-append">
                        <button type="button" class="search-btn">
                            <i class="fa fa-paper-plane"></i>
                        </button>
                    </span>
                </form>
            </div>
        </div>



            
             


            
    </header>
    <!-- HEADER END -->
}

