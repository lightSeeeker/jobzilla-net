@model IReadOnlyList<Jobzilla.Domain.Entities.JobPost>
@{
    ViewData["Title"] = "Employer Jobs";
}

<div class="section-full p-t120 p-b90 site-bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="wt-title mb-0">Manage Jobs</h2>
            <a class="site-button" asp-action="Create">Post Job</a>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>Title</th><th>Status</th><th>Type</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td>@job.Title</td>
                            <td>@job.Status</td>
                            <td>@job.EmploymentType</td>
                            <td>@job.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
